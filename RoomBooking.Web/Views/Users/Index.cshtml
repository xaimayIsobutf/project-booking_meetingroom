@model IEnumerable<RoomBooking.Domain.Entities.User>
@{ ViewData["Title"] = "Members"; }
<style>
.member-directory{background:#f4f7fb}.member-directory .directory-heading{margin-top:18px}.member-list-panel{border:1px solid #d8e0ed;border-radius:18px;padding:0;overflow:hidden}.member-toolbar{display:flex;gap:14px;padding:28px 32px;background:#fff}.member-toolbar input,.member-toolbar select{border:1px solid #d6deeb;border-radius:13px;padding:14px 18px;font:inherit;background:#fff}.member-toolbar input{flex:1;min-width:0}.member-count{padding:16px 32px;border-top:1px solid #edf0f5;border-bottom:1px solid #d8e0ed;color:#849397}.member-count span{float:right}.member-table{overflow-x:auto}.member-head,.member-row{display:grid;grid-template-columns:1.5fr 1.3fr 1.2fr 1fr 1fr 1fr;gap:16px;align-items:center;min-width:950px}.member-head{background:#f2f5fb;color:#6e7d7d;padding:18px 26px;font-size:.78rem;font-weight:800;text-transform:uppercase}.member-row{padding:15px 26px;min-height:68px;background:#fff;border-top:1px solid #edf0f5;font-size:.85rem}.member-row b{font-size:.9rem}.member-row small{display:block;margin-top:3px;color:#849397}.member-avatar{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#6284c4;color:#fff;font-weight:800}.member-name{display:flex;align-items:center;gap:12px}.member-actions{display:flex;gap:6px;white-space:nowrap}.member-actions .outline-button{padding:7px 10px;font-size:.78rem}.member-row .status{color:#25805c;background:#fff;border:1px solid #a9d8c5}.member-row .status.busy{color:#b63f49;border-color:#efb7b7}.member-row .tag{font-size:.75rem}
</style>
<div class="member-directory"><div class="directory-heading"><div><span class="eyebrow">MEMBER DIRECTORY</span><h1>Member directory</h1><p>ข้อมูลสมาชิกและสิทธิ์การใช้งานของบริษัท</p></div><a class="button" asp-action="Create">+ เพิ่มสมาชิก</a></div><section class="member-list-panel"><div class="member-toolbar"><input id="memberSearch" type="search" placeholder="⌕  ค้นหาชื่อ อีเมล หรือ Role..." /><select id="memberFilter"><option value="all">ทุกสถานะ</option><option value="active">Active</option><option value="inactive">Inactive</option></select></div><div class="member-count">พบ @Model.Count() สมาชิก <span>ข้อมูลสมาชิกในระบบ</span></div><div class="member-table"><div class="member-head"><span>สมาชิก</span><span>อีเมล</span><span>บริษัท</span><span>Role</span><span>สถานะ</span><span>การจัดการ</span></div>@foreach(var user in Model){<div class="member-row member-item" data-search="@user.FullName @user.Email @user.Role @user.Company?.Name" data-status="@(user.IsActive?"active":"inactive")"><div class="member-name"><span class="member-avatar">@user.FullName.FirstOrDefault()</span><div><b>@user.FullName</b><small>@user.FullName</small></div></div><span>@user.Email</span><span>@user.Company?.Name</span><span><span class="tag">@user.Role</span></span><span><span class="status @(user.IsActive?"available":"busy")">@(user.IsActive?"Active":"Inactive")</span></span><div class="member-actions"><a class="outline-button" asp-action="Edit" asp-route-id="@user.Id">แก้ไข</a>@if(user.IsActive){<form asp-action="Delete" method="post"><input type="hidden" name="id" value="@user.Id"/><button class="link-danger" type="submit">ปิดใช้งาน</button></form>}</div></div>}</div></section></div>
<script>const ms=document.getElementById('memberSearch'),mf=document.getElementById('memberFilter');function filterMembers(){const q=ms.value.toLowerCase(),v=mf.value;document.querySelectorAll('.member-item').forEach(x=>x.style.display=(!q||x.dataset.search.toLowerCase().includes(q))&&(v==='all'||x.dataset.status===v)?'grid':'none')}ms.addEventListener('input',filterMembers);mf.addEventListener('change',filterMembers);</script>
