@model RoomBooking.Domain.Entities.User
@{ViewData["Title"]="เพิ่มผู้ใช้งาน";}<div class="page-heading"><div><span class="eyebrow">TEAM & ACCESS</span><h1>เพิ่มผู้ใช้งาน</h1></div></div><form asp-action="Create" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label>ชื่อ-นามสกุล<input asp-for="FullName" required/></label><label>อีเมล<input asp-for="Email" type="email" required/></label><label>รหัสผ่าน<input name="password" type="password" minlength="4" required autocomplete="new-password"/></label><label>Role<select asp-for="Role"><option>Employee</option><option>Approver</option><option>TenantAdmin</option><option>SuperAdmin</option></select></label><div class="actions"><a asp-action="Index" class="outline-button">ยกเลิก</a><button class="button" type="submit">บันทึก</button></div></form>
