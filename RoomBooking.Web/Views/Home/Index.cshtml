@model RoomBooking.Web.Models.DashboardViewModel
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dashboard-modern.css" asp-append-version="true" />
@{ ViewData["Title"]="Dashboard"; }
<div class="dashboard-page">
<div class="page-heading compact-heading">
    <div>
        <span class="eyebrow">ROOMBOOKING · MAKUB CENTER</span>
        <h1 data-i18n="dashboard.title">ภาพรวมการจองห้องประชุมของบริษัท</h1>
    </div>
    <a class="button" data-i18n="common.book" asp-controller="Reservations" asp-action="Create">+ จองห้องประชุม</a>
</div>
<section class="metrics">
    <div>
        <span data-i18n="dashboard.total">ห้องประชุมทั้งหมด</span>
    <strong>@Model.RoomCount</strong>
    <small>ห้อง</small>
    </div>
    <div>
        <span data-i18n="dashboard.today">การจองวันนี้</span>
        <strong>@Model.TodayReservations</strong>
        <small>รายการ</small>
    </div>
    <div class="featured">
        <span data-i18n="dashboard.available">ห้องที่ว่างตอนนี้</span>
        <strong>@Model.AvailableRooms</strong>
        <small>พร้อมใช้งาน</small>
    </div>
</section>
<section class="content-grid">
    <article class="panel">
        <div class="panel-heading">
            <h2 data-i18n="dashboard.today">การจองวันนี้</h2>
            <a asp-controller="Reservations" asp-action="Create">เพิ่มการจอง</a>
            </div><div class="dashboard-filters">
                <input id="bookingSearch" type="search" placeholder="ค้นหาการจองหรือห้องประชุม..." />
                <select id="bookingFilter">
                    <option value="all">ทั้งหมด</option>
                    <option value="กำลังใช้งาน">กำลังใช้งาน</option>
                    <option value="จองแล้ว">จองแล้ว</option>
                </select>
            </div>
            <div id="bookingList">
                @if (!Model.Reservations.Any())
                {
                    <div class="empty-state"><strong>ยังไม่มีการจองวันนี้</strong><span>เมื่อมีการจอง รายการจะแสดงที่นี่</span></div>
                }
                @foreach(var item in Model.Reservations) {
                    <div class="reservation booking-item" data-search="@item.Subject @item.RoomName" data-status="@item.Status">
                        <span class="calendar-icon">▣</span>
                        <div>
                            <b>@item.Subject</b>
                            <small>@item.RoomName · @item.Time</small>
                        </div>
                        <span class="tag @(item.Status == "กำลังใช้งาน" || item.Status == "ยกเลิก" ? "tag-busy" : "tag-booked")">@item.Status</span>
                    </div>
                }
            </div>
        </article>
        <article class="panel">
            <div class="panel-heading">
            <h2 data-i18n="nav.rooms">ห้องประชุม</h2>
                <a asp-controller="Rooms" asp-action="Index">จัดการ</a>
            </div>
            @if (!Model.Rooms.Any())
            {
                <div class="empty-state"><strong>ยังไม่มีห้องประชุม</strong><span>เพิ่มห้องเพื่อเริ่มต้นใช้งาน</span></div>
            }
            @foreach(var room in Model.Rooms) {
                <div class="room-line">
                    <span class="room-icon">▦</span>
                    <div>
                        <b>@room.Name</b>
                        <small>@room.Location · @room.Capacity คน</small>
                    </div>
                    <span class="room-state">@(room.Available ? "ว่าง" : "กำลังใช้งาน")</span>
                    <span class="dot @(room.Available?"green":"red")"></span>
                </div>
            }
        </article>
    </section>

    <script>
        const s = document.getElementById('bookingSearch'),
              f = document.getElementById('bookingFilter');

        function filterBookings() {
            const q = s.value.toLowerCase(),
                  v = f.value;

            document.querySelectorAll('.booking-item').forEach(x => {
                x.style.display = (!q || x.dataset.search.toLowerCase().includes(q)) && (v === 'all' || x.dataset.status === v) ? 'flex' : 'none';
            });
        }

        s.addEventListener('input', filterBookings);
        f.addEventListener('change', filterBookings);
    </script>
</div>
