@model RoomBooking.Web.Models.RoomViewModel
@{
    ViewData["Title"] = "แก้ไขห้องประชุม";
}
<div class="page-heading">
    <div><span class="eyebrow">ROOM MANAGEMENT</span>
        <h1>แก้ไขห้องประชุม</h1>
    </div>
</div>
<form asp-action="Edit" method="post" class="form-card"><input asp-for="Id" type="hidden" /><label>ห้องประชุม<input
    asp-for="Name" required /></label>
    <div class="form-row"><label>ขนาดห้องประชุม<select asp-for="RoomSize">
        <option>เล็ก</option>
        <option>กลาง</option>
        <option>ใหญ่</option>
    </select></label><label>ตึก<input asp-for="Building" required /></label><label>ชั้น<input asp-for="Floor"
                                                                                              required /></label></div>
    <div class="form-row"><label>รองรับ (คน)<input asp-for="Capacity" type="number" min="1"
                                                       required /></label><label>อุปกรณ์<input asp-for="Equipment" /></label></div><label><input type="hidden"
                                                                                                  name="Available" value="false" /><input type="checkbox" name="Available" value="true"
                                                checked="@Model.Available" /> เปิดใช้งานห้องนี้</label>
        <div class="actions"><a asp-action="Index" class="outline-button">ยกเลิก</a><button class="button"
                                                                                                type="submit">บันทึกการแก้ไข</button></div>
        </form>