@model RoomBooking.Web.Models.RoomViewModel
@{ ViewData["Title"] = "เพิ่มห้องประชุม"; }
<div class="page-heading"><div><span class="eyebrow">ROOM MANAGEMENT</span><h1>เพิ่มห้องประชุม</h1><p>สร้างห้องใหม่สำหรับบริษัท</p></div></div>
<form asp-action="Create" method="post" class="form-card"><label>ห้องประชุม<input asp-for="Name" required /></label><div class="form-row"><label>ขนาดห้องประชุม<select asp-for="RoomSize"><option>เล็ก</option><option>กลาง</option><option>ใหญ่</option></select></label><label>ตึก<input asp-for="Building" required /></label><label>ชั้น<input asp-for="Floor" required /></label></div><div class="form-row"><label>รองรับ (คน)<input asp-for="Capacity" type="number" min="1" required /></label><label>อุปกรณ์<input asp-for="Equipment" placeholder="เช่น Projector, Whiteboard" /></label></div><label><input type="hidden" name="Available" value="false" /><input type="checkbox" name="Available" value="true" checked /> เปิดใช้งาน</label><div class="actions"><a asp-action="Index" class="outline-button">ยกเลิก</a><button class="button" type="submit">บันทึก</button></div></form>
