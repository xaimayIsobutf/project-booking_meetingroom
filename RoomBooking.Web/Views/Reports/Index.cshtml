@{var rows=(IEnumerable<RoomBooking.Domain.Entities.Reservation>)ViewBag.Rows;var usage=ViewBag.RoomUsage;ViewData["Title"]="Reports";}<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" /><div class="page-heading"><div><span class="eyebrow">ANALYTICS & REPORTS</span><h1>รายงานการใช้ห้องประชุม</h1><p>สรุปข้อมูลการจองห้องประชุมของบริษัท</p></div><div class="report-actions"><a class="outline-button" asp-action="ExportCsv">Export Excel</a><button class="button" onclick="window.print()">Export PDF</button></div></div><section class="report-cards"><div class="panel"><small>การจองทั้งหมด</small><strong>@rows.Count()</strong><span>รายการ</span></div><div class="panel"><small>ชั่วโมงการใช้งาน</small><strong>@rows.Sum(x=>(x.EndAt-x.StartAt).TotalHours).ToString("0.0")</strong><span>ชั่วโมง</span></div><div class="panel"><small>ห้องที่ถูกจองบ่อยที่สุด</small><strong>@(usage.Count>0?usage[0].Key:"-")</strong><span>@(usage.Count>0?usage[0].Count:0) รายการ</span></div></section><section class="report-grid"><article class="panel"><h2>ห้องที่ถูกจองบ่อย</h2>@foreach(var r in usage){<div class="report-row"><b>@r.Key</b><span>@r.Count รายการ</span></div>}</article><article class="panel"><h2>การใช้ห้องประชุม</h2>@foreach(var x in rows.OrderByDescending(x=>x.StartAt).Take(10)){<div class="report-row"><b>@x.Subject</b><span>@x.MeetingRoom?.Name · @x.StartAt.ToString("dd/MM/yyyy HH:mm")</span></div>}</article></section>
