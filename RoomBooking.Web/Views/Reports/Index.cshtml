@{ var rows=(IEnumerable<RoomBooking.Domain.Entities.Reservation>)ViewBag.Rows; var usage=ViewBag.RoomUsage; var statuses=ViewBag.Statuses; var monthly=ViewBag.Monthly; ViewData["Title"]="Reports"; }
<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
<div class="page-heading"><div><span class="eyebrow">ANALYTICS & REPORTS</span><h1>รายงานการใช้ห้องประชุม</h1><p>สรุปข้อมูลการจองห้องประชุมของบริษัท</p></div><div class="report-actions"><a class="outline-button" asp-action="ExportCsv" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-status="@ViewBag.Status">Export Excel</a><button class="button" onclick="window.print()">Export PDF</button></div></div>
<form class="report-filters" method="get"><label>ตั้งแต่<input type="date" name="from" value="@ViewBag.From" /></label><label>ถึง<input type="date" name="to" value="@ViewBag.To" /></label><label>สถานะ<select name="status"><option value="all">ทุกสถานะ</option>@foreach(var s in statuses){<option value="@s.Name" selected="@(ViewBag.Status==s.Name)">@s.Name</option>}</select></label><button class="button" type="submit">กรอง</button></form>
<section class="report-cards"><div class="panel"><small>การจองทั้งหมด</small><strong>@ViewBag.Total</strong><span>รายการ</span></div><div class="panel"><small>ชั่วโมงการใช้งาน</small><strong>@rows.Sum(x=>(x.EndAt-x.StartAt).TotalHours).ToString("0.0")</strong><span>ชั่วโมง</span></div><div class="panel"><small>การจองจากห้องแชร์</small><strong>@ViewBag.SharedCount</strong><span>รายการ</span></div></section>
<section class="report-grid"><article class="panel"><h2>ห้องที่ถูกจองบ่อย</h2>@foreach(var r in usage){<div class="report-row"><b>@r.Name</b><span>@r.Count รายการ</span></div>}</article><article class="panel"><h2>สรุปตามสถานะ</h2>@foreach(var s in statuses){<div class="report-row"><b>@s.Name</b><span>@s.Count รายการ</span></div>}</article><article class="panel"><h2>การจองรายเดือน</h2>@foreach(var m in monthly){<div class="report-row"><b>@m.Name</b><span>@m.Count รายการ</span></div>}</article><article class="panel"><h2>ผู้จองที่ใช้ห้องมากที่สุด</h2>@foreach(var u in ViewBag.UserUsage){<div class="report-row"><b>@u.Name</b><span>@u.Count รายการ</span></div>}</article></section>
<section class="panel report-detail"><h2>รายละเอียดการใช้ห้องประชุม</h2>@foreach(var x in rows){<div class="report-row"><b>@x.Subject</b><span>@x.MeetingRoom?.Name · @x.User?.FullName · @x.StartAt.ToString("dd/MM/yyyy HH:mm")</span></div>}</section><div class="pagination-footer"><span>หน้า @ViewBag.Page จาก @ViewBag.Pages</span><div class="pagination-controls">@for(var p=1;p<=(int)ViewBag.Pages;p++){<a class="pagination-button @(p==(int)ViewBag.Page?"active":"")" asp-route-page="@p" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-status="@ViewBag.Status">@p</a>}</div></div>
