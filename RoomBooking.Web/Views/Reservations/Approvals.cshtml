@model IEnumerable<RoomBooking.Domain.Entities.Reservation>

@using RoomBooking.Web.Infrastructure;

@inject IAppTime AppTime

<link rel="stylesheet"
      href="~/css/approvals.css"
      asp-append-version="true" />

@{
    ViewData["Title"] = "Approvals";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">
            RESERVATION APPROVALS
        </span>

        <h1>
            อนุมัติการจอง
        </h1>

        <p>
            ตรวจสอบรายการจองที่รอการอนุมัติ
        </p>
    </div>
</div>

<section class="panel approval-panel">

    <div class="table-wrap">

        <table class="booking-table approval-table">

            <thead>
                <tr>
                    <th>หัวข้อ</th>
                    <th>ห้อง</th>
                    <th>ผู้จอง</th>
                    <th>วันเวลา</th>
                    <th>การจัดการ</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    /*
                     * StartAt / EndAt are stored as UTC.
                     */
                    var startUtc =
                        DateTime.SpecifyKind(
                            item.StartAt,
                            DateTimeKind.Utc);

                    var endUtc =
                        DateTime.SpecifyKind(
                            item.EndAt,
                            DateTimeKind.Utc);

                    /*
                     * Convert UTC -> Thailand
                     * only for displaying to the user.
                     */
                    var startThailand =
                        AppTime.UtcToThailand(startUtc);

                    var endThailand =
                        AppTime.UtcToThailand(endUtc);

                    <tr>

                        <td>
                            <b class="approval-title">
                                @item.Subject
                            </b>

                            <small class="approval-meta">
                                Reservation request
                            </small>
                        </td>

                        <td>
                            @item.MeetingRoom?.Name
                        </td>

                        <td>
                            @item.User?.FullName
                        </td>

                        <td>
                            @startThailand.ToString("dd/MM/yyyy HH:mm")
                            -
                            @endThailand.ToString("HH:mm")
                        </td>

                        <td>

                            <div class="approval-actions">

                                <form class="inline-form"
                                      asp-action="Approve"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button class="button"
                                            type="submit">
                                        อนุมัติ
                                    </button>

                                </form>

                                <form class="inline-form"
                                      asp-action="Reject"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <input type="hidden"
                                           name="reason"
                                           value="ไม่อนุมัติ" />

                                    <button class="link-danger"
                                            type="submit">
                                        ปฏิเสธ
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>