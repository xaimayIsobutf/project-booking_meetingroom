@{
    ViewData["Title"] = "จองห้องประชุม";

    var selectedDate = Context.Request.Query["date"].ToString();

    if (string.IsNullOrWhiteSpace(selectedDate))
    {
        selectedDate = DateTime.Now.ToString("yyyy-MM-dd");
    }

    var rooms =
        (IEnumerable<RoomBooking.Domain.Entities.MeetingRoom>)
        (ViewBag.Rooms ??
         new List<RoomBooking.Domain.Entities.MeetingRoom>());

    var selectedRoomId =
        ViewBag.RoomId?.ToString() ?? "";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">NEW RESERVATION</span>

        <h1>จองห้องประชุม</h1>

        <p>
            ระบุรายละเอียดการประชุมและช่วงเวลาที่ต้องการ
        </p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}

<form method="post" class="form-card">

    @Html.AntiForgeryToken()

    <label>
        หัวข้อการประชุม

        <input name="subject"
               required
               placeholder="เช่น Weekly Team Meeting"
               value="@Context.Request.Form["subject"]" />
    </label>

    <label>
        ห้องประชุม

        <select name="roomId" required>

            <option value="">
                -- เลือกห้องประชุม --
            </option>

            @foreach (var room in rooms)
            {
                <option value="@room.Id"
                        selected="@(selectedRoomId == room.Id.ToString() ? "selected" : null)">
                    @room.Name · รองรับ @room.Capacity คน
                </option>
            }

        </select>
    </label>

    <div class="form-row">

        <label>
            วันที่

            <input name="date"
                   type="date"
                   required
                   value="@selectedDate" />
        </label>

        <label>
            ช่วงเวลาการจอง

            <select name="bookingSlot" required>

                <option value="full-day">
                    เต็มวัน · 08:00–17:00
                </option>

                <option value="morning">
                    ครึ่งวันเช้า · 08:00–12:00
                </option>

                <option value="afternoon">
                    ครึ่งวันบ่าย · 13:00–17:00
                </option>

                <option value="morning-1">
                    รอบเช้า 1 · 08:00–10:00
                </option>

                <option value="morning-2">
                    รอบเช้า 2 · 10:00–12:00
                </option>

                <option value="afternoon-1">
                    รอบบ่าย 1 · 13:00–15:00
                </option>

                <option value="afternoon-2">
                    รอบบ่าย 2 · 15:00–17:00
                </option>

            </select>
        </label>

    </div>

    <label>
        จำนวนผู้เข้าร่วม

        <input name="attendeesCount"
               type="number"
               min="1"
               value="@(Context.Request.Form["attendeesCount"].ToString() == ""
                   ? "1"
                   : Context.Request.Form["attendeesCount"].ToString())"
               required />
    </label>

    <div class="actions">

        <a class="outline-button"
           asp-controller="Home"
           asp-action="Index">
            ยกเลิก
        </a>

        <button class="button"
                type="submit">
            บันทึกการจอง
        </button>

    </div>

</form>