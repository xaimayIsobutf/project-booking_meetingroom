@using System.Security.Claims
@using RoomBooking.Infrastructure.Persistence
@using RoomBooking.Web.Infrastructure
@inject RoomBookingDbContext Db
@{ var currentTenant = Context.TenantId(); var pendingCount = User.IsInRole("SuperAdmin") || User.IsInRole("TenantAdmin") || User.IsInRole("Approver") ? Db.Reservations.Count(x => currentTenant != null && x.CompanyId == currentTenant && x.Status == "Pending") : 0; }
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RoomBooking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/approvals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rooms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/share-room.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <script>document.documentElement.dataset.theme = localStorage.getItem('roombooking-theme-v2') || 'dark';</script>
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <img class="brand-logo" src="~/brand/logo-startbox.png" alt="Startbox" /><button class="menu-toggle">☰</button>
            </div>
            <div class="sidebar-label" data-i18n="nav.workspace">WORKSPACE</div>
            <nav class="side-nav"><a data-i18n="nav.dashboard" asp-controller="Home" asp-action="Index"><span>▦</span> Dashboard</a><a data-i18n="nav.rooms"
                asp-controller="Rooms" asp-action="Index"><span class="nav-icon nav-room" aria-hidden="true"></span> Meeting rooms</a><a data-i18n="nav.calendar"
                asp-controller="Reservations" asp-action="Calendar"><span>▣</span> Calendar Room</a><a data-i18n="nav.reports" asp-controller="Reports" asp-action="Index"><span>▤</span> Reports</a><a data-i18n="nav.reservations"
                asp-controller="Reservations" asp-action="Index"><span>⌑</span>
                Reservations</a>@if(User.IsInRole("SuperAdmin")||User.IsInRole("TenantAdmin")||User.IsInRole("Approver")){
                <a
                asp-controller="Reservations" asp-action="Approvals"><span>✓</span> <span data-i18n="nav.approvals">Approvals</span></a>
            }
        </nav>
        <div class="sidebar-label" data-i18n="nav.team">TEAM</div>
        <nav class="side-nav"><a data-i18n="nav.members" asp-controller="Users" asp-action="Index"><span>♙</span> Members</a></nav>
        <div class="sidebar-bottom"></div>
        </aside>
        <div class="main-shell">
            <header class="topbar">
                <div><span class="breadcrumb">Workspace</span>
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="top-actions"><button class="icon-button">?</button><a class="notification-link" asp-controller="Reservations" asp-action="Approvals">♧<i>@pendingCount</i></a><button class="theme-toggle" type="button" aria-label="เปลี่ยนโหมดสี"><span>☼</span><span>☾</span></button><select class="language-select" aria-label="ภาษา"><option value="en">EN</option><option value="th">ไทย</option><option value="lo">ລາວ</option></select>
                    <div class="company"><span class="avatar">@(User.Identity?.Name?.FirstOrDefault() ?? 'S')</span>
                        <div><b>@(User.Identity?.Name ?? "Guest")</b><small class="role-badge">@RoleLabel(User)</small>
                        </div>
                    </div>
                    <form class="header-logout" asp-controller="Account" asp-action="Logout" method="post"><button type="submit" title="ออกจากระบบ">↪ <span>ออกจากระบบ</span></button></form>
                </div>
            </header>
            <main class="main-content">@RenderBody()</main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/ux.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
@functions {
    private static string RoleLabel(ClaimsPrincipal user) => user.IsInRole("SuperAdmin") ? "Super Admin" :
    user.IsInRole("TenantAdmin") ? "Company Admin" : user.IsInRole("Approver") ? "Approver" : user.Identity?.IsAuthenticated
    == true ? "Employee" : "Guest";
}
