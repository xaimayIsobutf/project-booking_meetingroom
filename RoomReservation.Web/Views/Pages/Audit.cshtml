@model RoomReservation.Web.Models.AuditLogPageModel
@{ ViewData["Title"] = "Audit log"; }
<section class="page-head audit-head"><div><span class="eyebrow" data-audit-i18n="eyebrow">GOVERNANCE</span><h1 data-audit-i18n="title">Audit log</h1><p data-audit-i18n="subtitle">Track approvals, cancellations and important workspace changes.</p></div><span class="status confirmed"><b id="auditVisibleCount">@Model.Logs.Count</b> <span data-audit-i18n="events">events</span></span></section>
<section class="panel audit-filters"><label><span data-audit-i18n="search">Search</span><input id="auditSearch" type="search" placeholder="Action, user, meeting or room..." data-audit-placeholder="searchPlaceholder" /></label><label><span data-audit-i18n="action">Action</span><select id="auditAction"><option value="" data-audit-i18n="allActions">All actions</option>@foreach (var action in Model.Logs.Select(x => x.Action).Distinct().OrderBy(x => x)) { <option value="@action">@action</option> }</select></label><label><span data-audit-i18n="actor">Actor</span><select id="auditActor"><option value="" data-audit-i18n="allActors">All users</option>@foreach (var actor in Model.Logs.Select(x => string.IsNullOrWhiteSpace(x.ActorName) ? x.ActorEmail : x.ActorName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@actor">@actor</option> }</select></label><label><span data-audit-i18n="from">From</span><input id="auditFrom" type="date" /></label><label><span data-audit-i18n="to">To</span><input id="auditTo" type="date" /></label><button class="button ghost" id="auditReset" type="button" data-audit-i18n="reset">Reset</button></section>
<section class="panel audit-panel"><div class="panel-head"><div><h2 data-audit-i18n="activity">Activity history</h2><p class="muted-copy" data-audit-i18n="hint">Approval decisions and system activity are retained for traceability.</p></div></div><div class="table-wrap"><table id="auditTable"><thead><tr><th data-audit-i18n="time">Time</th><th data-audit-i18n="action">Action</th><th data-audit-i18n="actor">Actor</th><th data-audit-i18n="target">Target</th><th data-audit-i18n="details">Details</th></tr></thead><tbody>@if (!Model.Logs.Any()) { <tr><td colspan="5" class="empty-state" data-audit-i18n="empty">No audit events found.</td></tr> } @foreach (var log in Model.Logs) { var actor = string.IsNullOrWhiteSpace(log.ActorName) ? log.ActorEmail : log.ActorName; <tr data-audit-row data-action="@log.Action" data-actor="@actor" data-date="@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")" data-search="@(log.Action + " " + actor + " " + log.TargetName + " " + log.RoomName + " " + log.Metadata)"><td>@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="audit-action">@log.Action</span></td><td>@(string.IsNullOrWhiteSpace(actor) ? "-" : actor)</td><td>@(string.IsNullOrWhiteSpace(log.TargetName) ? log.TargetType + " · " + log.TargetId.ToString()[..8] : log.TargetName + (string.IsNullOrWhiteSpace(log.RoomName) ? "" : " · " + log.RoomName))</td><td><code>@log.Metadata</code></td></tr> }</tbody></table></div></section>
@section Scripts { <script>
(() => { const lang=localStorage.getItem('roombooking-language')||'en',d={en:{eyebrow:'GOVERNANCE',title:'Audit log',subtitle:'Track approvals, cancellations and important workspace changes.',events:'events',search:'Search',searchPlaceholder:'Action, user, meeting or room...',action:'Action',allActions:'All actions',actor:'Actor',allActors:'All users',from:'From',to:'To',reset:'Reset',activity:'Activity history',hint:'Approval decisions and system activity are retained for traceability.',time:'Time',target:'Target',details:'Details',empty:'No audit events found.'},th:{eyebrow:'การกำกับดูแล',title:'ประวัติการใช้งาน',subtitle:'ติดตามการอนุมัติ การยกเลิก และการเปลี่ยนแปลงสำคัญ',events:'เหตุการณ์',search:'ค้นหา',searchPlaceholder:'การทำงาน ผู้ใช้ การประชุม หรือห้อง...',action:'การทำงาน',allActions:'ทุกการทำงาน',actor:'ผู้ดำเนินการ',allActors:'ผู้ใช้ทั้งหมด',from:'ตั้งแต่',to:'ถึง',reset:'รีเซ็ต',activity:'ประวัติกิจกรรม',hint:'เก็บประวัติการอนุมัติและกิจกรรมเพื่อการตรวจสอบ',time:'เวลา',target:'รายการ',details:'รายละเอียด',empty:'ไม่พบประวัติการใช้งาน'},lo:{eyebrow:'ການກຳກັບດູແລ',title:'ບັນທຶກການໃຊ້ງານ',subtitle:'ຕິດຕາມການອະນຸມັດ ການຍົກເລີກ ແລະ ການປ່ຽນແປງ',events:'ເຫດການ',search:'ຄົ້ນຫາ',searchPlaceholder:'ການເຮັດວຽກ ຜູ້ໃຊ້ ການປະຊຸມ ຫຼື ຫ້ອງ...',action:'ການເຮັດວຽກ',allActions:'ທຸກການເຮັດວຽກ',actor:'ຜູ້ດຳເນີນການ',allActors:'ຜູ້ໃຊ້ທັງໝົດ',from:'ຈາກ',to:'ເຖິງ',reset:'ລ້າງ',activity:'ປະຫວັດກິດຈະກຳ',hint:'ເກັບປະຫວັດເພື່ອກວດສອບ',time:'ເວລາ',target:'ລາຍການ',details:'ລາຍລະອຽດ',empty:'ບໍ່ພົບບັນທຶກ'}}[lang]||{};document.querySelectorAll('[data-audit-i18n]').forEach(e=>{if(d[e.dataset.auditI18n])e.textContent=d[e.dataset.auditI18n]});document.querySelectorAll('[data-audit-placeholder]').forEach(e=>{if(d[e.dataset.auditPlaceholder])e.placeholder=d[e.dataset.auditPlaceholder]});const q=document.getElementById('auditSearch'),a=document.getElementById('auditAction'),u=document.getElementById('auditActor'),f=document.getElementById('auditFrom'),t=document.getElementById('auditTo'),rows=[...document.querySelectorAll('[data-audit-row]')],count=document.getElementById('auditVisibleCount');const apply=()=>{const term=(q.value||'').toLowerCase(),n=rows.filter(r=>{const ok=(!term||r.dataset.search.toLowerCase().includes(term))&&(!a.value||r.dataset.action===a.value)&&(!u.value||r.dataset.actor===u.value)&&(!f.value||r.dataset.date>=f.value)&&(!t.value||r.dataset.date<=t.value);r.hidden=!ok;return ok}).length;count.textContent=n};[q,a,u,f,t].forEach(x=>{x.addEventListener('input',apply);x.addEventListener('change',apply)});document.getElementById('auditReset').onclick=()=>{[q,a,u,f,t].forEach(x=>x.value='');apply()};document.getElementById('languageSelect')?.addEventListener('change',()=>location.reload())})();
</script> }
