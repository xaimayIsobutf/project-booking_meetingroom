    th: { qrHint: 'ดาวน์โหลดหรือพิมพ์ QR นี้เพื่อนำไปติดไว้หน้าห้อง', downloadQr: 'ดาวน์โหลดภาพ QR', showToken: 'แสดงรหัส', staticQr: 'QR นี้ไม่มีวันหมดอายุ เว้นแต่จะสร้างใหม่', regenerateQr: 'สร้าง QR ห้องใหม่' },
    lo: { qrHint: 'ດາວໂຫຼດ ຫຼື ພິມ QR ນີ້ໄປຕິດໄວ້ໜ້າຫ້ອງ', downloadQr: 'ດາວໂຫຼດຮູບ QR', showToken: 'ສະແດງລະຫັດ', staticQr: 'QR ນີ້ບໍ່ໝົດອາຍຸ ນອກຈາກຈະສ້າງໃໝ່', regenerateQr: 'ສ້າງ QR ຫ້ອງໃໝ່' }
  }[lang] || {};
  document.querySelectorAll('[data-rm-i18n]').forEach(element => {
