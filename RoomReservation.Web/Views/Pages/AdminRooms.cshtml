<script>
(()=>{
  const list=document.getElementById('displayDeviceList');
  if(!list)return;
  const language=()=>localStorage.getItem('roombooking-language')||'en';
  const copy={en:{label:'Delete',confirm:'Delete this revoked display permanently?'},th:{label:'ลบ',confirm:'ยืนยันลบอุปกรณ์ที่ยกเลิกการจับคู่นี้ถาวรหรือไม่?'},lo:{label:'ລົບ',confirm:'ຢືນຢັນລົບອຸປະກອນທີ່ຍົກເລີກນີ້ຖາວອນບໍ?'}};
  const isRevoked=row=>{const text=(row.querySelector('.paired-display-status,.muted-chip')?.textContent||'').trim().toLowerCase();return text==='revoked'||text.includes('ยกเลิก')||text.includes('ຍົກເລີກ');};
  const enhance=()=>list.querySelectorAll('.paired-display-row,.room-display-device-row').forEach(row=>{
    if(!isRevoked(row)||row.querySelector('.display-delete'))return;
    row.querySelectorAll('.display-regenerate,.display-revoke').forEach(button=>button.remove());
    const button=document.createElement('button');
    button.type='button';button.className='button danger display-delete';button.textContent=(copy[language()]||copy.en).label;button.dataset.deviceId=row.dataset.deviceId;
    button.onclick=async()=>{
      const text=copy[language()]||copy.en;
      if(!confirm(text.confirm))return;
      button.disabled=true;
      const response=await fetch('/api/v1/room-display/devices/'+encodeURIComponent(button.dataset.deviceId),{method:'DELETE'});
      if(response.ok)row.remove();else button.disabled=false;
    };
    (row.querySelector('.paired-display-actions')||row).appendChild(button);
  });
  new MutationObserver(enhance).observe(list,{childList:true,subtree:true});
  enhance();
})();
</script>
<script>document.getElementById('languageSelect')?.addEventListener('change',e=>localStorage.setItem('roombooking-language',e.target.value));</script>
<script>
(() => {
    const form = document.getElementById('inlineRoomForm');
    const addButton = document.getElementById('addRoomToggle');
    const closeButton = document.getElementById('closeRoomForm');
    const cancelButton = document.getElementById('cancelRoomForm');
    const rooms = document.getElementById('rooms');

    const showForm = (event) => {
        event?.preventDefault();
        if (!form) return;
        form.hidden = false;
        form.querySelector('input')?.focus();
    };
    const hideForm = (event) => {
        event?.preventDefault();
        if (!form) return;
        form.hidden = true;
        addButton?.focus();
    };

    addButton?.addEventListener('click', showForm, true);
    closeButton?.addEventListener('click', hideForm, true);
    cancelButton?.addEventListener('click', hideForm, true);

    document.querySelectorAll('[data-room-view]').forEach(button => {
        button.addEventListener('click', event => {
            event.preventDefault();
            const view = button.dataset.roomView || 'grid';
            rooms?.classList.toggle('list-view', view === 'list');
            document.querySelectorAll('[data-room-view]').forEach(item =>
                item.classList.toggle('selected', item.dataset.roomView === view));
            localStorage.setItem('room-management-view', view);
        }, true);
    });

    const savedView = localStorage.getItem('room-management-view');
    if (savedView === 'list') {
        rooms?.classList.add('list-view');
        document.querySelectorAll('[data-room-view]').forEach(item =>
            item.classList.toggle('selected', item.dataset.roomView === 'list'));
    }
})();
</script>
<script>
