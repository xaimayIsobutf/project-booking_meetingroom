@using RoomReservation.Domain.Enums
@model RoomReservation.Web.Models.RoomManagementPageModel
@{
    ViewData["Title"] = "Meeting rooms";
    TimeZoneInfo zone;
    try { zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId); } catch { zone = TimeZoneInfo.Utc; }
    var nowUtc = DateTime.UtcNow;
    var activeCount = Model.Rooms.Count(x => x.IsActive);
}
<link rel="stylesheet" href="~/css/pages.css?v=qr-download-1" />
<section class="panel room-display-devices-panel"><div class="panel-head"><div><span class="eyebrow">ROOM DISPLAY</span><h2>Paired displays</h2><p class="muted-copy">Pair a fixed screen to one room. The display cannot switch rooms from its URL.</p></div><div class="paired-display-header-actions"><button class="button ghost paired-display-toggle" type="button" id="togglePairedDisplays" aria-expanded="false" aria-controls="pairedDisplayContent">แสดง</button><button class="button primary" type="button" id="openPairDisplay">Pair Room Display</button></div></div><div class="paired-display-content" id="pairedDisplayContent" hidden><div class="room-display-device-list" id="displayDeviceList">@foreach (var device in Model.DisplayDevices) { var room = Model.Rooms.FirstOrDefault(x => x.Id == device.RoomId); <article class="room-display-device-row" data-device-id="@device.Id"><div><strong>@device.DisplayName</strong><span>@(room?.Name ?? "Unknown room")</span></div><span class="muted-chip">@(device.RevokedAt is null && device.IsActive ? (device.LastSeenAt >= DateTime.UtcNow.AddMinutes(-2) ? "Online" : "Offline") : "Revoked")</span><small>@(device.LastSeenAt is null ? "Never seen" : $"Last seen {device.LastSeenAt:yyyy-MM-dd HH:mm}")</small><button class="button ghost display-regenerate" type="button" data-device-id="@device.Id">New code</button><button class="button danger display-revoke" type="button" data-device-id="@device.Id">Unpair</button></article> }</div></div></section>
<script>
(()=>{const content=document.getElementById('pairedDisplayContent'),toggle=document.getElementById('togglePairedDisplays');if(!content||!toggle)return;const labels={en:{open:'Show',close:'Hide'},th:{open:'แสดง',close:'ซ่อน'},lo:{open:'ສະແດງ',close:'ເຊື່ອງ'}};const lang=()=>localStorage.getItem('roombooking-language')||'th';const setOpen=open=>{content.hidden=!open;toggle.setAttribute('aria-expanded',String(open));toggle.textContent=(labels[lang()]||labels.en)[open?'close':'open'];localStorage.setItem('paired-displays-open',open?'1':'0')};setOpen(localStorage.getItem('paired-displays-open')==='1');toggle.addEventListener('click',()=>setOpen(content.hidden));document.getElementById('languageSelect')?.addEventListener('change',()=>setTimeout(()=>setOpen(!content.hidden),80))})();
</script>
<dialog id="pairDisplayDialog" class="room-share-dialog"><button type="button" class="drawer-close" id="closePairDisplay">×</button><span class="eyebrow">ROOM DISPLAY</span><h2>Pair Room Display</h2><p>Choose a room and show this one-time code on the screen.</p><label><span>Room</span><select id="pairDisplayRoom">@foreach (var room in Model.OwnedRooms.Where(x => x.IsActive)) { <option value="@room.Id">@room.Name · @room.Building · @room.Floor</option> }</select></label><label><span>Display name</span><input id="pairDisplayName" placeholder="Front desk display" /></label><button class="button primary" id="startPairDisplay" type="button">Generate pairing code</button><div id="pairDisplayResult" hidden><strong id="pairDisplayCode"></strong><small id="pairDisplayExpiry"></small><label><span>Device ID</span><div class="room-share-link-row"><input id="pairDisplayDeviceId" readonly /><button type="button" class="button ghost" id="copyPairDisplayDeviceId">Copy</button></div></label><label><span>Organization ID</span><div class="room-share-link-row"><input id="pairDisplayOrganizationId" readonly /><button type="button" class="button ghost" id="copyPairDisplayOrganizationId">Copy</button></div></label><a id="pairDisplayAppLink" class="button primary">Open App to pair</a><a id="pairDisplayLink" target="_blank" rel="noopener">Open web pairing page</a></div><p id="pairDisplayStatus" class="muted-copy"></p></dialog>
<section class="page-head rooms-head"><div><span class="eyebrow" data-rm-i18n="eyebrow">ADMINISTRATION</span><h1 data-rm-i18n="title">Meeting rooms</h1><p data-rm-i18n="subtitle">Manage rooms, capacity and facilities.</p></div><button class="button primary" type="button" id="addRoomToggle" data-rm-i18n="add">+ Add room</button></section>
<section class="room-summary-grid"><div class="stat-card"><small data-rm-i18n="totalRooms">Total rooms</small><strong>@Model.Rooms.Count</strong></div><div class="stat-card"><small data-rm-i18n="activeRooms">Active rooms</small><strong>@activeCount</strong></div><div class="stat-card"><small data-rm-i18n="inactiveRooms">Inactive rooms</small><strong>@(Model.Rooms.Count - activeCount)</strong></div><div class="stat-card"><small data-rm-i18n="approvalRooms">Approval required</small><strong>@Model.Rooms.Count(x => x.RequiresApproval && x.IsActive)</strong></div></section>
<section class="panel inline-room-form" id="inlineRoomForm" hidden><div class="panel-head"><div><h2 data-rm-i18n="newTitle">Add a meeting room</h2><p data-rm-i18n="newHint">Add the room here without leaving this page.</p></div><button class="button ghost" type="button" id="closeRoomForm" data-rm-i18n="close">Close</button></div><form id="createRoomForm" method="post" action="/admin/rooms/create">@Html.AntiForgeryToken()<div class="inline-room-grid"><label><span data-rm-i18n="name">Room name</span><input name="Name" required placeholder="e.g. Focus Room" /></label><label><span data-rm-i18n="capacity">Capacity</span><input name="Capacity" type="number" min="1" required placeholder="12" /></label><label><span data-rm-i18n="building">Building</span><input name="Building" required placeholder="Startbox HQ" /></label><label><span data-rm-i18n="floor">Floor</span><input name="Floor" required placeholder="2" /></label></div><label><span data-rm-i18n="facilities">Facilities</span><input name="EquipmentTags" placeholder="TV, Projector, Video call" /></label><div class="inline-room-options"><label class="check-row"><input name="RequiresApproval" type="checkbox" value="true" /><span data-rm-i18n="approval">Require approval</span></label><label class="check-row"><input name="IsActive" type="checkbox" value="true" checked /><span data-rm-i18n="active">Active</span></label></div><div class="form-actions"><button class="button ghost" type="button" id="cancelRoomForm" data-rm-i18n="cancel">Cancel</button><button class="button primary" type="submit" data-rm-i18n="save">Save room</button></div></form><details class="equipment-admin-inline"><summary data-equipment-i18n="manage">Manage equipment</summary><p data-equipment-i18n="hint">Add equipment here and it will appear in room forms.</p><form method="post" action="/admin/rooms/equipment/create" class="equipment-admin-create">@Html.AntiForgeryToken()<input name="name" required placeholder="e.g. HDMI cable" data-equipment-placeholder="new" /><button class="button primary" type="submit" data-equipment-i18n="add">Add equipment</button></form><div class="equipment-admin-list">@foreach (var item in Model.Equipment) { <div class="equipment-admin-row"><form method="post" action="/admin/rooms/equipment/@item.Id/edit">@Html.AntiForgeryToken()<input name="name" value="@item.Name" aria-label="Equipment name" /><button class="button ghost" type="submit" data-equipment-i18n="save">Save</button></form>@if (item.IsActive) { <form method="post" action="/admin/rooms/equipment/@item.Id/deactivate">@Html.AntiForgeryToken()<button class="button danger" type="submit" data-equipment-i18n="deactivate">Deactivate</button></form> } else { <span class="muted-chip" data-equipment-i18n="inactive">Inactive</span> }</div> }</div></details></section>
<section class="panel room-management-panel"><div class="room-management-toolbar"><div class="room-view-switch"><button class="button ghost selected" type="button" data-room-view="grid" data-rm-i18n="grid">Grid</button><button class="button ghost" type="button" data-room-view="list" data-rm-i18n="list">List</button></div><span class="room-management-hint" data-rm-i18n="viewHint">Your last view is saved for next time.</span></div><div class="room-filters room-admin-filter"><input type="search" placeholder="Search rooms, facilities..." oninput="filterRoomCards()" data-rm-placeholder="search" /><select id="roomBuildingFilter" onchange="filterRoomCards()"><option value="" data-rm-i18n="allBuildings">All buildings</option>@foreach (var b in Model.Rooms.Select(x => x.Building).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@b">@b</option> }</select><select id="roomFloorFilter" onchange="filterRoomCards()"><option value="" data-rm-i18n="allFloors">All floors</option>@foreach (var f in Model.Rooms.Select(x => x.Floor).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@f">@f</option> }</select><select id="roomStatusFilter" onchange="filterRoomCards()"><option value="" data-rm-i18n="allStatuses">All statuses</option><option value="active" data-rm-i18n="active">Active</option><option value="inactive" data-rm-i18n="inactive">Inactive</option></select><select id="roomAvailabilityFilter" onchange="filterRoomCards()"><option value="" data-rm-i18n="allAvailability">All availability</option><option value="available" data-rm-i18n="available">Available</option><option value="occupied" data-rm-i18n="occupied">Occupied</option></select></div><div class="rooms-grid" id="rooms">@if (!Model.Rooms.Any()) { <div class="empty-state" data-rm-i18n="empty">No rooms yet.</div> } @foreach (var room in Model.Rooms) { var roomBookings = Model.Bookings.Where(x => x.RoomId == room.Id && x.Status != BookingStatus.Cancelled && x.Status != BookingStatus.NoShow).OrderBy(x => x.StartAtUtc).ToList(); var occupied = room.IsActive && roomBookings.Any(x => x.StartAtUtc <= nowUtc && x.EndAtUtc > nowUtc); var availability = !room.IsActive ? "inactive" : occupied ? "occupied" : "available"; var todayBookings = roomBookings.Where(x => x.StartAtUtc < nowUtc.AddDays(1) && x.EndAtUtc > nowUtc.AddDays(-1)).Take(4).ToList(); var upcoming = roomBookings.Where(x => x.StartAtUtc >= nowUtc).Take(3).ToList(); var history = Model.Bookings.Where(x => x.RoomId == room.Id && x.EndAtUtc < nowUtc).OrderByDescending(x => x.EndAtUtc).Take(3).ToList(); var isShared = Model.SharedRoomOwners.TryGetValue(room.Id, out var sharedOwner);<article class="room-management-card" data-room data-name="@room.Name.ToLowerInvariant()" data-shared="@isShared.ToString().ToLowerInvariant()" data-building="@room.Building" data-floor="@room.Floor" data-status="@(room.IsActive ? "active" : "inactive")" data-availability="@availability"><div class="room-card-main"><span class="room-icon">▦</span><div class="room-card-title"><h2>@room.Name</h2><p>@room.Building · <span data-rm-i18n="floorLabel">Floor</span> @room.Floor</p></div><span class="room-status-chip @(room.IsActive ? "active" : "inactive")" data-rm-status="@(room.IsActive ? "active" : "inactive")">@(room.IsActive ? "Active" : "Inactive")</span>@if (isShared) { <span class="shared-room-origin"><span data-rm-i18n="sharedFrom">แชร์มาจาก</span> @sharedOwner</span> }</div><div class="room-card-facts"><span><b>@room.Capacity</b> <span data-rm-i18n="seats">seats</span></span><span><b data-rm-status="@availability">@(availability == "available" ? "Available" : availability == "occupied" ? "Occupied" : "Inactive")</b></span>@if (room.RequiresApproval) { <span class="approval-chip" data-rm-i18n="approvalChip">Approval required</span> }</div><div class="chips">@if (room.EquipmentTags.Length == 0) { <span class="muted-chip" data-rm-i18n="noFacilities">No facilities listed</span> } @foreach (var tag in room.EquipmentTags) { <span class="chip">@tag</span> }</div><div class="room-card-actions">@if (!isShared) { <a class="button ghost" href="/admin/rooms/@room.Id/edit" data-rm-i18n="edit">Edit</a> }<a class="button ghost" href="/schedule?roomId=@room.Id" data-rm-i18n="calendar">View calendar</a>@if (room.IsActive) { <a class="button ghost" href="/bookings/new?roomId=@room.Id" data-rm-i18n="book">Book this room</a> }@if (!isShared) { <a class="button ghost" href="/admin/rooms/@room.Id/sharing" data-rm-i18n="share">Share room</a><button class="button ghost room-qr-button" type="button" data-room-id="@room.Id" data-room-name="@room.Name" data-rm-i18n="qr">Generate QR</button>@if (room.IsActive) { <form method="post" action="/admin/rooms/@room.Id/deactivate" class="inline-action-form" onsubmit="return confirmRoomDeactivate(event)">@Html.AntiForgeryToken()<button class="button danger" type="submit" data-rm-i18n="deactivate">Deactivate</button></form> } else { <form method="post" action="/admin/rooms/@room.Id/activate" class="inline-action-form">@Html.AntiForgeryToken()<button class="button ghost" type="submit" data-rm-i18n="reactivate">Reactivate</button></form> } }</div><details class="room-detail"><summary data-rm-i18n="details">Room details</summary><div class="room-detail-grid"><div><h3 data-rm-i18n="todaySchedule">Today schedule</h3>@if (!todayBookings.Any()) { <p class="muted-copy" data-rm-i18n="noBookings">No bookings today.</p> } @foreach (var booking in todayBookings) { <p class="detail-booking"><b>@booking.Title</b><span>@TimeZoneInfo.ConvertTimeFromUtc(booking.StartAtUtc, zone).ToString("HH:mm")–@TimeZoneInfo.ConvertTimeFromUtc(booking.EndAtUtc, zone).ToString("HH:mm")</span></p> }</div><div><h3 data-rm-i18n="upcoming">Upcoming bookings</h3>@if (!upcoming.Any()) { <p class="muted-copy" data-rm-i18n="none">None</p> } @foreach (var booking in upcoming) { <p class="detail-booking"><b>@booking.Title</b><span>@TimeZoneInfo.ConvertTimeFromUtc(booking.StartAtUtc, zone).ToString("dd/MM HH:mm")</span></p> }</div><div><h3 data-rm-i18n="history">Usage history</h3>@if (!history.Any()) { <p class="muted-copy" data-rm-i18n="none">None</p> } @foreach (var booking in history) { <p class="detail-booking"><b>@booking.Title</b><span>@TimeZoneInfo.ConvertTimeFromUtc(booking.StartAtUtc, zone).ToString("dd/MM/yyyy")</span></p> }</div>@if (isShared) { <div><h3 data-rm-i18n="access">Access</h3><p class="shared-room-origin"><span data-rm-i18n="sharedFrom">Shared from</span> @sharedOwner</p></div> } else { <div><h3 data-rm-i18n="access">Access</h3><p class="muted-copy" data-rm-i18n="accessHint">Room sharing and booking permissions are managed here.</p><a href="/admin/rooms/@room.Id/sharing" data-rm-i18n="manageAccess">Manage access</a></div> }</div></details></article> }</div><div class="empty-state" id="roomFilterEmpty" hidden data-rm-i18n="noMatch">No rooms match your filters.</div></section>
<dialog id="roomQrDialog" class="room-qr-dialog"><button type="button" class="drawer-close" id="closeQrDialog">×</button><h2 data-rm-i18n="qrTitle">Static room QR code</h2><p id="qrRoomName"></p><img id="qrImage" class="room-qr-image" alt="Room check-in QR code" /><p class="room-qr-caption" data-rm-i18n="qrHint">Print or download this QR and place it at the room.</p><a id="downloadRoomQr" class="button primary room-qr-download" download data-rm-i18n="downloadQr">Download QR image</a><details class="room-qr-token-details"><summary data-rm-i18n="showToken">Show code</summary><code id="qrToken">Loading...</code></details><small id="qrExpiry">This QR does not expire unless regenerated.</small><button type="button" class="button danger" id="regenerateRoomQr" data-rm-i18n="regenerateQr">Regenerate room QR</button></dialog>
<dialog id="roomEditDialog" class="room-edit-dialog"><button type="button" class="drawer-close" id="closeRoomEdit">×</button><span class="eyebrow">ROOM SETTINGS</span><h2 data-room-edit-i18n="title">Edit room</h2><p class="muted-copy" data-room-edit-i18n="hint">Update room information without leaving this page.</p><form id="roomEditForm" method="post">@Html.AntiForgeryToken()<label><span data-room-edit-i18n="name">Room name</span><input id="editRoomName" name="Name" required /></label><div class="room-edit-grid"><label><span data-room-edit-i18n="building">Building</span><input id="editRoomBuilding" name="Building" required /></label><label><span data-room-edit-i18n="floor">Floor</span><input id="editRoomFloor" name="Floor" required /></label><label><span data-room-edit-i18n="capacity">Capacity</span><input id="editRoomCapacity" name="Capacity" type="number" min="1" required /></label></div><label><span data-room-edit-i18n="equipment">Equipment</span><div class="room-edit-equipment-picker"><div class="equipment-picker-row"><select id="editRoomEquipmentSelect"><option value="" data-room-edit-i18n="selectEquipment">Select equipment</option>@foreach (var item in Model.Equipment.Where(x => x.IsActive)) { <option value="@item.Name">@item.Name</option> }</select><button type="button" class="button ghost" id="addEditRoomEquipment" data-room-edit-i18n="addEquipment">Add equipment</button></div><div class="equipment-chips" id="editRoomEquipmentChips"></div></div></label><label class="share-check"><input id="editRoomApproval" name="RequiresApproval" type="checkbox" value="true" /><span data-room-edit-i18n="approval">Require approval</span></label><label class="share-check"><input id="editRoomActive" name="IsActive" type="checkbox" value="true" /><span data-room-edit-i18n="active">Active</span></label><div class="room-share-actions"><button type="button" class="button ghost" id="cancelRoomEdit" data-room-edit-i18n="cancel">Cancel</button><button type="submit" class="button primary" data-room-edit-i18n="save">Save changes</button></div><small id="roomEditStatus" class="muted-copy"></small></form></dialog>
<script>
(()=>{
 const dialog=document.getElementById('roomEditDialog'),form=document.getElementById('roomEditForm');
 if(!dialog||!form)return;
 const field=id=>document.getElementById(id),select=field('editRoomEquipmentSelect'),chips=field('editRoomEquipmentChips'),values=[];
 const labels={en:{title:'Edit room',hint:'Update room information without leaving this page.',name:'Room name',building:'Building',floor:'Floor',capacity:'Capacity',equipment:'Equipment',selectEquipment:'Select equipment',addEquipment:'Add equipment',approval:'Require approval',active:'Active',cancel:'Cancel',save:'Save changes'},th:{title:'แก้ไขห้องประชุม',hint:'แก้ไขข้อมูลห้องและอุปกรณ์ได้จากหน้านี้',name:'ชื่อห้อง',building:'อาคาร',floor:'ชั้น',capacity:'ความจุ',equipment:'อุปกรณ์',selectEquipment:'เลือกอุปกรณ์',addEquipment:'เพิ่มอุปกรณ์',approval:'ต้องรออนุมัติ',active:'เปิดใช้งาน',cancel:'ยกเลิก',save:'บันทึกการแก้ไข'},lo:{title:'ແກ້ໄຂຫ້ອງປະຊຸມ',hint:'ແກ້ໄຂຂໍ້ມູນຫ້ອງ ແລະ ອຸປະກອນຢູ່ໜ້ານີ້',name:'ຊື່ຫ້ອງ',building:'ອາຄານ',floor:'ຊັ້ນ',capacity:'ຄວາມຈຸ',equipment:'ອຸປະກອນ',selectEquipment:'ເລືອກອຸປະກອນ',addEquipment:'ເພີ່ມອຸປະກອນ',approval:'ຕ້ອງລໍຖ້າອະນຸມັດ',active:'ເປີດໃຊ້ງານ',cancel:'ຍົກເລີກ',save:'ບັນທຶກການແກ້ໄຂ'}};
 const lang=localStorage.getItem('roombooking-language')||'en',copy=labels[lang]||labels.en;
 document.querySelectorAll('[data-room-edit-i18n]').forEach(e=>{e.textContent=copy[e.dataset.roomEditI18n]||e.textContent});
 const renderEquipment=()=>{chips.innerHTML='';form.querySelectorAll('input[data-room-equipment]').forEach(x=>x.remove());values.forEach(value=>{const chip=document.createElement('span');chip.className='chip equipment-chip';chip.append(document.createTextNode(value));const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.setAttribute('aria-label','Remove '+value);remove.onclick=()=>{values.splice(values.indexOf(value),1);renderEquipment()};chip.append(remove);chips.append(chip);const hidden=document.createElement('input');hidden.type='hidden';hidden.name='EquipmentTags';hidden.value=value;hidden.dataset.roomEquipment='true';form.append(hidden)})};
 field('addEditRoomEquipment')?.addEventListener('click',()=>{const value=select.value;if(value&&!values.includes(value)){values.push(value);renderEquipment();select.value=''}});
 document.addEventListener('click',e=>{const a=e.target.closest?.('a[href*="/edit"]');if(!a)return;e.preventDefault();e.stopImmediatePropagation();const card=a.closest('[data-room]'),id=a.getAttribute('href').split('/').slice(-2,-1)[0];if(!card)return;values.splice(0,values.length);card.querySelectorAll('.chips .chip').forEach(x=>values.push(x.textContent.trim()));renderEquipment();const facts=card.querySelectorAll('.room-card-facts b');form.action=`/admin/rooms/${id}/edit`;field('editRoomName').value=card.querySelector('.room-card-title h2')?.textContent.trim()||'';field('editRoomBuilding').value=card.dataset.building||'';field('editRoomFloor').value=card.dataset.floor||'';field('editRoomCapacity').value=facts[0]?.textContent.trim()||'';field('editRoomApproval').checked=!!card.querySelector('.approval-chip');field('editRoomActive').checked=card.dataset.status==='active';field('roomEditStatus').textContent='';dialog.showModal()},true);
 field('closeRoomEdit').onclick=()=>dialog.close();field('cancelRoomEdit').onclick=()=>dialog.close();
})();
</script>
<script>
(() => {
  const lang = localStorage.getItem('roombooking-language') || 'en';
  const copy = {
    en: { qrHint: 'Print or download this QR and place it at the room.', downloadQr: 'Download QR image', showToken: 'Show code', staticQr: 'This QR does not expire unless regenerated.', regenerateQr: 'Regenerate room QR' },
    th: { qrHint: 'ดาวน์โหลดหรือพิมพ์ QR นี้เพื่อนำไปติดไว้หน้าห้อง', downloadQr: 'ดาวน์โหลดภาพ QR', showToken: 'แสดงรหัส', staticQr: 'QR นี้ไม่มีวันหมดอายุ เว้นแต่จะสร้างใหม่', regenerateQr: 'สร้าง QR ห้องใหม่' },
    lo: { qrHint: 'ດາວໂຫຼດ ຫຼື ພິມ QR ນີ້ໄປຕິດໄວ້ໜ້າຫ້ອງ', downloadQr: 'ດາວໂຫຼດຮູບ QR', showToken: 'ສະແດງລະຫັດ', staticQr: 'QR ນີ້ບໍ່ໝົດອາຍຸ ນອກຈາກຈະສ້າງໃໝ່', regenerateQr: 'ສ້າງ QR ຫ້ອງໃໝ່' }
  }[lang] || {};
  const applyQrCopy = () => document.querySelectorAll('[data-rm-i18n]').forEach(element => {
    if (copy[element.dataset.rmI18n]) element.textContent = copy[element.dataset.rmI18n];
  });
  window.addEventListener('load', applyQrCopy, { once: true });
  setTimeout(applyQrCopy, 250);
})();
</script>
<script>
(() => {
  const dialog = document.getElementById('roomQrDialog');
  const regenerate = document.getElementById('regenerateRoomQr');
  let roomId = null;
  const staticQrText = () => ({ en: 'This QR does not expire unless regenerated.', th: 'QR นี้ไม่มีวันหมดอายุ เว้นแต่จะสร้างใหม่', lo: 'QR ນີ້ບໍ່ໝົດອາຍຸ ນອກຈາກຈະສ້າງໃໝ່' }[document.getElementById('languageSelect')?.value || 'en'] || 'This QR does not expire unless regenerated.');
  document.querySelectorAll('[data-room]').forEach(card => {
    const actions = card.querySelector('.room-card-actions');
    if (!actions || actions.querySelector('.room-qr-button')) return;
    const scheduleLink = card.querySelector('a[href*="/schedule?roomId="]');
    const id = scheduleLink?.href.split('roomId=')[1];
    if (!id) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'button ghost room-qr-button';
    button.dataset.roomId = id;
    button.dataset.roomName = card.querySelector('.room-card-title h2')?.textContent.trim() || '';
    button.dataset.rmI18n = 'qr';
    button.textContent = 'Generate QR';
    actions.insertBefore(button, actions.lastElementChild);
  });
  document.querySelectorAll('.room-qr-button').forEach(button => {
    button.addEventListener('click', async () => {
      roomId = button.dataset.roomId;
      const image = document.getElementById('qrImage');
      const download = document.getElementById('downloadRoomQr');
      const imageUrl = `/api/v1/checkin/qr/${encodeURIComponent(roomId)}/image`;
      document.getElementById('qrRoomName').textContent = button.dataset.roomName || '';
      document.getElementById('qrToken').textContent = 'Loading...';
      image.removeAttribute('src');
      download.removeAttribute('href');
      dialog.showModal();
      image.src = `${imageUrl}?v=${Date.now()}`;
      download.href = `${imageUrl}?download=true`;
      try {
        const response = await fetch(`/api/v1/checkin/qr/${encodeURIComponent(roomId)}/current`);
        if (!response.ok) throw new Error();
        const result = await response.json();
        document.getElementById('qrToken').textContent = result.token || 'QR unavailable';
        document.getElementById('qrExpiry').textContent = result.isStatic || !result.expiresAt ? staticQrText() : new Date(result.expiresAt).toLocaleString();
      } catch {
        document.getElementById('qrToken').textContent = 'QR unavailable';
      }
      setTimeout(() => { document.getElementById('qrExpiry').textContent = staticQrText(); }, 300);
    });
  });
  regenerate?.addEventListener('click', async () => {
    if (!roomId || !confirm('Regenerate this room QR? Existing printed QR will stop working.')) return;
    regenerate.disabled = true;
    try {
      const response = await fetch(`/api/v1/room-display/rooms/${roomId}/checkin-code/regenerate`, { method: 'POST' });
      if (!response.ok) throw new Error();
      const result = await response.json();
      document.getElementById('qrToken').textContent = result.token;
      document.getElementById('qrExpiry').textContent = staticQrText();
      const imageUrl = `/api/v1/checkin/qr/${encodeURIComponent(roomId)}/image`;
      document.getElementById('qrImage').src = `${imageUrl}?v=${Date.now()}`;
      document.getElementById('downloadRoomQr').href = `${imageUrl}?download=true`;
    } catch {
      alert('Could not regenerate the room QR.');
    } finally {
      regenerate.disabled = false;
    }
  });
})();
</script>
<script>
(() => {
    const list = document.getElementById('displayDeviceList');
    if (!list) return;
    const applyStatusColors = () => list.querySelectorAll('.muted-chip').forEach(chip => {
        const text = (chip.textContent || '').trim().toLowerCase();
        const status = text.includes('revoked') || text.includes('ยกเลิก') || text.includes('ຍົກເລີກ')
            ? 'revoked'
            : text.includes('online') || text.includes('ออนไลน์') || text.includes('ອອນລາຍ')
                ? 'online'
                : 'offline';
        chip.classList.remove('status-online', 'status-offline', 'status-revoked');
        chip.classList.add(`status-${status}`);
    });
    applyStatusColors();
    new MutationObserver(applyStatusColors).observe(list, { childList: true, subtree: true });
})();
</script>
