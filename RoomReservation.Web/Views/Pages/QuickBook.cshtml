@model RoomReservation.Web.Models.BookingFormModel
@{ ViewData["Title"] = "Quick book"; }
<section class="page-head quick-book-head"><div><span class="eyebrow" data-qb-i18n="eyebrow">FAST FLOW</span><h1 data-qb-i18n="title">Quick book</h1><p data-qb-i18n="subtitle">Find an available room and reserve it in a few steps.</p></div><a class="button ghost" href="/schedule" data-qb-i18n="calendar">See availability</a></section>
<form class="quick-book-layout" method="post" action="/bookings/new" id="quickBookForm">
    @Html.AntiForgeryToken()
    <div class="quick-book-main">
        <section class="panel quick-book-section"><div class="quick-book-section-head"><span>01</span><div><h2 data-qb-i18n="when">When do you need a room?</h2><p data-qb-i18n="whenHint">Choose a future date and time.</p></div></div><div class="quick-book-time-grid"><label><span data-qb-i18n="start">Start</span><input type="datetime-local" name="StartAt" value="@Model.StartAt.ToString("yyyy-MM-ddTHH:mm")" required /></label><label><span data-qb-i18n="end">End</span><input type="datetime-local" name="EndAt" value="@Model.EndAt.ToString("yyyy-MM-ddTHH:mm")" required /></label><label><span data-qb-i18n="attendees">Attendees</span><input type="number" name="AttendeeCount" value="@Model.AttendeeCount" min="1" required /></label></div><p class="quick-book-duration" id="quickDuration"></p></section>
        <section class="panel quick-book-section"><div class="quick-book-section-head"><span>02</span><div><h2 data-qb-i18n="roomTitle">Find an available room</h2><p data-qb-i18n="roomHint">Filter the list, then select one room.</p></div></div><div class="quick-room-filters"><label><span data-qb-i18n="search">Search</span><input id="quickRoomSearch" type="search" placeholder="Room name or facility" data-qb-placeholder="searchPlaceholder" /></label><label><span data-qb-i18n="building">Building</span><select id="quickBuilding"><option value="" data-qb-i18n="allBuildings">All buildings</option>@foreach (var b in Model.Rooms.Select(x => x.Building).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@b">@b</option> }</select></label><label><span data-qb-i18n="floor">Floor</span><select id="quickFloor"><option value="" data-qb-i18n="allFloors">All floors</option>@foreach (var f in Model.Rooms.Select(x => x.Floor).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@f">@f</option> }</select></label><label><span data-qb-i18n="capacity">Capacity</span><select id="quickCapacity"><option value="0" data-qb-i18n="anyCapacity">Any capacity</option><option value="4">4+</option><option value="8">8+</option><option value="12">12+</option><option value="20">20+</option></select></label></div><div class="quick-room-grid" id="quickRoomGrid">@foreach (var room in Model.Rooms) { <label class="quick-room-card" data-name="@room.Name.ToLowerInvariant()" data-building="@room.Building" data-floor="@room.Floor" data-capacity="@room.Capacity" data-facilities="@string.Join(" ", room.EquipmentTags)"><input type="radio" name="RoomId" value="@room.Id" @(Model.RoomId == room.Id ? "checked" : "") /><span class="quick-room-icon">▦</span><span class="quick-room-copy"><b>@room.Name</b><small>@room.Building · @room.Floor · @room.Capacity <span data-qb-i18n="seats">seats</span></small><small>@(room.EquipmentTags.Length == 0 ? "" : string.Join(" · ", room.EquipmentTags))@(room.RequiresApproval ? " · Approval required" : "")</small></span><span class="quick-room-check">✓</span></label> }</div><div class="quick-no-rooms" id="quickNoRooms" hidden data-qb-i18n="noRooms">No rooms match your filters.</div></section>
        <section class="panel quick-book-section"><div class="quick-book-section-head"><span>03</span><div><h2 data-qb-i18n="details">Meeting details</h2><p data-qb-i18n="detailsHint">Add a short title so people know what this reservation is for.</p></div></div><label class="quick-title-field"><span data-qb-i18n="meetingTitle">Meeting title</span><input name="Title" placeholder="e.g. Weekly team meeting" data-qb-placeholder="titlePlaceholder" required /></label></section>
    </div>
    <aside class="panel quick-book-summary"><span class="eyebrow" data-qb-i18n="summaryEyebrow">READY TO BOOK</span><h2 data-qb-i18n="summaryTitle">Booking summary</h2><div class="quick-summary-room" id="quickSummaryRoom" data-qb-i18n="selectRoom">Select a room</div><dl><div><dt data-qb-i18n="summaryDate">Date</dt><dd id="quickSummaryDate">—</dd></div><div><dt data-qb-i18n="summaryTime">Time</dt><dd id="quickSummaryTime">—</dd></div><div><dt data-qb-i18n="summaryDuration">Duration</dt><dd id="quickSummaryDuration">—</dd></div><div><dt data-qb-i18n="summaryPeople">People</dt><dd id="quickSummaryPeople">1</dd></div></dl><div class="quick-book-error" id="quickBookError" hidden></div><button class="button primary quick-submit" type="submit" data-qb-i18n="bookNow">Book now</button><a class="button ghost quick-cancel" href="/bookings" data-qb-i18n="cancel">Cancel</a></aside>
</form>
@section Scripts { <script>
(() => { const lang=localStorage.getItem('roombooking-language')||'en'; const m={en:{eyebrow:'FAST FLOW',title:'Quick book',subtitle:'Find an available room and reserve it in a few steps.',calendar:'See availability',when:'When do you need a room?',whenHint:'Choose a future date and time.',start:'Start',end:'End',attendees:'Attendees',roomTitle:'Find an available room',roomHint:'Filter the list, then select one room.',search:'Search',searchPlaceholder:'Room name or facility',building:'Building',allBuildings:'All buildings',floor:'Floor',allFloors:'All floors',capacity:'Capacity',anyCapacity:'Any capacity',seats:'seats',noRooms:'No rooms match your filters.',details:'Meeting details',detailsHint:'Add a short title so people know what this reservation is for.',meetingTitle:'Meeting title',titlePlaceholder:'e.g. Weekly team meeting',summaryEyebrow:'READY TO BOOK',summaryTitle:'Booking summary',selectRoom:'Select a room',summaryDate:'Date',summaryTime:'Time',summaryDuration:'Duration',summaryPeople:'People',bookNow:'Book now',cancel:'Cancel'},th:{eyebrow:'จองด่วน',title:'จองห้องด่วน',subtitle:'ค้นหาห้องว่างและจองได้ในไม่กี่ขั้นตอน',calendar:'ดูห้องว่าง',when:'ต้องการห้องเมื่อไหร่?',whenHint:'เลือกวันที่และเวลาในอนาคต',start:'เริ่ม',end:'สิ้นสุด',attendees:'ผู้เข้าร่วม',roomTitle:'ค้นหาห้องว่าง',roomHint:'กรองรายการแล้วเลือกห้อง',search:'ค้นหา',searchPlaceholder:'ชื่อห้องหรืออุปกรณ์',building:'อาคาร',allBuildings:'ทุกอาคาร',floor:'ชั้น',allFloors:'ทุกชั้น',capacity:'ความจุ',anyCapacity:'ทุกความจุ',seats:'ที่นั่ง',noRooms:'ไม่พบห้องตามตัวกรอง',details:'รายละเอียดการประชุม',detailsHint:'ใส่หัวข้อสั้น ๆ สำหรับการจองนี้',meetingTitle:'หัวข้อการประชุม',titlePlaceholder:'เช่น ประชุมทีมประจำสัปดาห์',summaryEyebrow:'พร้อมจอง',summaryTitle:'สรุปการจอง',selectRoom:'เลือกห้อง',summaryDate:'วันที่',summaryTime:'เวลา',summaryDuration:'ระยะเวลา',summaryPeople:'จำนวนคน',bookNow:'จองเลย',cancel:'ยกเลิก'},lo:{eyebrow:'ຈອງດ່ວນ',title:'ຈອງຫ້ອງດ່ວນ',subtitle:'ຄົ້ນຫາຫ້ອງວ່າງ ແລະ ຈອງໃນບໍ່ກີ່ຂັ້ນຕອນ',calendar:'ເບິ່ງຫ້ອງວ່າງ',when:'ຕ້ອງການຫ້ອງເມື່ອໃດ?',whenHint:'ເລືອກວັນທີ ແລະ ເວລາອະນາຄົດ',start:'ເລີ່ມ',end:'ສິ້ນສຸດ',attendees:'ຜູ້ເຂົ້າຮ່ວມ',roomTitle:'ຄົ້ນຫາຫ້ອງວ່າງ',roomHint:'ກອງລາຍການ ແລະ ເລືອກຫ້ອງ',search:'ຄົ້ນຫາ',searchPlaceholder:'ຊື່ຫ້ອງ ຫຼື ອຸປະກອນ',building:'ອາຄານ',allBuildings:'ທຸກອາຄານ',floor:'ຊັ້ນ',allFloors:'ທຸກຊັ້ນ',capacity:'ຄວາມຈຸ',anyCapacity:'ທຸກຄວາມຈຸ',seats:'ບ່ອນນັ່ງ',noRooms:'ບໍ່ພົບຫ້ອງຕາມຕົວກອງ',details:'ລາຍລະອຽດການປະຊຸມ',detailsHint:'ໃສ່ຫົວຂໍ້ສັ້ນໆສຳລັບການຈອງນີ້',meetingTitle:'ຫົວຂໍ້ການປະຊຸມ',titlePlaceholder:'ເຊັ່ນ ປະຊຸມທີມປະຈຳອາທິດ',summaryEyebrow:'ພ້ອມຈອງ',summaryTitle:'ສະຫຼຸບການຈອງ',selectRoom:'ເລືອກຫ້ອງ',summaryDate:'ວັນທີ',summaryTime:'ເວລາ',summaryDuration:'ໄລຍະເວລາ',summaryPeople:'ຈຳນວນຄົນ',bookNow:'ຈອງເລີຍ',cancel:'ຍົກເລີກ'}}[lang]||{}; document.querySelectorAll('[data-qb-i18n]').forEach(e=>{if(m[e.dataset.qbI18n])e.textContent=m[e.dataset.qbI18n]}); document.querySelectorAll('[data-qb-placeholder]').forEach(e=>{if(m[e.dataset.qbPlaceholder])e.placeholder=m[e.dataset.qbPlaceholder]}); const form=document.getElementById('quickBookForm'), start=form.querySelector('[name="StartAt"]'), end=form.querySelector('[name="EndAt"]'), people=form.querySelector('[name="AttendeeCount"]'), search=document.getElementById('quickRoomSearch'), building=document.getElementById('quickBuilding'), floor=document.getElementById('quickFloor'), capacity=document.getElementById('quickCapacity'), cards=[...document.querySelectorAll('.quick-room-card')], duration=document.getElementById('quickDuration'), error=document.getElementById('quickBookError'); const update=()=>{const s=new Date(start.value),e=new Date(end.value),mins=(e-s)/60000;duration.textContent=mins>0?`${Math.floor(mins/60)}h ${mins%60?mins%60+'m':''}`:' ';document.getElementById('quickSummaryDate').textContent=start.value?start.value.slice(0,10):'—';document.getElementById('quickSummaryTime').textContent=start.value&&end.value?`${start.value.slice(11)}–${end.value.slice(11)}`:'—';document.getElementById('quickSummaryDuration').textContent=mins>0?`${Math.floor(mins/60)}h ${mins%60?mins%60+'m':''}`:'—';document.getElementById('quickSummaryPeople').textContent=people.value||'1';const q=(search.value||'').toLowerCase(),cap=Number(capacity.value||0);let visible=0;cards.forEach(c=>{const ok=(!q||`${c.dataset.name} ${c.dataset.facilities}`.toLowerCase().includes(q))&&(!building.value||c.dataset.building===building.value)&&(!floor.value||c.dataset.floor===floor.value)&&Number(c.dataset.capacity)>=cap;c.hidden=!ok;if(ok)visible++});document.getElementById('quickNoRooms').hidden=visible>0;const selected=form.querySelector('[name="RoomId"]:checked');document.getElementById('quickSummaryRoom').textContent=selected?.closest('.quick-room-card')?.querySelector('b')?.textContent||m.selectRoom||'Select a room';}; [start,end,people,search,building,floor,capacity].forEach(x=>x.addEventListener('input',update));cards.forEach(c=>c.addEventListener('click',update));form.addEventListener('submit',e=>{const s=new Date(start.value),en=new Date(end.value),now=new Date();error.hidden=true;if(!form.querySelector('[name="RoomId"]:checked')){e.preventDefault();error.hidden=false;error.textContent=lang==='th'?'กรุณาเลือกห้อง':lang==='lo'?'ກະລຸນາເລືອກຫ້ອງ':'Please select a room';}else if(s<now||en<=s){e.preventDefault();error.hidden=false;error.textContent=lang==='th'?'กรุณาตรวจสอบวันเวลา':lang==='lo'?'ກະລຸນາກວດສອບວັນເວລາ':'Please check the date and time';}}); update(); document.getElementById('languageSelect')?.addEventListener('change',()=>location.reload()); })();
</script><script>
(() => { const start=document.querySelector('#quickBookForm [name="StartAt"]'), end=document.querySelector('#quickBookForm [name="EndAt"]'), cards=[...document.querySelectorAll('.quick-room-card')]; const refreshAvailability=async()=>{if(!start.value||!end.value||new Date(end.value)<=new Date(start.value))return; try { const r=await fetch(`/quick-book/available?startAt=${encodeURIComponent(start.value)}&endAt=${encodeURIComponent(end.value)}`); if(!r.ok)return; const ids=(await r.json()).map(String); cards.forEach(card=>{const input=card.querySelector('input[name="RoomId"]'),available=ids.includes(String(input.value)); input.disabled=!available; card.classList.toggle('unavailable',!available); let badge=card.querySelector('.quick-room-availability'); if(!badge){badge=document.createElement('small');badge.className='quick-room-availability';card.querySelector('.quick-room-copy').append(badge)} badge.textContent=available?'Available':'Occupied'; if(!available&&input.checked){input.checked=false;document.getElementById('quickSummaryRoom').textContent='Select a room'}}); } catch (_) {} }; [start,end].forEach(x=>x.addEventListener('change',refreshAvailability)); refreshAvailability(); })();
</script> }
