@model RoomReservation.Web.Models.DashboardPageModel
@{ ViewData["Title"] = "Dashboard"; var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId); DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), zone); }
<section class="page-head dashboard-hero"><div><span class="eyebrow" data-i18n="dashboard.overview">OVERVIEW</span><h1><span data-i18n="dashboard.welcome">Welcome back</span>, @User.Identity?.Name</h1><p data-i18n="dashboard.subtitle">Everything your team needs to manage meeting rooms.</p></div><div class="quick-actions"><a class="button primary" href="/bookings/new" data-i18n="dashboard.bookRoom">+ Book a room</a><a class="button ghost" href="/schedule" data-i18n="dashboard.viewCalendar">View calendar</a></div></section>
<div class="stat-grid"><div class="stat-card"><span data-i18n="dashboard.rooms">Rooms</span><strong>@Model.Rooms.Count</strong><small data-i18n="dashboard.activeRooms">Active meeting rooms</small></div><div class="stat-card"><span data-i18n="dashboard.upcoming">Upcoming</span><strong>@Model.Upcoming.Count</strong><small data-i18n="dashboard.nextReservations">Next reservations</small></div><div class="stat-card"><span data-i18n="dashboard.pending">Pending approval</span><strong>@Model.PendingCount</strong><small data-i18n="dashboard.needAttention">Need your attention</small></div><div class="stat-card"><span data-i18n="dashboard.today">Today</span><strong>@Model.TodayBookings.Count</strong><small data-i18n="dashboard.bookingsToday">Bookings today</small></div></div>
<section class="dashboard-quick panel"><div><span class="eyebrow" data-i18n="dashboard.quickActions">QUICK ACTIONS</span><h2 data-i18n="dashboard.keepMoving">Keep your day moving</h2><p data-i18n="dashboard.quickSubtitle">Start a reservation or see what is happening in your workspace.</p></div><div class="quick-actions"><a class="button primary" href="/bookings/new" data-i18n="dashboard.bookRoom">Book a room</a><a class="button ghost" href="/admin/rooms" data-i18n="dashboard.manageRooms">Manage rooms</a><a class="button ghost" href="/check-in" data-i18n="dashboard.checkIn">Check in</a></div></section>
<div class="content-grid"><section class="panel"><div class="panel-head"><div><span class="eyebrow" data-i18n="dashboard.today">TODAY</span><h2 data-i18n="dashboard.todaySchedule">Today’s schedule</h2></div><a href="/schedule?view=day" data-i18n="dashboard.viewDay">View day</a></div>@if (!Model.TodayBookings.Any()) { <div class="empty-state"><strong data-i18n="dashboard.noBookings">No bookings today</strong><span data-i18n="dashboard.clearSchedule">Your schedule is clear. Book a room when you are ready.</span><a class="button ghost" href="/bookings/new" data-i18n="dashboard.createBooking">Create booking</a></div> } else { <div class="booking-list">@foreach (var b in Model.TodayBookings) { var start = Local(b.StartAtUtc); var end = Local(b.EndAtUtc); <a class="booking-row" href="/bookings/@b.Id"><span class="time">@start.ToString("H:mm")–@end.ToString("H:mm")</span><span><b>@b.Title</b><small>@b.AttendeeCount <span data-i18n="dashboard.attendees">attendees</span></small></span><span class="status @b.Status.ToString().ToLowerInvariant()">@b.Status</span></a> }</div> }</section><section class="panel"><div class="panel-head"><div><span class="eyebrow" data-i18n="dashboard.rooms">ROOMS</span><h2 data-i18n="dashboard.roomAvailability">Room availability</h2></div><a href="/schedule" data-i18n="dashboard.schedule">Schedule</a></div><div class="room-list">@foreach (var room in Model.Rooms.Take(8)) { <div class="room-row"><span class="room-icon">▦</span><span><b>@room.Name</b><small>@room.Building · @room.Floor · @room.Capacity seats</small></span><span class="status confirmed" data-i18n="dashboard.available">Available</span></div>}</div></section></div>
