@model RoomReservation.Domain.Entities.OrganizationSettings
@using RoomReservation.Domain.Entities
@{ ViewData["Title"] = "Settings"; var organization = ViewBag.Organization as Organization; var tz = organization?.DefaultTimezone ?? "Asia/Vientiane"; }

<section class="page-head settings-page-head"><div><span class="eyebrow" data-settings-i18n="eyebrow">WORKSPACE</span><h1 data-settings-i18n="title">Organization settings</h1><p data-settings-i18n="subtitle">Configure your organization, booking policy and check-in rules.</p></div><div class="settings-status" id="settingsStatus" role="status" hidden></div></section>
<form id="organizationSettingsForm" class="settings-layout" novalidate>
 <section class="panel settings-card profile-card"><div class="settings-card-heading"><div><span class="settings-icon">⌂</span><div><h2 data-settings-i18n="profileTitle">Organization profile</h2><p data-settings-i18n="profileHint">Basic information shown across this workspace.</p></div></div></div><div class="settings-grid"><label><span data-settings-i18n="organizationName">Organization name</span><input id="organizationName" value="@organization?.Name" required /></label><label><span data-settings-i18n="timezone">Timezone</span><select id="organizationTimezone"><option value="Asia/Vientiane" selected="@(tz == "Asia/Vientiane" ? "selected" : null)">Asia/Vientiane (UTC+7)</option><option value="Asia/Bangkok" selected="@(tz == "Asia/Bangkok" ? "selected" : null)">Asia/Bangkok (UTC+7)</option><option value="UTC" selected="@(tz == "UTC" ? "selected" : null)">UTC</option></select></label></div></section>
 <section class="panel settings-card booking-card"><div class="settings-card-heading"><div><span class="settings-icon">◷</span><div><h2 data-settings-i18n="bookingTitle">Booking policy</h2><p data-settings-i18n="bookingHint">Control when and how members can reserve rooms.</p></div></div></div><div class="settings-grid"><label><span data-settings-i18n="businessStart">Business start</span><input id="businessStart" type="time" value="@Model.BusinessStartTime" /></label><label><span data-settings-i18n="businessEnd">Business end</span><input id="businessEnd" type="time" value="@Model.BusinessEndTime" /></label><label><span data-settings-i18n="advanceDays">Advance booking days</span><input id="advanceDays" type="number" min="0" max="365" value="@Model.AdvanceBookingDays" /><small data-settings-i18n="advanceHint">0 means same-day bookings only.</small></label><label class="check-row settings-toggle"><input id="requireApproval" type="checkbox" checked="@(Model.RequireApproval ? "checked" : null)" /><span><b data-settings-i18n="requireApproval">Require approval</b><small data-settings-i18n="requireApprovalHint">Bookings need an admin decision before confirmation.</small></span></label></div></section>
 <section class="panel settings-card checkin-card"><div class="settings-card-heading"><div><span class="settings-icon">✓</span><div><h2 data-settings-i18n="checkinTitle">Check-in policy</h2><p data-settings-i18n="checkinHint">Allow check-in before the meeting and release no-show rooms automatically.</p></div></div></div><div class="settings-grid"><label><span data-settings-i18n="noShowTimeout">Check-in window before/after start (minutes)</span><input id="noShowTimeout" type="number" min="1" max="240" value="@Model.NoShowTimeoutMinutes" /><small data-settings-i18n="checkinWindowHint">10 minutes means check-in from 10 minutes before until 10 minutes after the start.</small></label><div class="settings-note" role="note"><b data-settings-i18n="staticQrTitle">Static room QR</b><small data-settings-i18n="staticQrHint">Each room has one QR code. It stays valid, but only the confirmed booking owner can check in during the check-in window.</small></div><label class="check-row settings-toggle"><input id="allowSelfSignup" type="checkbox" checked="@(Model.AllowSelfSignup ? "checked" : null)" /><span><b data-settings-i18n="selfSignup">Allow self-signup</b><small data-settings-i18n="selfSignupHint">Let people request access to this workspace.</small></span></label></div></section>
 <div class="settings-actions"><button class="button ghost" id="resetSettings" type="button" data-settings-i18n="reset">Reset</button><button class="button primary" id="saveSettings" type="submit" data-settings-i18n="save">Save settings</button></div>
</form>
@if (ViewBag.CanManageOrganizations == true)
{
 <section class="panel organization-management" id="organizationManagement">
  <div class="settings-card-heading"><div><span class="settings-icon">⌘</span><div><h2 data-settings-i18n="organizationManagement">Organization management</h2><p data-settings-i18n="organizationManagementHint">Create and manage workspaces for your company.</p></div></div></div>
  <div class="organization-create-form"><label><span data-settings-i18n="newOrganizationName">New organization name</span><input id="newOrganizationName" required /></label><label><span data-settings-i18n="newOrganizationTimezone">Timezone</span><select id="newOrganizationTimezone"><option value="Asia/Vientiane">Asia/Vientiane (UTC+7)</option><option value="Asia/Bangkok">Asia/Bangkok (UTC+7)</option><option value="UTC">UTC</option></select></label><button class="button primary" id="createOrganization" type="button" data-settings-i18n="createOrganization">Create organization</button></div>
  <div class="organization-list" id="organizationList">
   @foreach (var item in (ViewBag.Organizations as IEnumerable<Organization> ?? Array.Empty<Organization>()))
   {
    <div class="organization-row" data-organization-id="@item.Id"><div class="organization-row-main"><strong>@item.Name</strong><span>@item.DefaultTimezone</span></div><button class="button ghost organization-edit" type="button" data-settings-i18n="editOrganization">Edit</button></div>
   }
  </div>
 </section>
}
<script>
