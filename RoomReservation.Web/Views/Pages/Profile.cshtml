@model RoomReservation.Domain.Entities.User
@{ ViewData["Title"] = "Profile"; }
<section class="page-head profile-page-head"><div><span class="eyebrow" data-profile-i18n="eyebrow">ACCOUNT</span><h1 data-profile-i18n="title">Profile</h1><p data-profile-i18n="subtitle">Manage your personal account details.</p></div><div class="profile-status" id="profileStatus" role="status" hidden></div></section>
<form id="profileForm" class="panel profile-card-page" novalidate><div class="profile-identity"><span class="profile-avatar">@Model.DisplayName.FirstOrDefault('U')</span><div><h2>@Model.DisplayName</h2><p>@Model.Email</p><span class="profile-role">@Model.Role</span></div></div><div class="profile-form-grid"><label><span data-profile-i18n="displayName">Display name</span><input id="profileDisplayName" value="@Model.DisplayName" autocomplete="name" required /></label><label><span data-profile-i18n="email">Email</span><input value="@Model.Email" type="email" readonly /></label><label><span data-profile-i18n="newPassword">New password</span><input id="profileNewPassword" type="password" autocomplete="new-password" /><small data-profile-i18n="passwordHint">Leave blank to keep your current password.</small></label><label><span data-profile-i18n="confirmPassword">Confirm password</span><input id="profileConfirmPassword" type="password" autocomplete="new-password" /></label></div><div class="profile-actions"><button class="button primary" type="submit" data-profile-i18n="save">Save profile</button></div></form>
@section Scripts {<script>
(()=>{const w={en:{eyebrow:'ACCOUNT',title:'Profile',subtitle:'Manage your personal account details.',displayName:'Display name',email:'Email',newPassword:'New password',confirmPassword:'Confirm password',passwordHint:'Leave blank to keep your current password.',save:'Save profile',saved:'Profile saved successfully.',error:'Could not save profile.',passwordMismatch:'Passwords do not match.'},th:{eyebrow:'บัญชีผู้ใช้',title:'โปรไฟล์',subtitle:'จัดการข้อมูลบัญชีส่วนตัวของคุณ',displayName:'ชื่อที่แสดง',email:'อีเมล',newPassword:'รหัสผ่านใหม่',confirmPassword:'ยืนยันรหัสผ่าน',passwordHint:'เว้นว่างไว้หากไม่ต้องการเปลี่ยนรหัสผ่าน',save:'บันทึกโปรไฟล์',saved:'บันทึกโปรไฟล์แล้ว',error:'ไม่สามารถบันทึกโปรไฟล์ได้',passwordMismatch:'รหัสผ่านไม่ตรงกัน'},lo:{eyebrow:'ບັນຊີຜູ້ໃຊ້',title:'ໂປຣໄຟລ໌',subtitle:'ຈັດການຂໍ້ມູນບັນຊີສ່ວນຕົວ',displayName:'ຊື່ສະແດງ',email:'ອີເມວ',newPassword:'ລະຫັດຜ່ານໃໝ່',confirmPassword:'ຢືນຢັນລະຫັດຜ່ານ',passwordHint:'ປະໄວ້ວ່າງເປົ່າ ຖ້າບໍ່ຕ້ອງການປ່ຽນລະຫັດຜ່ານ',save:'ບັນທຶກໂປຣໄຟລ໌',saved:'ບັນທຶກໂປຣໄຟລ໌ແລ້ວ',error:'ບໍ່ສາມາດບັນທຶກໂປຣໄຟລ໌ໄດ້',passwordMismatch:'ລະຫັດຜ່ານບໍ່ກົງກັນ'}};const f=document.getElementById('profileForm'),s=document.getElementById('profileStatus'),lang=()=>localStorage.getItem('roombooking-language')||'th',apply=()=>{const t=w[lang()]||w.en;document.querySelectorAll('[data-profile-i18n]').forEach(e=>e.textContent=t[e.dataset.profileI18n]||e.textContent);document.documentElement.lang=lang()};apply();document.getElementById('languageSelect')?.addEventListener('change',()=>setTimeout(apply,60));const show=(m,ok)=>{s.textContent=m;s.className='profile-status '+(ok?'success':'error');s.hidden=false;setTimeout(()=>s.hidden=true,3500)};f.onsubmit=async e=>{e.preventDefault();const t=w[lang()]||w.en,n=document.getElementById('profileDisplayName').value.trim(),p=document.getElementById('profileNewPassword').value,c=document.getElementById('profileConfirmPassword').value;if(p&&p!==c)return show(t.passwordMismatch,false);try{const r=await fetch('/api/v1/account/profile',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({displayName:n,newPassword:p||null,confirmPassword:c||null})});if(!r.ok)throw 0;show(t.saved,true);setTimeout(()=>location.reload(),700)}catch{show(t.error,false)}}})();
</script>}
