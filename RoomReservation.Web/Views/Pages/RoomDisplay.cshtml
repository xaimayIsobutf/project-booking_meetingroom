@model RoomReservation.Web.Models.RoomDisplayPageModel
@{ ViewData["Title"] = "Room Display"; }

<section class="page-head room-display-head"><div><span class="eyebrow">ROOM DISPLAY</span><h1>Room Display</h1><p id="displaySubtitle">Pair this screen with one meeting room to start.</p></div></section>
<main class="room-display-shell" id="roomDisplayApp" data-device-id="@(Model.PairDeviceId?.ToString() ?? "")" data-organization-id="@(Model.PairOrganizationId?.ToString() ?? "")">
    <section class="room-display-pair panel" id="pairPanel"><span class="eyebrow">PAIR DEVICE</span><h2>Pair Room Display</h2><p>Enter the one-time code generated by an administrator.</p><label>Pairing code<input id="pairingCode" inputmode="text" autocomplete="one-time-code" maxlength="16" placeholder="8-character code" /></label><button class="button primary" id="completePair" type="button">Pair this display</button><p class="room-display-message error" id="pairMessage" hidden></p></section>
    <section id="displayPanel" hidden><div class="room-display-identity"><div class="room-display-icon">▦</div><div><h2 id="roomName">—</h2><p id="roomMeta">—</p></div><span class="room-display-live">LIVE</span></div><div class="room-display-status available" id="roomStatus"><span class="room-display-dot"></span><strong id="statusText">AVAILABLE</strong></div><div class="room-display-main"><div class="room-display-current"><span class="room-display-label">NOW</span><h3 id="currentTitle">Room is available</h3><p id="currentTime"></p><small id="currentAttendees"></small></div><div class="room-display-next"><span class="room-display-label">NEXT BOOKING</span><strong id="nextTitle">—</strong><p id="nextTime"></p></div></div><section class="room-display-qr"><div><span class="room-display-label">CHECK-IN QR</span><h3>Scan to check in</h3><p id="qrExpiry">—</p></div><img id="qrImage" class="room-display-qr-image" alt="Check-in QR code" /><code id="qrToken" hidden>—</code></section><div class="room-display-footer"><span id="lastUpdated">—</span><button class="button ghost" id="refreshDisplay" type="button">Refresh</button></div></section>
    <p class="room-display-message error" id="displayMessage" hidden></p>
</main>
@section Scripts {
<script>
(() => { const app=document.getElementById('roomDisplayApp'),pair=document.getElementById('pairPanel'),display=document.getElementById('displayPanel'),deviceId=app.dataset.deviceId,organizationId=app.dataset.organizationId,pairCode=document.getElementById('pairingCode'); const message=(id,text,ok=false)=>{const e=document.getElementById(id);e.hidden=!text;e.textContent=text;e.className='room-display-message '+(ok?'success':'error')}; const time=v=>v?new Date(v).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',hour12:false}):''; const load=async()=>{try{const r=await fetch('/api/v1/room-display/me',{credentials:'same-origin'});if(!r.ok)throw 0;const x=await r.json();pair.hidden=true;display.hidden=false;document.getElementById('roomName').textContent=x.room.name;document.getElementById('roomMeta').textContent=`${x.room.building} · ${x.room.floor} · ${x.room.capacity} seats`;const current=x.current,next=x.next;document.getElementById('statusText').textContent=current?'OCCUPIED':'AVAILABLE';document.getElementById('roomStatus').className='room-display-status '+(current?'occupied':'available');document.getElementById('currentTitle').textContent=current?.title||'Room is available';document.getElementById('currentTime').textContent=current?`${time(current.startAtUtc)} – ${time(current.endAtUtc)}`:'';document.getElementById('currentAttendees').textContent=current?`${current.attendeeCount} attendees`:'';document.getElementById('nextTitle').textContent=next?.title||'—';document.getElementById('nextTime').textContent=next?`${time(next.startAtUtc)} – ${time(next.endAtUtc)}`:'';document.getElementById('qrImage').src=`/api/v1/room-display/me/qr.png?v=${Date.now()}`;document.getElementById('qrExpiry').textContent='Static QR for this room';document.getElementById('lastUpdated').textContent=`Last updated ${new Date().toLocaleTimeString()}`;message('displayMessage','')}catch{pair.hidden=false;display.hidden=true;message('displayMessage','This display is not paired or has been revoked.')}}; document.getElementById('completePair').onclick=async()=>{const code=pairCode.value.trim().toUpperCase();if(!deviceId||!organizationId)return message('pairMessage','Open the pairing link generated by an administrator.');if(!code)return message('pairMessage','Enter the pairing code.');const r=await fetch('/api/v1/room-display/pair/complete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deviceId,organizationId,pairingCode:code})});if(!r.ok)return message('pairMessage',await r.text()||'Pairing failed.');message('pairMessage','Paired successfully.',true);await load()};document.getElementById('refreshDisplay').onclick=load;load();setInterval(load,15000) })();
</script>
<script>
// Pairing is intentionally code-only. The legacy handler above is retained for
// old bookmarked pages, but this handler prevents device/organization IDs from
// being required by the current Room Display page.
(() => {
  const button = document.getElementById('completePair');
  const codeInput = document.getElementById('pairingCode');
  if (!button || !codeInput) return;
  button.onclick = async () => {
    const code = codeInput.value.trim().toUpperCase();
    const message = document.getElementById('pairMessage');
    if (!code) {
      message.hidden = false;
      message.textContent = 'Enter the pairing code.';
      return;
    }
    const response = await fetch('/api/v1/room-display/pair/complete-by-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pairingCode: code }),
    });
    if (!response.ok) {
      message.hidden = false;
      message.textContent = await response.text() || 'Pairing failed.';
      return;
    }
    message.hidden = true;
    location.reload();
  };
})();
</script>
}
