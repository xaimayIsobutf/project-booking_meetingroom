@using RoomReservation.Domain.Enums
@model RoomReservation.Domain.Entities.Booking
@{ ViewData["Title"] = "Booking details"; var room = ViewBag.Room as RoomReservation.Domain.Entities.Room; var requester = ViewBag.Requester as RoomReservation.Domain.Entities.User; var logs = ViewBag.AuditLogs as List<RoomReservation.Domain.Entities.AuditLog> ?? []; var zone = TimeZoneInfo.FindSystemTimeZoneById((string)(ViewBag.TimeZoneId ?? "UTC")); Func<DateTime, DateTime> local = value => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), zone); var canManage = User.IsInRole("OrgAdmin") || User.IsInRole("SuperAdmin"); var canCancel = (Model.Status == BookingStatus.Pending || Model.Status == BookingStatus.Confirmed) && (canManage || Model.UserId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value); }
<section class="page-head booking-detail-head"><div><span class="eyebrow" data-booking-i18n="eyebrow">RESERVATION DETAIL</span><h1>@Model.Title</h1><p>@(room?.Name ?? "Meeting room") · @local(Model.StartAtUtc).ToString("dd MMM yyyy, HH:mm") – @local(Model.EndAtUtc).ToString("HH:mm")</p></div><span class="status large @Model.Status.ToString().ToLowerInvariant()" data-booking-status="@Model.Status">@Model.Status</span></section>
<div class="booking-detail-actions"><a class="button ghost" href="/bookings" data-booking-i18n="back">Back to reservations</a><a class="button ghost" href="/schedule?date=@local(Model.StartAtUtc).ToString("yyyy-MM-dd")" data-booking-i18n="calendar">View calendar</a>@if (Model.Status == BookingStatus.Pending && canManage) { <button class="button primary" type="button" id="detailApprove" data-booking-i18n="approve">Approve</button><button class="button danger" type="button" id="detailReject" data-booking-i18n="reject">Reject</button> }@if (Model.Status == BookingStatus.Confirmed) { <a class="button primary" href="/check-in" data-booking-i18n="checkIn">Check in</a> }@if (Model.Status == BookingStatus.CheckedIn && (canManage || Model.UserId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)) { <button class="button primary" type="button" id="detailCheckout" data-booking-i18n="checkOut">Check out</button> }@if (canCancel) { <form method="post" action="/bookings/@Model.Id/cancel" onsubmit="return confirm('Cancel this booking?')"><button class="button danger" type="submit" data-booking-i18n="cancel">Cancel booking</button></form> }</div>
<div class="booking-detail-grid"><section class="panel booking-summary-panel"><h2 data-booking-i18n="meeting">Meeting details</h2><dl class="detail-list"><dt data-booking-i18n="room">Room</dt><dd>@(room?.Name ?? "-")</dd><dt data-booking-i18n="location">Location</dt><dd>@(room?.Building ?? "-") · @(room?.Floor ?? "-")</dd><dt data-booking-i18n="capacity">Capacity</dt><dd>@(room?.Capacity.ToString() ?? "-")</dd><dt data-booking-i18n="equipment">Equipment</dt><dd>@(room?.EquipmentTags?.Any() == true ? string.Join(", ", room.EquipmentTags) : "-")</dd><dt data-booking-i18n="requester">Requester</dt><dd>@(string.IsNullOrWhiteSpace(requester?.DisplayName) ? requester?.Email ?? "-" : requester.DisplayName)</dd><dt data-booking-i18n="attendees">Attendees</dt><dd>@Model.AttendeeCount</dd><dt data-booking-i18n="start">Start</dt><dd>@local(Model.StartAtUtc).ToString("dd/MM/yyyy HH:mm")</dd><dt data-booking-i18n="end">End</dt><dd>@local(Model.EndAtUtc).ToString("dd/MM/yyyy HH:mm")</dd><dt data-booking-i18n="duration">Duration</dt><dd>@(Model.EndAtUtc - Model.StartAtUtc)</dd><dt data-booking-i18n="notes">Notes</dt><dd>@(Model.Notes ?? "—")</dd></dl></section><section class="panel booking-timeline-panel"><h2 data-booking-i18n="timeline">Activity timeline</h2><div class="booking-timeline"><div class="timeline-item"><span class="timeline-dot"></span><div><b data-booking-i18n="created">Booking created</b><small>@local(Model.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small></div></div>@foreach (var log in logs) { <div class="timeline-item"><span class="timeline-dot"></span><div><b>@log.Action</b><small>@local(log.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small>@if (!string.IsNullOrWhiteSpace(log.Metadata)) { <code>@log.Metadata</code> }</div></div> }@if (!logs.Any() && Model.Status == BookingStatus.Pending) { <p class="muted-copy" data-booking-i18n="waiting">Waiting for an approval decision.</p> }</div></section></div>
@section Scripts { <script>
(() => { const lang=localStorage.getItem('roombooking-language')||'en',d={en:{eyebrow:'RESERVATION DETAIL',back:'Back to reservations',calendar:'View calendar',approve:'Approve',reject:'Reject',checkIn:'Check in',cancel:'Cancel booking',meeting:'Meeting details',room:'Room',location:'Location',capacity:'Capacity',equipment:'Equipment',requester:'Requester',attendees:'Attendees',start:'Start',end:'End',duration:'Duration',notes:'Notes',timeline:'Activity timeline',created:'Booking created',waiting:'Waiting for an approval decision.'},th:{eyebrow:'รายละเอียดการจอง',back:'กลับรายการจอง',calendar:'ดูปฏิทิน',approve:'อนุมัติ',reject:'ปฏิเสธ',checkIn:'เช็กอิน',cancel:'ยกเลิกการจอง',meeting:'รายละเอียดการประชุม',room:'ห้อง',location:'สถานที่',capacity:'ความจุ',equipment:'อุปกรณ์',requester:'ผู้จอง',attendees:'ผู้เข้าร่วม',start:'เริ่ม',end:'สิ้นสุด',duration:'ระยะเวลา',notes:'หมายเหตุ',timeline:'ลำดับกิจกรรม',created:'สร้างการจอง',waiting:'รอการอนุมัติ'},lo:{eyebrow:'ລາຍລະອຽດການຈອງ',back:'ກັບລາຍການຈອງ',calendar:'ເບິ່ງປະຕິທິນ',approve:'ອະນຸມັດ',reject:'ປະຕິເສດ',checkIn:'ເຊັກອິນ',cancel:'ຍົກເລີກການຈອງ',meeting:'ລາຍລະອຽດການປະຊຸມ',room:'ຫ້ອງ',location:'ສະຖານທີ່',capacity:'ຄວາມຈຸ',equipment:'ອຸປະກອນ',requester:'ຜູ້ຈອງ',attendees:'ຜູ້ເຂົ້າຮ່ວມ',start:'ເລີ່ມ',end:'ສິ້ນສຸດ',duration:'ໄລຍະເວລາ',notes:'ໝາຍເຫດ',timeline:'ລຳດັບກິດຈະກຳ',created:'ສ້າງການຈອງ',waiting:'ລໍຖ້າການອະນຸມັດ'}}[lang]||{};document.querySelectorAll('[data-booking-i18n]').forEach(e=>{if(d[e.dataset.bookingI18n])e.textContent=d[e.dataset.bookingI18n]});const id='@Model.Id';const act=async(kind)=>{const reason=kind==='reject'?prompt(lang==='th'?'เหตุผลที่ปฏิเสธ':lang==='lo'?'ເຫດຜົນທີ່ປະຕິເສດ':'Reason for rejection'):null;if(kind==='reject'&&!reason?.trim())return;const r=await fetch('/api/v1/approvals/'+id+'/'+kind,{method:'POST',headers:{'Content-Type':'application/json'},body:kind==='reject'?JSON.stringify({reason}):undefined});if(r.ok)location.reload();else alert(await r.text())};document.getElementById('detailApprove')?.addEventListener('click',()=>act('approve'));document.getElementById('detailReject')?.addEventListener('click',()=>act('reject'))})();
</script> }
<script>
(() => {
 const lang=localStorage.getItem('roombooking-language')||'en';
 const t={en:{title:'Booking details',cancel:'Cancel this booking?',status:{Pending:'Pending',Confirmed:'Confirmed',CheckedIn:'Checked in',Completed:'Completed',Cancelled:'Cancelled',NoShow:'No-show'}},th:{title:'รายละเอียดการจอง',cancel:'ต้องการยกเลิกการจองนี้หรือไม่?',status:{Pending:'รออนุมัติ',Confirmed:'ยืนยันแล้ว',CheckedIn:'เช็กอินแล้ว',Completed:'เสร็จสิ้น',Cancelled:'ยกเลิกแล้ว',NoShow:'ไม่มาใช้งาน'}},lo:{title:'ລາຍລະອຽດການຈອງ',cancel:'ຕ້ອງການຍົກເລີກການຈອງນີ້ບໍ?',status:{Pending:'ລໍຖ້າອະນຸມັດ',Confirmed:'ຢືນຢັນແລ້ວ',CheckedIn:'ເຊັກອິນແລ້ວ',Completed:'ສຳເລັດ',Cancelled:'ຍົກເລີກ',NoShow:'ບໍ່ມາໃຊ້'}}}[lang]||{};
 document.querySelectorAll('[data-booking-status]').forEach(e=>e.textContent=t.status[e.dataset.bookingStatus]||e.dataset.bookingStatus);
 document.querySelectorAll('.booking-detail-actions form').forEach(f=>f.onsubmit=()=>confirm(t.cancel));
 const title=document.querySelector('.topbar-left h2');if(title&&title.textContent.trim()==='Booking details')title.textContent=t.title;
})();
</script>
<script>
(() => {
 const button=document.getElementById('detailCheckout');
 if(!button)return;
 const lang=localStorage.getItem('roombooking-language')||'en';
 const labels={en:'Check out',th:'เช็กเอาต์',lo:'ເຊັກເອົາ'};
 button.textContent=labels[lang]||labels.en;
 const id='@Model.Id';
 button.addEventListener('click',async()=>{
  button.disabled=true;
  const r=await fetch('/api/v1/checkin/'+id+'/checkout',{method:'POST'});
  if(r.ok){location.reload();return;}
  button.disabled=false;
  alert(await r.text());
 });
})();
</script>
<script>
(() => {
 const translations={th:'รายละเอียดการจอง',lo:'ລາຍລະອຽດການຈອງ',en:'RESERVATION DETAIL'};
 const apply=()=>{const code=localStorage.getItem('roombooking-language')||'th';document.querySelector('.booking-detail-head .eyebrow')?.replaceChildren(document.createTextNode(translations[code]||translations.en));document.documentElement.lang=code==='lo'?'lo':code;};
 apply();document.getElementById('languageSelect')?.addEventListener('change',()=>setTimeout(apply,50));
})();
</script>
