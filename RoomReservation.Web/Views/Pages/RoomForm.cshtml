@model RoomReservation.Domain.Entities.Room
@{ ViewData["Title"] = Model.Id == Guid.Empty ? "Add room" : "Edit room"; var action = Model.Id == Guid.Empty ? "/admin/rooms/create" : $"/admin/rooms/{Model.Id}/edit"; var equipment = ViewBag.Equipment as IEnumerable<RoomReservation.Domain.Entities.EquipmentItem> ?? []; }
<section class="page-head"><div><span class="eyebrow">ROOM MANAGEMENT</span><h1>@ViewData["Title"]</h1><p>Keep room information clear and up to date.</p></div></section>
<form method="post" action="@action" class="panel form-panel room-form-enhanced">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Room name<input asp-for="Name" required /></label><label>Capacity<input asp-for="Capacity" type="number" min="1" required /></label><label>Building<input asp-for="Building" /></label><label>Floor<input asp-for="Floor" /></label></div><label>Facilities / equipment<div class="equipment-picker" id="equipmentPicker"><div class="equipment-picker-row"><select id="equipmentSelect"><option value="">Select equipment</option>@foreach (var item in equipment) { <option value="@item.Name">@item.Name</option> }</select><button class="button ghost" type="button" id="addEquipment">Add equipment</button></div><div class="equipment-chips" id="equipmentChips"></div>@foreach (var tag in Model.EquipmentTags) { <input type="hidden" name="EquipmentTags" value="@tag" data-equipment="true" /> }</div></label><label class="check-row"><input asp-for="RequiresApproval" /> Require approval</label><label class="check-row"><input asp-for="IsActive" /> Active</label><p class="muted-copy">หากต้องการให้บริษัทอื่นใช้ห้องนี้ ให้ตั้งค่าที่ <b>Share room</b> หลังบันทึกห้อง</p><div class="form-actions"><a class="button ghost" href="/admin/rooms">Cancel</a><button class="button primary" type="submit">Save room</button></div></form>
@section Scripts { <script>
(()=>{const lang=localStorage.getItem('roombooking-language')||'en',text={en:['Select equipment','Add equipment'],th:['เลือกอุปกรณ์','เพิ่มอุปกรณ์'],lo:['ເລືອກອຸປະກອນ','ເພີ່ມອຸປະກອນ']}[lang]||['Select equipment','Add equipment'];const select=document.getElementById('equipmentSelect'),button=document.getElementById('addEquipment'),chips=document.getElementById('equipmentChips'),form=document.querySelector('.room-form-enhanced');select.options[0].textContent=text[0];button.textContent=text[1];const render=()=>{chips.innerHTML='';form.querySelectorAll('input[data-equipment]').forEach(x=>{const chip=document.createElement('span');chip.className='chip equipment-chip';chip.textContent=x.value;const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.onclick=()=>{x.remove();render()};chip.append(remove);chips.append(chip)})};button.onclick=()=>{if(select.value&&!Array.from(form.querySelectorAll('input[data-equipment]')).some(x=>x.value===select.value)){const input=document.createElement('input');input.type='hidden';input.name='EquipmentTags';input.value=select.value;input.dataset.equipment='true';form.append(input);render();select.value=''}};render()})();
</script> }
