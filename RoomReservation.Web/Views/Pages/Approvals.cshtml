@using RoomReservation.Domain.Enums
@model RoomReservation.Web.Models.ApprovalPageModel
@{ ViewData["Title"] = "Approvals"; var zone = TimeZoneInfo.Local; }
<section class="page-head approvals-head"><div><span class="eyebrow" data-approval-i18n="eyebrow">WORKFLOW</span><h1 data-approval-i18n="title">Approvals</h1><p data-approval-i18n="subtitle">Review and process room reservation requests.</p></div><span class="status pending"><b id="approvalPendingCount">@Model.Bookings.Count</b> <span data-approval-i18n="pending">Pending</span></span></section>
<div class="approval-tabs" role="tablist"><button class="button primary selected" type="button" data-approval-tab="pending" data-approval-i18n="pendingTab">Pending</button><button class="button ghost" type="button" data-approval-tab="processed" data-approval-i18n="processedTab">Processed</button></div>
<section class="panel approval-filters"><label><span data-approval-i18n="search">Search</span><input id="approvalSearch" type="search" placeholder="Meeting, room or requester..." data-approval-placeholder="searchPlaceholder" /></label><label><span data-approval-i18n="room">Room</span><select id="approvalRoom"><option value="" data-approval-i18n="allRooms">All rooms</option>@foreach (var room in Model.Rooms) { <option value="@room.Id">@room.Name</option> }</select></label><label><span data-approval-i18n="building">Building</span><select id="approvalBuilding"><option value="" data-approval-i18n="allBuildings">All buildings</option>@foreach (var building in Model.Rooms.Select(x => x.Building).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@building">@building</option> }</select></label><label><span data-approval-i18n="date">Date</span><input id="approvalDate" type="date" /></label><button class="button ghost" type="button" id="approvalReset" data-approval-i18n="reset">Reset</button></section>
<section class="panel approval-list-panel"><div class="panel-head"><div><h2 data-approval-i18n="requests">Reservation requests</h2><p class="muted-copy"><span data-approval-i18n="showing">Showing</span> <b id="approvalVisibleCount">@Model.Bookings.Count</b> <span data-approval-i18n="requestsCount">requests</span></p></div><button class="button ghost" type="button" id="approvalBulkApprove" disabled data-approval-i18n="approveSelected">Approve selected</button></div><div class="approval-list">@if (!Model.Bookings.Any()) { <div class="empty-state" data-approval-i18n="empty">No pending approval requests.</div> } @foreach (var booking in Model.Bookings) { var room = Model.Rooms.FirstOrDefault(x => x.Id == booking.RoomId); var user = Model.Users.FirstOrDefault(x => x.Id == booking.UserId); var start = TimeZoneInfo.ConvertTimeFromUtc(booking.StartAtUtc, zone); var end = TimeZoneInfo.ConvertTimeFromUtc(booking.EndAtUtc, zone); <article class="approval-card" data-approval-row data-booking-id="@booking.Id" data-room-id="@booking.RoomId" data-building="@(room?.Building ?? "")" data-date="@start.ToString("yyyy-MM-dd")" data-search="@(booking.Title + " " + (room?.Name ?? "") + " " + (user?.DisplayName ?? "") + " " + (user?.Email ?? ""))"><label class="approval-select"><input type="checkbox" data-approval-check /></label><div class="approval-main"><div class="approval-title"><h3>@booking.Title</h3><span class="status pending" data-approval-i18n="pending">Pending</span></div><div class="approval-facts"><span><b data-approval-i18n="requester">Requester</b> @(string.IsNullOrWhiteSpace(user?.DisplayName) ? user?.Email ?? "-" : user.DisplayName)</span><span><b data-approval-i18n="room">Room</b> @(room?.Name ?? "-")</span><span><b data-approval-i18n="when">When</b> @start.ToString("dd/MM/yyyy HH:mm") – @end.ToString("HH:mm")</span><span><b data-approval-i18n="attendees">Attendees</b> @booking.AttendeeCount</span></div>@if (!string.IsNullOrWhiteSpace(booking.Notes)) { <p class="approval-notes"><b data-approval-i18n="notes">Notes</b> @booking.Notes</p> }<p class="approval-feedback" data-approval-feedback></p></div><div class="approval-actions"><a class="button ghost" href="/bookings/@booking.Id" data-approval-i18n="viewDetails">View details</a><button class="button primary" type="button" data-approval-action="approve" data-approval-i18n="approve">Approve</button><button class="button danger" type="button" data-approval-action="reject" data-approval-i18n="reject">Reject</button></div></article> }</div></section>
@section Scripts { <script>
(() => {
 const lang=localStorage.getItem('roombooking-language')||'en',d={en:{eyebrow:'WORKFLOW',title:'Approvals',subtitle:'Review and process room reservation requests.',pending:'Pending',pendingTab:'Pending',processedTab:'Processed',search:'Search',searchPlaceholder:'Meeting, room or requester...',room:'Room',allRooms:'All rooms',building:'Building',allBuildings:'All buildings',date:'Date',reset:'Reset',requests:'Reservation requests',showing:'Showing',requestsCount:'requests',approveSelected:'Approve selected',empty:'No pending approval requests.',requester:'Requester',when:'When',attendees:'Attendees',notes:'Notes',viewDetails:'View details',approve:'Approve',reject:'Reject',rejectReason:'Reason for rejection',reasonRequired:'Please enter a reason.',conflict:'Room is no longer available for this time.'},th:{eyebrow:'ขั้นตอนอนุมัติ',title:'อนุมัติการจอง',subtitle:'ตรวจสอบและจัดการคำขอจองห้องประชุม',pending:'รออนุมัติ',pendingTab:'รออนุมัติ',processedTab:'ดำเนินการแล้ว',search:'ค้นหา',searchPlaceholder:'หัวข้อ ห้อง หรือผู้จอง...',room:'ห้อง',allRooms:'ทุกห้อง',building:'อาคาร',allBuildings:'ทุกอาคาร',date:'วันที่',reset:'รีเซ็ต',requests:'คำขอจองห้อง',showing:'แสดง',requestsCount:'รายการ',approveSelected:'อนุมัติที่เลือก',empty:'ไม่มีคำขอรออนุมัติ',requester:'ผู้จอง',when:'วันเวลา',attendees:'ผู้เข้าร่วม',notes:'หมายเหตุ',viewDetails:'ดูรายละเอียด',approve:'อนุมัติ',reject:'ปฏิเสธ',rejectReason:'เหตุผลที่ปฏิเสธ',reasonRequired:'กรุณาระบุเหตุผล',conflict:'ห้องไม่ว่างในช่วงเวลานี้'},lo:{eyebrow:'ຂັ້ນຕອນອະນຸມັດ',title:'ອະນຸມັດການຈອງ',subtitle:'ກວດສອບ ແລະ ຈັດການຄຳຂໍຈອງຫ້ອງ',pending:'ລໍຖ້າອະນຸມັດ',pendingTab:'ລໍຖ້າອະນຸມັດ',processedTab:'ດຳເນີນການແລ້ວ',search:'ຄົ້ນຫາ',searchPlaceholder:'ຫົວຂໍ້ ຫ້ອງ ຫຼື ຜູ້ຈອງ...',room:'ຫ້ອງ',allRooms:'ທຸກຫ້ອງ',building:'ອາຄານ',allBuildings:'ທຸກອາຄານ',date:'ວັນທີ',reset:'ລ້າງ',requests:'ຄຳຂໍຈອງຫ້ອງ',showing:'ສະແດງ',requestsCount:'ລາຍການ',approveSelected:'ອະນຸມັດທີ່ເລືອກ',empty:'ບໍ່ມີຄຳຂໍລໍຖ້າອະນຸມັດ',requester:'ຜູ້ຈອງ',when:'ວັນເວລາ',attendees:'ຜູ້ເຂົ້າຮ່ວມ',notes:'ໝາຍເຫດ',viewDetails:'ເບິ່ງລາຍລະອຽດ',approve:'ອະນຸມັດ',reject:'ປະຕິເສດ',rejectReason:'ເຫດຜົນທີ່ປະຕິເສດ',reasonRequired:'ກະລຸນາໃສ່ເຫດຜົນ',conflict:'ຫ້ອງບໍ່ວ່າງໃນເວລານີ້'}}[lang]||{};document.querySelectorAll('[data-approval-i18n]').forEach(e=>{if(d[e.dataset.approvalI18n])e.textContent=d[e.dataset.approvalI18n]});document.querySelectorAll('[data-approval-placeholder]').forEach(e=>{if(d[e.dataset.approvalPlaceholder])e.placeholder=d[e.dataset.approvalPlaceholder]});
 const rows=[...document.querySelectorAll('[data-approval-row]')],q=document.getElementById('approvalSearch'),room=document.getElementById('approvalRoom'),building=document.getElementById('approvalBuilding'),date=document.getElementById('approvalDate'),count=document.getElementById('approvalVisibleCount'),selected=()=>rows.filter(x=>x.querySelector('[data-approval-check]')?.checked);
 const filter=()=>{const term=(q.value||'').toLowerCase(),n=rows.filter(x=>{const ok=(!term||x.dataset.search.toLowerCase().includes(term))&&(!room.value||x.dataset.roomId===room.value)&&(!building.value||x.dataset.building===building.value)&&(!date.value||x.dataset.date===date.value);x.hidden=!ok;return ok}).length;count.textContent=n;document.getElementById('approvalBulkApprove').disabled=!selected().length};[q,room,building,date].forEach(x=>x.addEventListener('input',filter));[q,room,building,date].forEach(x=>x.addEventListener('change',filter));document.getElementById('approvalReset').onclick=()=>{[q,room,building,date].forEach(x=>x.value='');filter()};document.querySelectorAll('[data-approval-check]').forEach(x=>x.onchange=filter);
 const action=async(button,reason)=>{const card=button.closest('[data-approval-row]'),feedback=card.querySelector('[data-approval-feedback]'),kind=button.dataset.approvalAction;button.disabled=true;const response=await fetch('/api/v1/approvals/'+card.dataset.bookingId+'/'+kind,{method:'POST',headers:{'Content-Type':'application/json'},body:kind==='reject'?JSON.stringify({reason}):undefined});if(response.ok){card.remove();filter();return}const error=await response.text();feedback.textContent=error.includes('no longer available')?d.conflict||error:'Unable to process request';button.disabled=false};document.querySelectorAll('[data-approval-action]').forEach(button=>button.onclick=async()=>{if(button.dataset.approvalAction==='reject'){const reason=prompt(d.rejectReason||'Reason for rejection');if(!reason?.trim()){alert(d.reasonRequired||'Please enter a reason.');return}await action(button,reason)}else await action(button)});
 document.getElementById('approvalBulkApprove').onclick=async()=>{for(const card of selected()){const button=card.querySelector('[data-approval-action="approve"]');if(button)await action(button)}};
})();
</script> }
