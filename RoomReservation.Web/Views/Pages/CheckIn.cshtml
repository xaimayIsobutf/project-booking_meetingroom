@model List<RoomReservation.Domain.Entities.Booking>
@{
    ViewData["Title"] = "Check-in";
    var timeZoneId = (string)(ViewBag.TimeZoneId ?? "UTC");
    TimeZoneInfo zone;
    try { zone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId); }
    catch { zone = TimeZoneInfo.Utc; timeZoneId = zone.Id; }
    DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), zone);
}
<section class="page-head checkin-head"><div><span class="eyebrow" data-ci-i18n="eyebrow">ON SITE</span><h1 data-ci-i18n="title">Check-in</h1><p data-ci-i18n="subtitle">Confirm your arrival at the meeting room.</p></div></section>
<div class="checkin-layout" data-checkin-timezone="@timeZoneId">
    <section class="panel checkin-scan-panel">
        <div class="checkin-section-head"><span>01</span><div><h2 data-ci-i18n="scanTitle">Scan room QR code</h2><p data-ci-i18n="scanHint">Scan the QR code fixed to the room, then verify your reservation.</p></div></div>
        <label class="checkin-token-label"><span data-ci-i18n="token">QR token</span><input id="checkinToken" type="text" autocomplete="off" placeholder="Paste or scan QR token" data-ci-placeholder="tokenPlaceholder" /></label>
        <div class="checkin-actions"><button class="button primary" id="checkinScan" type="button" data-ci-i18n="validate">Check QR and preview</button><button class="button ghost" id="checkinCamera" type="button" data-ci-i18n="camera">Use camera</button><label class="button ghost checkin-image-button" for="checkinImage" data-ci-i18n="photo">Use photo</label><input id="checkinImage" type="file" accept="image/*" capture="environment" hidden /></div>
        <div class="checkin-message" id="checkinMessage" hidden></div>
        <section class="checkin-preview" id="checkinPreview" hidden>
            <span class="eyebrow" data-ci-i18n="previewTitle">CHECK-IN PREVIEW</span>
            <h3 id="previewTitle">—</h3>
            <dl><div><dt data-ci-i18n="room">Room</dt><dd id="previewRoom">—</dd></div><div><dt data-ci-i18n="time">Time</dt><dd id="previewTime">—</dd></div><div><dt data-ci-i18n="attendees">Attendees</dt><dd id="previewAttendees">—</dd></div></dl>
            <div class="checkin-preview-actions"><button class="button primary" id="confirmCheckin" type="button" data-ci-i18n="confirm">Confirm check-in</button><button class="button ghost" id="cancelPreview" type="button" data-ci-i18n="cancel">Cancel</button></div>
        </section>
    </section>
    <section class="panel checkin-list-panel"><div class="checkin-section-head"><span>02</span><div><h2 data-ci-i18n="myBookings">My active reservations</h2><p data-ci-i18n="myBookingsHint">Select the reservation you want to check in.</p></div></div><div class="booking-list">@if (!Model.Any()) { <div class="empty-state" data-ci-i18n="empty">No reservations available for check-in.</div> } @foreach (var b in Model) { var start = Local(b.StartAtUtc); var end = Local(b.EndAtUtc); <div class="booking-row checkin-row"><span class="checkin-booking-main"><b>@b.Title</b><small>@start.ToString("dd MMM, HH:mm") – @end.ToString("HH:mm")</small></span><span class="status @b.Status.ToString().ToLowerInvariant()">@b.Status</span>@if (b.Status == RoomReservation.Domain.Enums.BookingStatus.Confirmed) { <button class="button ghost select-checkin-booking" data-booking-id="@b.Id" type="button" data-ci-i18n="selectBooking">Select</button> } @if (b.Status == RoomReservation.Domain.Enums.BookingStatus.CheckedIn) { <button class="button ghost checkout-button" data-booking-id="@b.Id" type="button" data-ci-i18n="checkout">Check out</button> }</div> } </div></section>
</div>
@section Scripts { <script>
(() => {
    const lang = localStorage.getItem('roombooking-language') || 'en';
    const m = {
        en:{eyebrow:'ON SITE',title:'Check-in',subtitle:'Confirm your arrival at the meeting room.',scanTitle:'Scan room QR code',scanHint:'Select a reservation, then scan the QR code to preview it.',token:'QR token',tokenPlaceholder:'Paste or scan QR token',validate:'Check QR and preview',camera:'Use camera',stopCamera:'Stop camera',photo:'Use photo',myBookings:'My active reservations',myBookingsHint:'Select the reservation you want to check in.',empty:'No reservations available for check-in.',selectBooking:'Select',selected:'Selected',previewTitle:'CHECK-IN PREVIEW',room:'Room',time:'Time',attendees:'Attendees',confirm:'Confirm check-in',cancel:'Cancel',success:'Check-in successful.',checkout:'Check out',checkoutSuccess:'Check-out successful.',invalid:'QR code is invalid, expired, or there is no active reservation.',mismatch:'The QR code does not match the selected reservation.',failed:'Unable to complete check-in. Please try again.',cameraUnsupported:'Camera scanning is not available in this browser. Please use a photo or enter the token.',imageScanFailed:'Could not read a QR code from this image.'},
        th:{eyebrow:'หน้างาน',title:'เช็กอิน',subtitle:'ยืนยันการมาถึงห้องประชุม',scanTitle:'สแกน QR ห้องประชุม',scanHint:'สแกน QR ที่ติดอยู่หน้าห้อง แล้วตรวจสอบรายการจองของคุณ',token:'QR ห้องประชุม',tokenPlaceholder:'วางหรือสแกน QR ห้องประชุม',validate:'ตรวจสอบ QR และดูตัวอย่าง',camera:'ใช้กล้อง',stopCamera:'หยุดกล้อง',photo:'ใช้รูปภาพ',myBookings:'รายการจองของฉัน',myBookingsHint:'เลือกรายการจองที่ต้องการเช็กอิน',empty:'ไม่มีรายการที่พร้อมเช็กอิน',selectBooking:'เลือก',selected:'เลือกแล้ว',previewTitle:'ตัวอย่างการเช็กอิน',room:'ห้อง',time:'เวลา',attendees:'ผู้เข้าร่วม',confirm:'ยืนยันเช็กอิน',cancel:'ยกเลิก',success:'เช็กอินสำเร็จ',checkout:'เช็กเอาต์',checkoutSuccess:'เช็กเอาต์สำเร็จ',invalid:'QR ห้องไม่ถูกต้อง หรือไม่มีรายการจองของคุณในช่วงเวลานี้',mismatch:'QR ไม่ตรงกับรายการจองที่เลือก',failed:'เช็กอินไม่สำเร็จ กรุณาลองใหม่',cameraUnsupported:'เบราว์เซอร์นี้ไม่พร้อมใช้กล้อง กรุณาใช้รูปภาพหรือกรอก token',imageScanFailed:'อ่าน QR จากรูปภาพไม่ได้ กรุณาถ่ายใหม่ให้เห็น QR ชัดเจน'},
        lo:{eyebrow:'ໜ້າງານ',title:'ເຊັກອິນ',subtitle:'ຢືນຢັນການມາຮອດຫ້ອງປະຊຸມ',scanTitle:'ສະແກນ QR ຫ້ອງປະຊຸມ',scanHint:'ເລືອກລາຍການຈອງ ແລ້ວສະແກນ QR ເພື່ອເບິ່ງຕົວຢ່າງ',token:'QR token',tokenPlaceholder:'ວາງ ຫຼື ສະແກນ QR token',validate:'ກວດສອບ QR ແລະ ເບິ່ງຕົວຢ່າງ',camera:'ໃຊ້ກ້ອງ',stopCamera:'ຢຸດກ້ອງ',photo:'ໃຊ້ຮູບພາບ',myBookings:'ລາຍການຈອງຂອງຂ້ອຍ',myBookingsHint:'ເລືອກລາຍການຈອງທີ່ຕ້ອງການເຊັກອິນ',empty:'ບໍ່ມີລາຍການພ້ອມເຊັກອິນ',selectBooking:'ເລືອກ',selected:'ເລືອກແລ້ວ',previewTitle:'ຕົວຢ່າງການເຊັກອິນ',room:'ຫ້ອງ',time:'ເວລາ',attendees:'ຜູ້ເຂົ້າຮ່ວມ',confirm:'ຢືນຢັນເຊັກອິນ',cancel:'ຍົກເລີກ',success:'ເຊັກອິນສຳເລັດ',checkout:'ເຊັກເອົາ',checkoutSuccess:'ເຊັກເອົາສຳເລັດ',invalid:'QR ບໍ່ຖືກຕ້ອງ ໝົດອາຍຸ ຫຼື ບໍ່ມີລາຍການທີ່ກຳລັງໃຊ້ງານ',mismatch:'QR ບໍ່ກົງກັບລາຍການຈອງທີ່ເລືອກ',failed:'ເຊັກອິນບໍ່ສຳເລັດ ກະລຸນາລອງໃໝ່',cameraUnsupported:'ບຣາວເຊີນີ້ບໍ່ພ້ອມໃຊ້ກ້ອງ ກະລຸນາໃຊ້ຮູບພາບ ຫຼື ໃສ່ token',imageScanFailed:'ບໍ່ສາມາດອ່ານ QR ຈາກຮູບພາບໄດ້'}
    }[lang] || {};
    document.querySelectorAll('[data-ci-i18n]').forEach(e => { if (m[e.dataset.ciI18n]) e.textContent = m[e.dataset.ciI18n]; });
    document.querySelectorAll('[data-ci-placeholder]').forEach(e => { if (m[e.dataset.ciPlaceholder]) e.placeholder = m[e.dataset.ciPlaceholder]; });
    const token = document.getElementById('checkinToken'), message = document.getElementById('checkinMessage'), preview = document.getElementById('checkinPreview'), cameraButton = document.getElementById('checkinCamera'), imageInput = document.getElementById('checkinImage');
    let selectedBookingId = null, validatedBookingId = null;
    let cameraStream = null, cameraVideo = null, zxingReader = null, zxingControls = null, zxingLoader = null;
    const show = (text, ok = false) => { message.hidden = false; message.className = `checkin-message ${ok ? 'success' : 'error'}`; message.textContent = text; };
    const body = () => { const value = { qrToken: token.value.trim() }; if (selectedBookingId) value.bookingId = selectedBookingId; return value; };
    const resetPreview = () => { preview.hidden = true; validatedBookingId = null; };
    document.querySelectorAll('.select-checkin-booking').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('.select-checkin-booking').forEach(x => { x.classList.remove('selected'); x.textContent = m.selectBooking; }); selectedBookingId = button.dataset.bookingId; button.classList.add('selected'); button.textContent = m.selected; resetPreview(); }));
    const organizationTimeZone = document.querySelector('[data-checkin-timezone]')?.dataset.checkinTimezone || 'UTC';
    const formatDateTime = (value, options) => new Intl.DateTimeFormat(undefined, { timeZone: organizationTimeZone, ...options }).format(new Date(value));
    const validate = async () => { if (!token.value.trim()) return show(m.invalid); try { const r = await fetch('/api/v1/checkin/validate', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body()) }); if (!r.ok) { const text = await r.text(); return show(r.status === 409 ? m.mismatch : (r.status === 400 || r.status === 404 ? m.invalid : text || m.failed)); } const data = await r.json(); validatedBookingId = data.bookingId; document.getElementById('previewTitle').textContent = data.title || '—'; document.getElementById('previewRoom').textContent = data.room?.name || '—'; document.getElementById('previewTime').textContent = `${formatDateTime(data.start_at_utc, { dateStyle:'medium', timeStyle:'short' })} – ${formatDateTime(data.end_at_utc, { timeStyle:'short' })}`; document.getElementById('previewAttendees').textContent = data.attendee_count ?? '—'; preview.hidden = false; message.hidden = true; } catch (_) { show(m.failed); } };
    const stopCamera = () => { zxingControls?.stop?.(); zxingReader?.reset?.(); zxingControls = null; zxingReader = null; cameraStream?.getTracks?.().forEach(track => track.stop()); cameraStream = null; cameraVideo?.remove(); cameraVideo = null; cameraButton.textContent = m.camera; cameraButton.dataset.running = 'false'; };
    const loadZxing = () => { if (window.ZXing?.BrowserMultiFormatReader) return Promise.resolve(); if (zxingLoader) return zxingLoader; zxingLoader = new Promise((resolve, reject) => { const script = document.createElement('script'); script.src = 'https://unpkg.com/@@zxing/library@@0.19.1'; script.onload = () => window.ZXing?.BrowserMultiFormatReader ? resolve() : reject(); script.onerror = reject; document.head.append(script); }); return zxingLoader; };
    const setTokenFromScan = value => { token.value = value || ''; stopCamera(); if (token.value) validate(); };
    const startCamera = async () => {
        stopCamera();
        const mediaDevices = window.navigator?.mediaDevices;
        if (!mediaDevices?.getUserMedia) return show(m.cameraUnsupported);
        const video = document.createElement('video'); video.className = 'checkin-camera-preview'; video.autoplay = true; video.muted = true; video.playsInline = true; cameraVideo = video; document.querySelector('.checkin-scan-panel').append(video); cameraButton.textContent = m.stopCamera; cameraButton.dataset.running = 'true';
        try {
            if ('BarcodeDetector' in window) {
                cameraStream = await mediaDevices.getUserMedia({video:{facingMode:'environment'}}); video.srcObject = cameraStream; await video.play(); const detector = new BarcodeDetector({formats:['qr_code']}); const scan = async () => { if (!cameraVideo) return; try { const codes = await detector.detect(video); if (codes[0]) return setTokenFromScan(codes[0].rawValue); } catch (_) {} requestAnimationFrame(scan); }; scan();
            } else {
                await loadZxing(); zxingReader = new ZXing.BrowserMultiFormatReader(); zxingControls = await zxingReader.decodeFromVideoDevice(undefined, video, (result, error, controls) => { if (result) { controls?.stop?.(); setTokenFromScan(result.getText?.() || result.text); } });
            }
        } catch (_) { stopCamera(); show(m.cameraUnsupported); }
    };
    const scanImage = async file => { if (!file) return; try { await loadZxing(); const reader = new (ZXing.BrowserQRCodeReader || ZXing.BrowserMultiFormatReader)(); const imageUrl = URL.createObjectURL(file); const result = await reader.decodeFromImageUrl(imageUrl); URL.revokeObjectURL(imageUrl); reader.reset?.(); setTokenFromScan(result.getText?.() || result.text); } catch (_) { show(m.imageScanFailed); } finally { imageInput.value = ''; } };
    document.getElementById('checkinScan').addEventListener('click', validate);
    document.getElementById('confirmCheckin').addEventListener('click', async () => { if (!validatedBookingId) return; try { const r = await fetch('/api/v1/checkin/scan', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ qrToken:token.value.trim(), bookingId:validatedBookingId }) }); if (!r.ok) return show(r.status === 409 ? m.mismatch : m.failed); show(m.success, true); resetPreview(); setTimeout(() => location.reload(), 700); } catch (_) { show(m.failed); } });
    document.getElementById('cancelPreview').addEventListener('click', resetPreview);
    cameraButton.addEventListener('click', () => cameraButton.dataset.running === 'true' ? stopCamera() : startCamera());
    imageInput.addEventListener('change', () => scanImage(imageInput.files?.[0]));
    document.querySelectorAll('.checkout-button').forEach(btn => btn.addEventListener('click', async () => { try { const r = await fetch(`/api/v1/checkin/${btn.dataset.bookingId}/checkout`, {method:'POST'}); if (!r.ok) return show(m.failed); show(m.checkoutSuccess, true); setTimeout(() => location.reload(), 700); } catch (_) { show(m.failed); } }));
    document.getElementById('languageSelect')?.addEventListener('change', () => location.reload());
})();
</script> }
