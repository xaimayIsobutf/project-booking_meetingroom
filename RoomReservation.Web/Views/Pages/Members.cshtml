@model List<RoomReservation.Domain.Entities.User>
@{
    ViewData["Title"] = "Members";
    var pendingCount = Model.Count(x => x.MembershipStatus == "Pending" || (x.IsActive && string.IsNullOrWhiteSpace(x.PasswordHash) && x.InvitationToken is not null));
    var activeCount = Model.Count(x => x.IsActive && x.MembershipStatus == "Active" && !string.IsNullOrWhiteSpace(x.PasswordHash));
    var inactiveCount = Model.Count(x => !x.IsActive || x.MembershipStatus == "Rejected");
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var organizations = ViewBag.AvailableOrganizations as IEnumerable<RoomReservation.Domain.Entities.Organization> ?? [];
}

<section class="page-head members-head">
    <div><span class="eyebrow" data-member-i18n="team">TEAM</span><h1 data-member-i18n="title">Members</h1><p data-member-i18n="subtitle">Manage people who can use this workspace.</p></div>
    <div class="button-group member-create-actions"><button class="button ghost" id="openAddDrawer" type="button">+ <span data-member-i18n="add">Add member</span></button><button class="button primary" id="openInviteDrawer" type="button">✉ <span data-member-i18n="invite">Invite member</span></button></div>
</section>

<div class="stat-grid member-stats">
    <div class="stat-card"><span data-member-i18n="total">Total members</span><strong>@Model.Count</strong><small data-member-i18n="totalHint">In this workspace</small></div>
    <div class="stat-card"><span data-member-i18n="active">Active members</span><strong>@activeCount</strong><small data-member-i18n="activeHint">Can sign in</small></div>
    <div class="stat-card"><span data-member-i18n="pending">Pending invitations</span><strong>@pendingCount</strong><small data-member-i18n="pendingHint">Awaiting first sign-in</small></div>
    <div class="stat-card"><span data-member-i18n="inactive">Inactive members</span><strong>@inactiveCount</strong><small data-member-i18n="inactiveHint">Access disabled</small></div>
</div>

<section class="panel members-panel">
    <div class="panel-head members-toolbar"><div><h2 data-member-i18n="directory">Member directory</h2><p data-member-i18n="directoryHint">Search and manage workspace access.</p></div><button class="button ghost" id="resetMemberFilters" type="button" data-member-i18n="reset">Reset</button></div>
    <div class="members-filters">
        <label><span data-member-i18n="search">Search</span><input id="memberSearch" type="search" placeholder="Name or email" data-member-placeholder="searchPlaceholder" /></label>
        <label><span data-member-i18n="role">Role</span><select id="memberRole"><option value="" data-member-i18n="allRoles">All roles</option><option value="Employee">Employee</option><option value="OrgAdmin">OrgAdmin</option><option value="SuperAdmin">SuperAdmin</option></select></label>
        <label><span data-member-i18n="status">Status</span><select id="memberStatus"><option value="" data-member-i18n="allStatuses">All statuses</option><option value="active" data-member-i18n="active">Active</option><option value="pending" data-member-i18n="pending">Pending approval</option><option value="inactive" data-member-i18n="inactive">Inactive</option><option value="rejected" data-member-i18n="rejected">Rejected</option></select></label>
    </div>
    <div class="members-count" id="memberCount"></div>
    <div class="table-wrap"><table class="members-table"><thead><tr><th data-member-i18n="member">Member</th><th data-member-i18n="role">Role</th><th data-member-i18n="joined">Joined</th><th data-member-i18n="status">Status</th><th data-member-i18n="actions">Actions</th></tr></thead><tbody id="memberRows">
    @foreach (var user in Model)
    {
        var pending = user.MembershipStatus == "Pending" || (user.IsActive && string.IsNullOrWhiteSpace(user.PasswordHash) && user.InvitationToken is not null);
        var status = user.MembershipStatus == "Rejected" ? "rejected" : !user.IsActive ? "inactive" : pending ? "pending" : "active";
        var displayName = string.IsNullOrWhiteSpace(user.DisplayName) ? "—" : user.DisplayName;
        var initials = displayName == "—" ? user.Email[..1].ToUpperInvariant() : displayName[..1].ToUpperInvariant();
        <tr data-name="@user.DisplayName" data-email="@user.Email" data-role="@user.Role" data-status="@status" data-id="@user.Id" data-display-name="@user.DisplayName">
            <td><div class="member-identity"><span class="member-avatar">@initials</span><span><b>@displayName</b><small>@user.Email</small></span></div></td>
            <td><span class="role-badge">@user.Role</span></td>
            <td>@(user.CreatedAt == default ? "—" : user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy"))</td>
            <td><span class="status member-status @status" data-status-label="@status"></span></td>
            <td><div class="member-actions"><button class="icon-action edit-member" type="button" data-member-i18n="edit">Edit</button>@if (pending){<button class="icon-action approve-member" type="button" data-member-label="approve">Approve</button><button class="icon-action danger reject-member" type="button" data-member-label="reject">Reject</button><button class="icon-action resend-member" type="button" data-email="@user.Email" data-member-i18n="resend">Resend</button>}<button class="icon-action danger deactivate-member" type="button" data-active="@user.IsActive" data-member-i18n="@(user.IsActive ? "deactivate" : "activate")">@(user.IsActive ? "Deactivate" : "Activate")</button></div></td>
        </tr>
    }
    </tbody></table><div class="empty-state" id="memberEmpty" hidden><strong data-member-i18n="empty">No members found</strong><span data-member-i18n="emptyHint">Try changing your filters.</span></div></div>
</section>

<div class="drawer-backdrop" id="memberBackdrop" hidden></div>
<aside class="member-drawer" id="memberDrawer" hidden aria-labelledby="memberDrawerTitle">
    <button class="drawer-close" id="closeMemberDrawer" type="button" aria-label="Close">×</button><span class="eyebrow" data-member-i18n="team">TEAM</span><h2 id="memberDrawerTitle">Add member</h2><p id="memberDrawerHint">Create a member with direct access.</p>
    <form id="memberForm" novalidate><input type="hidden" id="memberId" /><input type="hidden" id="memberMode" value="add" /><label><span data-member-i18n="name">Name</span><input id="memberName" autocomplete="name" required /></label><label><span data-member-i18n="email">Email</span><input id="memberEmail" type="email" autocomplete="email" required /></label><label><span data-member-i18n="role">Role</span><select id="memberFormRole"><option value="Employee">Employee</option><option value="OrgAdmin">OrgAdmin</option><option value="SuperAdmin">SuperAdmin</option></select></label>@if (isSuperAdmin) {<label id="memberOrganizationField"><span data-member-i18n="organization">Organization</span><select id="memberOrganization">@foreach (var organization in organizations) {<option value="@organization.Id">@organization.Name</option>}</select></label>}<label id="memberPasswordField"><span data-member-i18n="password">Password</span><div class="password-input"><input id="memberPassword" type="password" minlength="8" autocomplete="new-password" /><button type="button" class="password-toggle" id="toggleMemberPassword" aria-label="Show password">◉</button></div><small class="password-policy" data-member-i18n="passwordPolicy">At least 8 characters, including letters and numbers.</small></label><label id="memberConfirmPasswordField"><span data-member-i18n="confirmPassword">Confirm password</span><div class="password-input"><input id="memberConfirmPassword" type="password" minlength="8" autocomplete="new-password" /><button type="button" class="password-toggle" id="toggleMemberConfirmPassword" aria-label="Show password">◉</button></div></label><p class="drawer-error" id="memberError" hidden></p><div class="form-actions"><button class="button ghost" id="cancelMember" type="button" data-member-i18n="cancel">Cancel</button><button class="button primary" type="submit" id="memberSubmit">Create member</button></div></form>
</aside>

<script>
(() => {
  const memberActionLabels = { en:{approve:'Approve',reject:'Reject'}, th:{approve:'อนุมัติ',reject:'ปฏิเสธ'}, lo:{approve:'ອະນຸມັດ',reject:'ປະຕິເສດ'} };
  const memberActionLanguage = () => memberActionLabels[localStorage.getItem('roombooking-language') || 'en'] || memberActionLabels.en;
  const applyMemberActionLabels = () => { const x=memberActionLanguage(); document.querySelectorAll('.approve-member').forEach(b=>b.textContent=x.approve); document.querySelectorAll('.reject-member').forEach(b=>b.textContent=x.reject); };
  const rows=[...document.querySelectorAll('#memberRows tr')], search=document.querySelector('#memberSearch'), role=document.querySelector('#memberRole'), status=document.querySelector('#memberStatus'), count=document.querySelector('#memberCount'), empty=document.querySelector('#memberEmpty'), drawer=document.querySelector('#memberDrawer'), backdrop=document.querySelector('#memberBackdrop'), form=document.querySelector('#memberForm'), error=document.querySelector('#memberError');
  document.querySelector('.members-panel')?.before(drawer);
  const t={en:{team:'TEAM',title:'Members',subtitle:'Manage people who can use this workspace.',add:'Add member',total:'Total members',totalHint:'In this workspace',active:'Active members',activeHint:'Can sign in',pending:'Pending invitations',pendingHint:'Awaiting first sign-in',inactive:'Inactive members',inactiveHint:'Access disabled',directory:'Member directory',directoryHint:'Search and manage workspace access.',reset:'Reset',search:'Search',searchPlaceholder:'Name or email',role:'Role',allRoles:'All roles',status:'Status',allStatuses:'All statuses',member:'Member',joined:'Joined',actions:'Actions',edit:'Edit',resend:'Resend',deactivate:'Deactivate',activate:'Activate',empty:'No members found',emptyHint:'Try changing your filters.',addTitle:'Add member',drawerHint:'Invite someone to this workspace.',name:'Name',email:'Email',cancel:'Cancel',send:'Send invitation',activeLabel:'Active',pendingLabel:'Pending invitation',inactiveLabel:'Inactive',records:'members'},th:{team:'ทีม',title:'สมาชิก',subtitle:'จัดการผู้ที่สามารถใช้งานพื้นที่ทำงานนี้',add:'เพิ่มสมาชิก',total:'สมาชิกทั้งหมด',totalHint:'ในพื้นที่ทำงานนี้',active:'สมาชิกที่ใช้งาน',activeHint:'สามารถเข้าสู่ระบบได้',pending:'คำเชิญที่รอดำเนินการ',pendingHint:'รอการเข้าสู่ระบบครั้งแรก',inactive:'สมาชิกที่ปิดใช้งาน',inactiveHint:'ปิดสิทธิ์การเข้าถึง',directory:'รายชื่อสมาชิก',directoryHint:'ค้นหาและจัดการสิทธิ์การใช้งาน',reset:'รีเซ็ต',search:'ค้นหา',searchPlaceholder:'ชื่อหรืออีเมล',role:'บทบาท',allRoles:'ทุกบทบาท',status:'สถานะ',allStatuses:'ทุกสถานะ',member:'สมาชิก',joined:'เข้าร่วมเมื่อ',actions:'การจัดการ',edit:'แก้ไข',resend:'ส่งอีกครั้ง',deactivate:'ปิดใช้งาน',activate:'เปิดใช้งาน',empty:'ไม่พบสมาชิก',emptyHint:'ลองเปลี่ยนตัวกรอง',addTitle:'เพิ่มสมาชิก',drawerHint:'เชิญสมาชิกเข้าสู่พื้นที่ทำงาน',name:'ชื่อ',email:'อีเมล',cancel:'ยกเลิก',send:'ส่งคำเชิญ',activeLabel:'ใช้งาน',pendingLabel:'รอคำเชิญ',inactiveLabel:'ปิดใช้งาน',records:'สมาชิก'},lo:{team:'ທີມງານ',title:'ສະມາຊິກ',subtitle:'ຈັດການຜູ້ທີ່ສາມາດໃຊ້ພື້ນທີ່ນີ້',add:'ເພີ່ມສະມາຊິກ',total:'ສະມາຊິກທັງໝົດ',totalHint:'ໃນພື້ນທີ່ນີ້',active:'ສະມາຊິກທີ່ໃຊ້ງານ',activeHint:'ສາມາດເຂົ້າລະບົບ',pending:'ຄຳເຊີນທີ່ລໍຖ້າ',pendingHint:'ລໍຖ້າການເຂົ້າລະບົບຄັ້ງທຳອິດ',inactive:'ສະມາຊິກປິດໃຊ້ງານ',inactiveHint:'ປິດສິດເຂົ້າໃຊ້',directory:'ລາຍຊື່ສະມາຊິກ',directoryHint:'ຄົ້ນຫາ ແລະຈັດການສິດໃຊ້ງານ',reset:'ຣີເຊັດ',search:'ຄົ້ນຫາ',searchPlaceholder:'ຊື່ ຫຼື ອີເມວ',role:'ບົດບາດ',allRoles:'ທຸກບົດບາດ',status:'ສະຖານະ',allStatuses:'ທຸກສະຖານະ',member:'ສະມາຊິກ',joined:'ເຂົ້າຮ່ວມເມື່ອ',actions:'ການຈັດການ',edit:'ແກ້ໄຂ',resend:'ສົ່ງອີກຄັ້ງ',deactivate:'ປິດໃຊ້ງານ',activate:'ເປີດໃຊ້ງານ',empty:'ບໍ່ພົບສະມາຊິກ',emptyHint:'ລອງປ່ຽນຕົວກັ່ນຕອງ',addTitle:'ເພີ່ມສະມາຊິກ',drawerHint:'ເຊີນສະມາຊິກເຂົ້າພື້ນທີ່',name:'ຊື່',email:'ອີເມວ',cancel:'ຍົກເລີກ',send:'ສົ່ງຄຳເຊີນ',activeLabel:'ໃຊ້ງານ',pendingLabel:'ລໍຖ້າຄຳເຊີນ',inactiveLabel:'ປິດໃຊ້ງານ',records:'ສະມາຊິກ'}};
  Object.assign(t.en,{invite:'Invite member',password:'Password',confirmPassword:'Confirm password',passwordPolicy:'At least 8 characters, including letters and numbers.',organization:'Organization',create:'Create member',inviteSubmit:'Send invitation',addHint:'Create a member with direct access.',inviteHint:'Invite someone to this workspace.',passwordMismatch:'Passwords do not match.',emailExists:'This email is already in use.',required:'This field is required.',invalidEmail:'Enter a valid email address.',approve:'Approve',reject:'Reject',rejectedLabel:'Rejected'});Object.assign(t.th,{invite:'เชิญสมาชิก',password:'รหัสผ่าน',confirmPassword:'ยืนยันรหัสผ่าน',passwordPolicy:'อย่างน้อย 8 ตัวอักษร ต้องมีตัวอักษรและตัวเลข',organization:'บริษัท',create:'สร้างสมาชิก',inviteSubmit:'ส่งคำเชิญ',addHint:'สร้างสมาชิกและให้เข้าใช้งานได้ทันที',inviteHint:'เชิญสมาชิกเข้าสู่พื้นที่ทำงาน',passwordMismatch:'รหัสผ่านไม่ตรงกัน',emailExists:'อีเมลนี้มีอยู่ในระบบแล้ว',required:'กรุณากรอกข้อมูลช่องนี้',invalidEmail:'กรุณากรอกอีเมลให้ถูกต้อง',approve:'อนุมัติ',reject:'ปฏิเสธ',rejectedLabel:'ถูกปฏิเสธ'});Object.assign(t.lo,{invite:'ເຊີນສະມາຊິກ',password:'ລະຫັດຜ່ານ',confirmPassword:'ຢືນຢັນລະຫັດຜ່ານ',passwordPolicy:'ຢ່າງໜ້ອຍ 8 ຕົວ ຕ້ອງມີຕົວອັກສອນ ແລະຕົວເລກ',organization:'ບໍລິສັດ',create:'ສ້າງສະມາຊິກ',inviteSubmit:'ສົ່ງຄຳເຊີນ',addHint:'ສ້າງສະມາຊິກ ແລະໃຫ້ເຂົ້າໃຊ້ງານໄດ້ທັນທີ',inviteHint:'ເຊີນສະມາຊິກເຂົ້າພື້ນທີ່',passwordMismatch:'ລະຫັດຜ່ານບໍ່ກົງກັນ',emailExists:'ອີເມວນີ້ມີຢູ່ໃນລະບົບແລ້ວ',required:'ກະລຸນາຕື່ມຂໍ້ມູນ',invalidEmail:'ກະລຸນາໃສ່ອີເມວໃຫ້ຖືກຕ້ອງ',approve:'ອະນຸມັດ',reject:'ປະຕິເສດ',rejectedLabel:'ປະຕິເສດ'});
  const lang=()=>t[localStorage.getItem('roombooking-language')||'en']||t.en;
  const translate=()=>{const x=lang();document.querySelectorAll('[data-member-i18n]').forEach(e=>{const k=e.dataset.memberI18n;if(x[k])e.textContent=x[k]});document.querySelectorAll('[data-member-placeholder]').forEach(e=>e.placeholder=x[e.dataset.memberPlaceholder]);document.querySelectorAll('[data-status-label]').forEach(e=>e.textContent=x[e.dataset.statusLabel+'Label']);document.querySelectorAll('.edit-member').forEach(e=>e.textContent=x.edit);document.querySelectorAll('.resend-member').forEach(e=>e.textContent=x.resend);document.querySelectorAll('.deactivate-member').forEach(e=>e.textContent=x[String(e.dataset.active).toLowerCase()==='true'?'deactivate':'activate']);};
  const filter=()=>{const q=search.value.toLowerCase().trim(),r=role.value,s=status.value;let n=0;rows.forEach(row=>{const ok=(!q||(row.dataset.name+' '+row.dataset.email).toLowerCase().includes(q))&&(!r||row.dataset.role===r)&&(!s||row.dataset.status===s);row.hidden=!ok;if(ok)n++});count.textContent=n+' '+lang().records;empty.hidden=n!==0;};
  const open=(mode='add',row=null)=>{const edit=mode==='edit',x=lang();form.reset();document.querySelector('#memberMode').value=mode;document.querySelector('#memberId').value=edit?row.dataset.id:'';document.querySelector('#memberName').value=edit?row.dataset.displayName:'';document.querySelector('#memberEmail').value=edit?row.dataset.email:'';document.querySelector('#memberEmail').disabled=edit;document.querySelector('#memberFormRole').value=edit?row.dataset.role:'Employee';document.querySelector('#memberDrawerTitle').textContent=edit?x.edit:mode==='invite'?x.invite:x.addTitle;document.querySelector('#memberDrawerHint').textContent=edit?x.directoryHint:mode==='invite'?x.inviteHint:x.addHint;document.querySelector('#memberPasswordField').hidden=edit||mode==='invite';document.querySelector('#memberConfirmPasswordField').hidden=edit||mode==='invite';document.querySelector('#memberOrganizationField')&&(document.querySelector('#memberOrganizationField').hidden=edit||mode==='invite');document.querySelector('#memberPassword').required=mode==='add'&&!edit;document.querySelector('#memberConfirmPassword').required=mode==='add'&&!edit;document.querySelector('#memberSubmit').textContent=edit?x.edit:mode==='invite'?x.inviteSubmit:x.create;error.hidden=true;drawer.hidden=false;backdrop.hidden=false;};
  const close=()=>{drawer.hidden=true;backdrop.hidden=true;};
  [search,role,status].forEach(e=>e.addEventListener('input',filter));document.querySelector('#resetMemberFilters').onclick=()=>{search.value='';role.value='';status.value='';filter()};document.querySelector('#openAddDrawer').onclick=()=>open('add');document.querySelector('#openInviteDrawer').onclick=()=>open('invite');document.querySelector('#closeMemberDrawer').onclick=close;document.querySelector('#cancelMember').onclick=close;backdrop.onclick=close;document.querySelectorAll('.edit-member').forEach(b=>b.onclick=()=>open('edit',b.closest('tr')));
  document.querySelectorAll('.deactivate-member').forEach(b=>b.onclick=async()=>{const active=String(b.dataset.active).toLowerCase()==='true';if(!confirm((active?lang().deactivate:lang().activate)+'?'))return;const res=await fetch('/api/v1/org/members/'+b.closest('tr').dataset.id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({isActive:!active})});if(res.ok)location.reload()});
  document.querySelectorAll('.resend-member').forEach(b=>b.onclick=async()=>{const row=b.closest('tr'),res=await fetch('/api/v1/org/members/'+row.dataset.id+'/resend',{method:'POST'});if(res.ok)alert(lang().send+': '+b.dataset.email);else alert(await res.text())});
  const togglePassword=(id,button)=>button.onclick=()=>{const input=document.querySelector(id),show=input.type==='password';input.type=show?'text':'password';button.textContent=show?'◉':'◌';};togglePassword('#memberPassword',document.querySelector('#toggleMemberPassword'));togglePassword('#memberConfirmPassword',document.querySelector('#toggleMemberConfirmPassword'));
  form.onsubmit=async e=>{e.preventDefault();error.hidden=true;const id=document.querySelector('#memberId').value,mode=document.querySelector('#memberMode').value,x=lang(),p={displayName:document.querySelector('#memberName').value,email:document.querySelector('#memberEmail').value,role:document.querySelector('#memberFormRole').value,password:document.querySelector('#memberPassword').value,confirmPassword:document.querySelector('#memberConfirmPassword').value,organizationId:document.querySelector('#memberOrganization')?.value};if(!p.displayName.trim()||!p.email.trim()){error.textContent=x.required;error.hidden=false;return}if(!p.email.includes(String.fromCharCode(64))||!p.email.includes('.')){error.textContent=x.invalidEmail;error.hidden=false;return}if(mode==='add'&&!id&&(p.password.length<8||!/[A-Za-z]/.test(p.password)||!/[0-9]/.test(p.password))){error.textContent=x.passwordPolicy;error.hidden=false;return}if(mode==='add'&&!id&&p.password!==p.confirmPassword){error.textContent=x.passwordMismatch;error.hidden=false;return}const url=id?'/api/v1/org/members/'+id:mode==='invite'?'/api/v1/org/members/invite':'/api/v1/org/members';const body=id?{displayName:p.displayName,role:p.role}:mode==='invite'?{displayName:p.displayName,email:p.email,role:p.role,organizationId:p.organizationId}:p;const res=await fetch(url,{method:id?'PATCH':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!res.ok){error.textContent=res.status===409?x.emailExists:await res.text();error.hidden=false;return}location.reload()};
  translate();filter();
})();
</script>
<script>
(() => {
  const labels = { en:{approve:'Approve',reject:'Reject'}, th:{approve:'อนุมัติ',reject:'ปฏิเสธ'}, lo:{approve:'ອະນຸມັດ',reject:'ປະຕິເສດ'} };
  const lang = () => labels[localStorage.getItem('roombooking-language') || 'en'] || labels.en;
  const apply = () => { const x=lang(); document.querySelectorAll('.approve-member').forEach(b=>b.textContent=x.approve); document.querySelectorAll('.reject-member').forEach(b=>b.textContent=x.reject); };
  const submit = async (button, action, text) => { if (!confirm(text)) return; button.disabled=true; const id=button.closest('tr').dataset.id; const response=await fetch('/api/v1/org/members/'+id+'/'+action,{method:'POST'}); if(response.ok) location.reload(); else { button.disabled=false; alert(await response.text()); } };
  document.querySelectorAll('.approve-member').forEach(b=>b.addEventListener('click',()=>submit(b,'approve','Approve this member?')));
  document.querySelectorAll('.reject-member').forEach(b=>b.addEventListener('click',()=>submit(b,'reject','Reject this member?')));
  applyMemberActionLabels(); document.getElementById('languageSelect')?.addEventListener('change',()=>setTimeout(applyMemberActionLabels,60));
})();
</script>
<script>
(() => {
  const form = document.querySelector('#memberForm');
  const drawer = document.querySelector('#memberDrawer');
  const backdrop = document.querySelector('#memberBackdrop');
  if (!form || !drawer || !backdrop) return;
  const idInput = document.querySelector('#memberId');
  const modeInput = document.querySelector('#memberMode');
  const nameInput = document.querySelector('#memberName');
  const emailInput = document.querySelector('#memberEmail');
  const roleInput = document.querySelector('#memberFormRole');
  const passwordInput = document.querySelector('#memberPassword');
  const confirmInput = document.querySelector('#memberConfirmPassword');
  const passwordField = document.querySelector('#memberPasswordField');
  const confirmField = document.querySelector('#memberConfirmPasswordField');
  const orgField = document.querySelector('#memberOrganizationField');
  const submit = document.querySelector('#memberSubmit');
  const error = document.querySelector('#memberError');
  const languages = {
    en: { reset:'Reset password', hint:'Set a new password for this member.', save:'Reset password', mismatch:'Passwords do not match.', policy:'At least 8 characters, including letters and numbers.' },
    th: { reset:'รีเซ็ตรหัสผ่าน', hint:'ตั้งรหัสผ่านใหม่ให้สมาชิกคนนี้', save:'บันทึกรหัสผ่านใหม่', mismatch:'รหัสผ่านไม่ตรงกัน', policy:'อย่างน้อย 8 ตัวอักษร ต้องมีตัวอักษรและตัวเลข' },
    lo: { reset:'ຣີເຊັດລະຫັດຜ່ານ', hint:'ຕັ້ງລະຫັດຜ່ານໃໝ່ໃຫ້ສະມາຊິກນີ້', save:'ບັນທຶກລະຫັດຜ່ານໃໝ່', mismatch:'ລະຫັດຜ່ານບໍ່ກົງກັນ', policy:'ຢ່າງໜ້ອຍ 8 ຕົວ ຕ້ອງມີຕົວອັກສອນ ແລະຕົວເລກ' }
  };
  const language = () => languages[localStorage.getItem('roombooking-language') || 'en'] || languages.en;
  const setResetButtonLabels = () => document.querySelectorAll('.reset-password-member').forEach(button => button.textContent = language().reset);
  const restoreMemberFields = () => { nameInput.disabled = false; emailInput.disabled = false; roleInput.disabled = false; };
  document.getElementById('openAddDrawer')?.addEventListener('click', restoreMemberFields);
  document.getElementById('openInviteDrawer')?.addEventListener('click', restoreMemberFields);
  document.querySelector('#cancelMember')?.addEventListener('click', restoreMemberFields);
  document.querySelectorAll('#memberRows tr').forEach(row => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'icon-action reset-password-member';
    button.dataset.memberId = row.dataset.id;
    button.dataset.displayName = row.dataset.displayName || '';
    button.dataset.email = row.dataset.email || '';
    button.textContent = language().reset;
    row.querySelector('.member-actions')?.append(button);
    button.addEventListener('click', () => {
      const text = language();
      modeInput.value = 'reset';
      idInput.value = button.dataset.memberId;
      nameInput.value = button.dataset.displayName;
      emailInput.value = button.dataset.email;
      nameInput.disabled = true;
      emailInput.disabled = true;
      roleInput.disabled = true;
      if (orgField) orgField.hidden = true;
      passwordField.hidden = false;
      confirmField.hidden = false;
      passwordInput.required = true;
      confirmInput.required = true;
      passwordInput.value = '';
      confirmInput.value = '';
      document.querySelector('#memberDrawerTitle').textContent = text.reset;
      document.querySelector('#memberDrawerHint').textContent = text.hint;
      document.querySelector('.password-policy').textContent = text.policy;
      submit.textContent = text.save;
      error.hidden = true;
      drawer.hidden = false;
      backdrop.hidden = false;
    });
  });
  const existingSubmit = form.onsubmit;
  form.onsubmit = async event => {
    if (modeInput.value !== 'reset') return existingSubmit?.(event);
    event.preventDefault();
    const text = language();
    error.hidden = true;
    if (passwordInput.value.length < 8 || !/[A-Za-z]/.test(passwordInput.value) || !/[0-9]/.test(passwordInput.value)) { error.textContent = text.policy; error.hidden = false; return; }
    if (passwordInput.value !== confirmInput.value) { error.textContent = text.mismatch; error.hidden = false; return; }
    const response = await fetch('/api/v1/org/members/' + encodeURIComponent(idInput.value) + '/reset-password', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ password: passwordInput.value }) });
    if (!response.ok) { error.textContent = await response.text(); error.hidden = false; return; }
    location.reload();
  };
  document.getElementById('languageSelect')?.addEventListener('change', () => setTimeout(setResetButtonLabels, 30));
})();
</script>
