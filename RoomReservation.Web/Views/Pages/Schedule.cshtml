@model RoomReservation.Web.Models.SchedulePageModel
@{ ViewData["Title"] = "Calendar Room"; var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId); Func<DateTime, DateTime> local = value => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), zone); var days = Enumerable.Range(0, Model.View == "day" ? 1 : 7).Select(i => Model.From.AddDays(i)).ToList(); var hours = Enumerable.Range(8, 13).ToList(); var isDay = Model.View == "day"; var buildings = Model.Rooms.Select(x => x.Building).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList(); var floors = Model.Rooms.Select(x => x.Floor).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList(); var roomCount = Math.Max(Model.Rooms.Count, 1); var historyBookings = Model.HistoryBookings; }
<section class="page-head schedule-hero"><div><span class="eyebrow">SCHEDULE</span><h1>@Model.Date.ToString("dd MMMM yyyy")</h1><p>Book a room by time and availability.</p></div><div class="button-group"><a class="button ghost" href="/schedule?date=@Model.Date.AddDays(isDay ? -1 : -7).ToString("yyyy-MM-dd")&view=@Model.View">‹</a><a class="button ghost" href="/schedule?date=@DateTime.Today.ToString("yyyy-MM-dd")&view=@Model.View">Today</a><label class="header-date">Choose date<input type="date" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="window.location='/schedule?date='+this.value+'&view=@Model.View'" /></label><a class="button ghost" href="/schedule?date=@Model.Date.AddDays(isDay ? 1 : 7).ToString("yyyy-MM-dd")&view=@Model.View">›</a><span class="view-switch"><a class="@(Model.View == "day" ? "selected" : "")" href="/schedule?date=@Model.Date.ToString("yyyy-MM-dd")&view=day">Day</a><a class="@(Model.View == "week" ? "selected" : "")" href="/schedule?date=@Model.Date.ToString("yyyy-MM-dd")&view=week">Week</a></span><a class="button primary" href="/bookings/new">+ New booking</a></div></section>
<div class="calendar-layout"><section class="schedule-board"><div class="calendar-filter-bar"><label>Meeting rooms<select id="roomFilter"><option>All rooms</option>@foreach (var r in Model.Rooms) { <option value="@r.Id">@r.Name</option> }</select></label><label>Building<select id="buildingFilter"><option>All buildings</option>@foreach (var building in buildings) { <option>@building</option> }</select></label><label>Floor<select id="floorFilter"><option>All floors</option>@foreach (var floor in floors) { <option>@floor</option> }</select></label><div class="schedule-legend"><span><i class="pending-dot"></i>Pending</span><span><i class="confirmed-dot"></i>Confirmed</span><span><i class="checked-dot"></i>Checked in</span><span><i class="completed-dot"></i>Completed</span><span><i class="cancelled-dot"></i>Cancelled</span><span><i class="noshow-dot"></i>No-show</span></div></div><div class="schedule-toolbar"><b>@(isDay ? Model.Date.ToString("dddd dd MMM") : $"{Model.From:dd MMM yyyy} – {Model.From.AddDays(days.Count - 1):dd MMM yyyy}")</b><span class="schedule-hint">Select an empty time slot to book</span></div>@if (isDay) { <div class="resource-schedule" style="--rooms:@roomCount"><div class="resource-corner"></div>@foreach (var room in Model.Rooms) { <div class="resource-room-head" data-room-header="@room.Id"><b>@room.Name</b><small>@room.Building · @room.Floor · @room.Capacity people</small></div> } @foreach (var hour in hours) { <div class="resource-time" style="grid-column:1;grid-row:@(hour - hours.First() + 2);">@hour.ToString("00"):00</div>@foreach (var room in Model.Rooms) { var cellStart = Model.Date.Date.AddHours(hour); var booking = Model.Bookings.FirstOrDefault(x => x.RoomId == room.Id && local(x.StartAtUtc) <= cellStart && local(x.EndAtUtc) > cellStart); <div class="resource-cell" style="grid-column:@(Model.Rooms.IndexOf(room) + 2);grid-row:@(hour - hours.First() + 2);" data-room-cell="@room.Id" data-building="@room.Building" data-floor="@room.Floor">@if (booking is null) { <a class="time-slot" href="/bookings/new?roomId=@room.Id&startAt=@cellStart.ToString("yyyy-MM-ddTHH:mm")&endAt=@cellStart.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" aria-label="Book @room.Name at @hour:00">＋</a> }</div> } } @for (var roomIndex = 0; roomIndex < Model.Rooms.Count; roomIndex++) { var room = Model.Rooms[roomIndex]; var roomBookings = Model.Bookings.Where(x => x.RoomId == room.Id).ToList(); foreach (var booking in roomBookings) { var start = local(booking.StartAtUtc); var end = local(booking.EndAtUtc); var startRow = Math.Clamp((start.Hour - hours.First()) + 2, 2, hours.Count + 1); var duration = Math.Max(1, (int)Math.Ceiling((end - start).TotalHours)); var maxSpan = hours.Count + 2 - startRow; var rowSpan = Math.Min(duration, maxSpan); var eventStyle = $"grid-column:{roomIndex + 2};grid-row:{startRow}/span {rowSpan};"; <a class="event resource-event booking-open @booking.Status.ToString().ToLowerInvariant()" style="@eventStyle" data-title="@booking.Title" data-room="@room.Name" data-room-event="@room.Id" data-start="@start.ToString("dd MMM yyyy HH:mm")" data-end="@end.ToString("HH:mm")" href="/bookings/@booking.Id"><b>@booking.Title</b><small>@start.ToString("HH:mm")–@end.ToString("HH:mm")</small></a> } } </div> } else { <div class="week-time-schedule" style="--days:@days.Count"><div class="week-time-corner"></div>@foreach (var day in days) { <div class="week-time-day">@day.ToString("ddd")<b>@day.ToString("dd/MM")</b></div> } @for (var hourIndex = 0; hourIndex < hours.Count; hourIndex++) { var hour = hours[hourIndex]; <div class="week-time-hour">@hour.ToString("00"):00</div>@for (var dayIndex = 0; dayIndex < days.Count; dayIndex++) { var day = days[dayIndex]; var cellStart = day.Date.AddHours(hour); var bookingsAtTime = Model.Bookings.Where(x => local(x.StartAtUtc) <= cellStart && local(x.EndAtUtc) > cellStart).ToList(); <div class="week-time-cell" style="grid-column:@(dayIndex + 2);grid-row:@(hourIndex + 2);">@if (!bookingsAtTime.Any()) { <a class="time-slot week-slot" href="/bookings/new?startAt=@cellStart.ToString("yyyy-MM-ddTHH:mm")&endAt=@cellStart.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" aria-label="Book a room on @day.ToString("dd/MM") at @hour:00">＋</a> }</div> } } @for (var dayIndex = 0; dayIndex < days.Count; dayIndex++) { var day = days[dayIndex]; var dayBookings = Model.Bookings.Where(x => local(x.StartAtUtc).Date == day.Date).ToList(); foreach (var booking in dayBookings) { var startAt = local(booking.StartAtUtc); var endAt = local(booking.EndAtUtc); var startRow = Math.Clamp((startAt.Hour - hours.First()) + 2, 2, hours.Count + 1); var duration = Math.Max(1, (int)Math.Ceiling((endAt - startAt).TotalHours)); var maxSpan = hours.Count + 2 - startRow; var rowSpan = Math.Min(duration, maxSpan); var roomName = Model.Rooms.FirstOrDefault(x => x.Id == booking.RoomId)?.Name ?? "Meeting room"; var eventStyle = $"grid-column:{dayIndex + 2};grid-row:{startRow}/span {rowSpan};"; <a class="event week-resource-event booking-open @booking.Status.ToString().ToLowerInvariant()" style="@eventStyle" data-title="@booking.Title" data-room="@roomName" data-start="@startAt.ToString("dd MMM yyyy HH:mm")" data-end="@endAt.ToString("HH:mm")" href="/bookings/@booking.Id"><b>@booking.Title</b><small>@roomName · @startAt.ToString("HH:mm")–@endAt.ToString("HH:mm")</small></a> } } </div> }</section></div>
<aside class="booking-drawer" id="bookingDrawer" hidden aria-labelledby="drawerTitle"><button type="button" class="drawer-close" id="drawerClose" aria-label="Close">×</button><span class="eyebrow">BOOKING DETAILS</span><h2 id="drawerTitle"></h2><p id="drawerRoom"></p><p id="drawerTime"></p><a class="button primary" id="drawerOpen" href="#">Open booking</a></aside>
@section Scripts { <script>function filterRooms(v){const query=v.toLowerCase();document.querySelectorAll('[data-room-cell],[data-room-header]').forEach(x=>x.hidden=!x.innerText.toLowerCase().includes(query))}function toggleRoom(id,visible){document.querySelectorAll('[data-room-cell="'+id+'"],[data-room-header="'+id+'"]').forEach(x=>x.hidden=!visible)}const drawer=document.getElementById('bookingDrawer');document.querySelectorAll('.booking-open').forEach(link=>link.addEventListener('click',e=>{e.preventDefault();document.getElementById('drawerTitle').textContent=link.dataset.title;document.getElementById('drawerRoom').textContent=link.dataset.room;document.getElementById('drawerTime').textContent=link.dataset.start+'–'+link.dataset.end;document.getElementById('drawerOpen').href=link.href;drawer.hidden=false}));document.getElementById('drawerClose')?.addEventListener('click',()=>drawer.hidden=true);const roomFilter=document.getElementById('roomFilter');roomFilter?.addEventListener('change',()=>{const schedule=document.querySelector('.resource-schedule');const selected=roomFilter.value;const single=selected!=='All rooms';schedule?.classList.toggle('single-room',single);document.querySelectorAll('[data-room-cell],[data-room-header],[data-room-event]').forEach(x=>{const isMatch=!single||x.dataset.roomCell===selected||x.dataset.roomHeader===selected||x.dataset.roomEvent===selected;x.hidden=!isMatch;if(isMatch&&single&&x.dataset.roomEvent)x.style.gridColumn='2';if(isMatch&&single&&(x.dataset.roomCell||x.dataset.roomHeader))x.style.gridColumn='2'});});[...document.querySelectorAll('#buildingFilter,#floorFilter')].forEach(select=>select.addEventListener('change',()=>{const building=document.getElementById('buildingFilter').value,floor=document.getElementById('floorFilter').value;document.querySelectorAll('[data-room-cell]').forEach(x=>x.hidden=(building!=='All buildings'&&x.dataset.building!==building)||(floor!=='All floors'&&x.dataset.floor!==floor))}));roomFilter?.dispatchEvent(new Event('change'));</script> }
<div id="scheduleRoomMap" hidden>@foreach (var room in Model.Rooms) { <span data-room-id="@room.Id" data-room-name="@room.Name" data-building="@room.Building" data-floor="@room.Floor"></span> }</div>
<script>
(() => { const source=['SCHEDULE','Book a room by time and availability.','‹','Today','Choose date','›','Day','Week','+ New booking','Meeting rooms','All rooms','Building','All buildings','Floor','All floors','Pending','Confirmed','Checked in','Completed','Cancelled','No-show','Select an empty time slot to book','No rooms match your filters.']; const th=['ตารางเวลา','จองห้องตามเวลาและห้องว่าง','‹','วันนี้','เลือกวันที่','›','รายวัน','รายสัปดาห์','+ จองห้องประชุม','ห้องประชุม','ทุกห้อง','อาคาร','ทุกอาคาร','ชั้น','ทุกชั้น','รอดำเนินการ','ยืนยันแล้ว','เช็กอินแล้ว','เสร็จสิ้น','ยกเลิก','ไม่มาใช้ห้อง','เลือกช่วงเวลาว่างเพื่อจอง','ไม่พบห้องที่ตรงกับตัวกรอง']; const lo=['ຕາຕະລາງເວລາ','ຈອງຫ້ອງຕາມເວລາ ແລະ ຫ້ອງວ່າງ','‹','ມື້ນີ້','ເລືອກວັນທີ','›','ລາຍວັນ','ລາຍອາທິດ','+ ຈອງຫ້ອງປະຊຸມ','ຫ້ອງປະຊຸມ','ທຸກຫ້ອງ','ອາຄານ','ທຸກອາຄານ','ຊັ້ນ','ທຸກຊັ້ນ','ລໍຖ້າດຳເນີນການ','ຢືນຢັນແລ້ວ','ເຊັກອິນແລ້ວ','ສຳເລັດ','ຍົກເລີກ','ບໍ່ມາໃຊ້ຫ້ອງ','ເລືອກເວລາວ່າງເພື່ອຈອງ','ບໍ່ພົບຫ້ອງທີ່ກົງກັບຕົວກອງ']; function apply(){const code=localStorage.getItem('roombooking-language')||'en',values=code==='th'?th:code==='lo'?lo:source;const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT),nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);nodes.forEach(n=>{const p=n.parentElement;if(!p||['SCRIPT','STYLE','INPUT','TEXTAREA','OPTION'].includes(p.tagName))return;const raw=p.dataset.calendarText||n.textContent.trim(),i=source.indexOf(raw);if(i>=0){p.dataset.calendarText=raw;n.textContent=n.textContent.replace(raw,values[i])}});document.querySelectorAll('input[placeholder],option').forEach(el=>{const raw=el.dataset.calendarText||el.getAttribute('placeholder')||el.textContent.trim(),i=source.indexOf(raw);if(i>=0){el.dataset.calendarText=raw;if(el.placeholder!==undefined)el.placeholder=values[i];else el.textContent=values[i]}})}apply();document.getElementById('languageSelect')?.addEventListener('change',()=>setTimeout(apply,20)); })();
</script>
<script>
(() => {
  const roomFilter = document.getElementById('roomFilter');
  const buildingFilter = document.getElementById('buildingFilter');
  const floorFilter = document.getElementById('floorFilter');
  if (roomFilter?.options[0]) roomFilter.options[0].value = 'All rooms';
  if (buildingFilter?.options[0]) buildingFilter.options[0].value = 'All buildings';
  if (floorFilter?.options[0]) floorFilter.options[0].value = 'All floors';
    const events = [...document.querySelectorAll('.week-resource-event')];
    events.forEach(event => { event.dataset.originalGridColumn = event.style.gridColumn; });
    document.querySelectorAll('.resource-event[data-room-event]').forEach(event => { event.dataset.originalGridColumn = event.style.gridColumn; });
  if (!events.length) return;
    const roomMap = [...document.querySelectorAll('#scheduleRoomMap [data-room-id]')];
    const roomMeta = name => roomMap.find(room => room.dataset.roomName.trim() === name.trim());
    events.forEach(event => {
      const meta = roomMeta(event.dataset.room || '');
      if (meta) {
        event.dataset.roomEvent = meta.dataset.roomId;
        event.dataset.roomBuilding = meta.dataset.building || '';
        event.dataset.roomFloor = meta.dataset.floor || '';
      }
    });
  const apply = () => {
    const roomName = roomFilter?.value && roomFilter.value !== 'All rooms'
      ? roomFilter.options[roomFilter.selectedIndex].textContent.trim() : '';
      const building = buildingFilter?.value !== 'All buildings' ? (buildingFilter?.value || '') : '';
      const floor = floorFilter?.value !== 'All floors' ? (floorFilter?.value || '') : '';
    events.forEach(event => {
        event.style.gridColumn = event.dataset.originalGridColumn || '';
        event.hidden = (!!roomName && event.dataset.room !== roomName) || (!!building && event.dataset.roomBuilding !== building) || (!!floor && event.dataset.roomFloor !== floor);
    });
  };
    const applyAfterExistingHandlers = () => { apply(); setTimeout(apply, 0); };
    roomFilter?.addEventListener('change', applyAfterExistingHandlers);
    buildingFilter?.addEventListener('change', applyAfterExistingHandlers);
    floorFilter?.addEventListener('change', applyAfterExistingHandlers);
  apply();
})();
</script>
<script>
(() => { const groups = new Map(); document.querySelectorAll('.week-resource-event').forEach(event => { const column = event.style.gridColumn.split('/')[0]; if (!groups.has(column)) groups.set(column, []); groups.get(column).push(event); }); groups.forEach(events => { const count = events.length; events.forEach((event, index) => { event.style.boxSizing = 'border-box'; event.style.width = `calc(${100 / count}% - 8px)`; event.style.transform = `translateX(${index * (100 / count)}%)`; event.style.zIndex = String(index + 1); }); }); })();
</script>
