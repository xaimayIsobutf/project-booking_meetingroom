@using RoomReservation.Domain.Enums
@model RoomReservation.Web.Models.BookingsPageModel
@{
    ViewData["Title"] = "Reservations";
    var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId);
    DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), zone);
    string Query(string nextScope) => $"?scope={nextScope}&search={Uri.EscapeDataString(Model.Search ?? "")}&status={Model.Status}&roomId={Model.RoomId}&fromDate={Model.FromDate:yyyy-MM-dd}&toDate={Model.ToDate:yyyy-MM-dd}";
}
<section class="page-head reservations-head">
    <div><span class="eyebrow" data-i18n="reservations.eyebrow">BOOKINGS</span><h1 data-i18n="reservations.title">Reservations</h1><p data-i18n="reservations.subtitle">Manage your room reservations in one place.</p></div>
    <div class="button-group"><a class="button ghost" href="/schedule" data-i18n="reservations.calendar">Calendar</a><a class="button primary" href="/bookings/new" data-i18n="reservations.book">+ Book a room</a></div>
</section>
<div class="stat-grid reservations-stats">
    <a class="stat-card" href="@Query("upcoming")"><span data-i18n="reservations.upcoming">Upcoming</span><strong>@Model.UpcomingCount</strong><small data-i18n="reservations.active">Active reservations</small></a>
    <a class="stat-card" href="@Query("pending")"><span data-i18n="reservations.pending">Pending approval</span><strong>@Model.PendingCount</strong><small data-i18n="reservations.awaiting">Awaiting a decision</small></a>
    <a class="stat-card" href="@Query("upcoming")&status=CheckedIn"><span data-i18n="reservations.checkedIn">Checked in</span><strong>@Model.CheckedInCount</strong><small data-i18n="reservations.inProgress">Currently in progress</small></a>
    <a class="stat-card" href="@Query("cancelled")"><span data-i18n="reservations.cancelled">Cancelled</span><strong>@Model.CancelledCount</strong><small data-i18n="reservations.history">In reservation history</small></a>
</div>
<div class="panel reservations-panel">
    <div class="reservation-tabs" role="tablist"><a class="@(Model.Scope == "upcoming" ? "selected" : "")" href="@Query("upcoming")" data-i18n="reservations.upcoming">Upcoming</a><a class="@(Model.Scope == "pending" ? "selected" : "")" href="@Query("pending")" data-i18n="reservations.pending">Pending approval</a><a class="@(Model.Scope == "past" ? "selected" : "")" href="@Query("past")" data-i18n="reservations.past">Past</a><a class="@(Model.Scope == "cancelled" ? "selected" : "")" href="@Query("cancelled")" data-i18n="reservations.cancelled">Cancelled</a></div>
    <form class="reservation-filters" method="get">
        <input type="hidden" name="scope" value="@Model.Scope" />
        <label><span data-i18n="reservations.search">Search</span><input name="search" value="@Model.Search" placeholder="Title or room" data-i18n-placeholder="reservations.searchPlaceholder" /></label>
        <label><span data-i18n="reservations.room">Room</span><select name="roomId"><option value="" data-i18n="reservations.allRooms">All rooms</option>@foreach (var room in Model.FilterRooms) { <option value="@room.Id" selected="@(Model.RoomId == room.Id)">@room.Name</option> }</select></label>
        <label><span data-i18n="reservations.status">Status</span><select name="status"><option value="all" selected="@(Model.Status == "all")" data-i18n="reservations.allStatuses">All statuses</option>@foreach (var status in Enum.GetValues<BookingStatus>()) { <option value="@status" selected="@(Model.Status == status.ToString())">@status</option> }</select></label>
        <label><span data-i18n="reservations.from">From</span><input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></label><label><span data-i18n="reservations.to">To</span><input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></label>
        <div class="reservation-filter-actions"><button class="button primary" type="submit" data-i18n="reservations.apply">Apply</button><a class="button ghost" href="/bookings" data-i18n="reservations.clear">Clear</a></div>
    </form>
    <div class="reservation-list-head"><strong>@Model.Bookings.Count <span data-i18n="reservations.results">reservations</span></strong><span data-i18n="reservations.timezone">Times shown in your organization timezone</span></div>
    <div class="booking-list">
        @if (!Model.Bookings.Any()) { <div class="empty-state"><strong data-i18n="reservations.emptyTitle">No reservations found</strong><span data-i18n="reservations.emptyText">Try changing the filters or book a new room.</span><a class="button primary" href="/bookings/new" data-i18n="reservations.emptyAction">Book a room</a></div> }
        @foreach (var b in Model.Bookings) { var start = Local(b.StartAtUtc); var end = Local(b.EndAtUtc); var room = Model.Rooms.TryGetValue(b.RoomId, out var found) ? found : null; <a class="booking-row reservation-row" href="/bookings/@b.Id"><span class="date-block"><b>@start.ToString("dd")</b><small>@start.ToString("MMM")</small></span><span class="reservation-main"><b>@b.Title</b><small>▦ @(room?.Name ?? "Meeting room") · @(room?.Building ?? "") · @start.ToString("dd/MM/yyyy")</small><small>@start.ToString("HH:mm")–@end.ToString("HH:mm") · @b.AttendeeCount <span data-i18n="reservations.people">people</span></small></span><span class="status @b.Status.ToString().ToLowerInvariant()">@b.Status</span><span class="reservation-arrow">›</span></a> }
    </div>
</div>
@section Scripts { <script>
(() => { const lang=localStorage.getItem('roombooking-language')||'en'; const m={en:{title:'Reservations',subtitle:'Manage your room reservations in one place.',calendar:'Calendar',book:'+ Book a room',upcoming:'Upcoming',pending:'Pending approval',checkedIn:'Checked in',cancelled:'Cancelled',past:'Past',active:'Active reservations',awaiting:'Awaiting a decision',inProgress:'Currently in progress',history:'In reservation history',search:'Search',searchPlaceholder:'Title or room',room:'Room',allRooms:'All rooms',status:'Status',allStatuses:'All statuses',from:'From',to:'To',apply:'Apply',clear:'Clear',results:'reservations',timezone:'Times shown in your organization timezone',emptyTitle:'No reservations found',emptyText:'Try changing the filters or book a new room.',emptyAction:'Book a room',people:'people'},th:{title:'รายการจอง',subtitle:'จัดการการจองห้องประชุมทั้งหมดในที่เดียว',calendar:'ปฏิทิน',book:'+ จองห้อง',upcoming:'รายการที่กำลังจะมาถึง',pending:'รออนุมัติ',checkedIn:'เช็กอินแล้ว',cancelled:'ยกเลิกแล้ว',past:'ย้อนหลัง',active:'รายการที่ใช้งานอยู่',awaiting:'รอการตัดสินใจ',inProgress:'กำลังใช้งาน',history:'ในประวัติการจอง',search:'ค้นหา',searchPlaceholder:'หัวข้อหรือห้อง',room:'ห้อง',allRooms:'ทุกห้อง',status:'สถานะ',allStatuses:'ทุกสถานะ',from:'ตั้งแต่',to:'ถึง',apply:'ใช้ตัวกรอง',clear:'ล้าง',results:'รายการ',timezone:'เวลาแสดงตาม timezone ของบริษัท',emptyTitle:'ไม่พบรายการจอง',emptyText:'ลองเปลี่ยนตัวกรองหรือจองห้องใหม่',emptyAction:'จองห้อง',people:'คน'},lo:{title:'ລາຍການຈອງ',subtitle:'ຈັດການການຈອງຫ້ອງປະຊຸມທັງໝົດ',calendar:'ປະຕິທິນ',book:'+ ຈອງຫ້ອງ',upcoming:'ກຳລັງຈະມາ',pending:'ລໍຖ້າອະນຸມັດ',checkedIn:'ເຊັກອິນແລ້ວ',cancelled:'ຍົກເລີກແລ້ວ',past:'ຍ້ອນຫຼັງ',active:'ລາຍການທີ່ໃຊ້ງານ',awaiting:'ລໍຖ້າການຕັດສິນ',inProgress:'ກຳລັງໃຊ້ງານ',history:'ໃນປະຫວັດການຈອງ',search:'ຄົ້ນຫາ',searchPlaceholder:'ຫົວຂໍ້ ຫຼື ຫ້ອງ',room:'ຫ້ອງ',allRooms:'ທຸກຫ້ອງ',status:'ສະຖານະ',allStatuses:'ທຸກສະຖານະ',from:'ຈາກ',to:'ເຖິງ',apply:'ນຳໃຊ້',clear:'ລ້າງ',results:'ລາຍການ',timezone:'ເວລາຕາມ timezone ຂອງບໍລິສັດ',emptyTitle:'ບໍ່ພົບລາຍການຈອງ',emptyText:'ລອງປ່ຽນຕົວກອງ ຫຼື ຈອງຫ້ອງໃໝ່',emptyAction:'ຈອງຫ້ອງ',people:'ຄົນ'}}[lang]||{}; document.querySelectorAll('[data-i18n]').forEach(e=>{const k=e.dataset.i18n.split('.').pop();if(m[k])e.textContent=m[k]});document.querySelectorAll('[data-i18n-placeholder]').forEach(e=>{const k=e.dataset.i18nPlaceholder.split('.').pop();if(m[k])e.placeholder=m[k]}); document.getElementById('languageSelect')?.addEventListener('change',()=>location.reload());})();
</script> }
