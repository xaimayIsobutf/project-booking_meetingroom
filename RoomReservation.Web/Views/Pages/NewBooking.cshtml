@model RoomReservation.Web.Models.BookingFormModel
@{ ViewData["Title"] = "New booking"; }

<section class="page-head booking-page-head"><div><span class="eyebrow">RESERVATION</span><h1>Book a meeting room</h1><p>Choose a room and time for your meeting.</p></div></section>
<div class="booking-steps" aria-label="Booking progress"><span class="active"><b>1</b>Details</span><i></i><span><b>2</b>Room &amp; time</span><i></i><span><b>3</b>Review</span></div>
<form method="post" class="booking-form" id="bookingForm">
    <div class="booking-form-main">
        <div asp-validation-summary="All" class="validation"></div>
        <section class="panel form-section booking-section"><div class="section-heading"><span class="section-number">01</span><div><h2>Meeting details</h2><p>Tell us what this room is needed for.</p></div></div><label>Meeting title<input asp-for="Title" placeholder="e.g. Product planning" autocomplete="off" /><span asp-validation-for="Title" class="field-error"></span></label><label>Notes <span class="optional">Optional</span><textarea asp-for="Notes" rows="3" placeholder="Add an agenda or special request"></textarea></label></section>
        <section class="panel form-section booking-section"><div class="section-heading"><span class="section-number">02</span><div><h2>Choose a room</h2><p>Select the room that fits your meeting.</p></div></div><div class="room-choice-grid">@foreach (var room in Model.Rooms) { <label class="room-choice @(Model.RoomId == room.Id ? "selected" : "")"><input type="radio" name="RoomId" value="@room.Id" checked="@(Model.RoomId == room.Id)" data-room-name="@room.Name" data-room-capacity="@room.Capacity" data-room-location="@room.Building · @room.Floor" /><span class="room-choice-icon">▦</span><span class="room-choice-copy"><b>@room.Name</b><small>@room.Building · @room.Floor</small><small>@room.Capacity seats@(room.RequiresApproval ? " · Approval required" : "")</small></span><span class="room-choice-check">✓</span></label> }</div><span asp-validation-for="RoomId" class="field-error"></span></section>
        <section class="panel form-section booking-section"><div class="section-heading"><span class="section-number">03</span><div><h2>Date and time</h2><p>Bookings must start now or in the future.</p></div></div><div class="form-grid booking-time-grid"><label>Start<input asp-for="StartAt" type="datetime-local" id="startAt" /><span asp-validation-for="StartAt" class="field-error"></span></label><label>End<input asp-for="EndAt" type="datetime-local" id="endAt" /><span asp-validation-for="EndAt" class="field-error"></span></label><label>Attendees<input asp-for="AttendeeCount" type="number" min="1" id="attendeeCount" /></label></div><div class="duration-hint" id="durationHint">Duration will be calculated automatically.</div></section>
        <div class="form-actions booking-actions"><a class="button ghost" href="/bookings">Cancel</a><button class="button primary" type="submit">Review and save</button></div>
    </div>
    <aside class="booking-summary panel" aria-live="polite"><span class="eyebrow">BOOKING SUMMARY</span><h2 id="summaryTitle">Your reservation</h2><div class="summary-room"><span class="room-choice-icon">▦</span><div><b id="summaryRoom">Select a room</b><small id="summaryLocation">Room details will appear here</small></div></div><dl><div><dt>Date</dt><dd id="summaryDate">Choose a date</dd></div><div><dt>Time</dt><dd id="summaryTime">Choose a time</dd></div><div><dt>Duration</dt><dd id="summaryDuration">—</dd></div><div><dt>Attendees</dt><dd id="summaryAttendees">1 person</dd></div></dl><div class="summary-note">Please review the room and time before saving. Overlapping bookings are rejected automatically.</div></aside>
</form>
<script>
(() => { const form=document.getElementById('bookingForm'),start=document.getElementById('startAt'),end=document.getElementById('endAt'),attendees=document.getElementById('attendeeCount'),hint=document.getElementById('durationHint'); const date=v=>v?new Intl.DateTimeFormat(undefined,{dateStyle:'medium'}).format(new Date(v)):'Choose a date'; const time=v=>v?new Intl.DateTimeFormat(undefined,{hour:'2-digit',minute:'2-digit'}).format(new Date(v)):'Choose a time'; function update(){const selected=form.querySelector('input[name="RoomId"]:checked');if(selected){document.getElementById('summaryRoom').textContent=selected.dataset.roomName;document.getElementById('summaryLocation').textContent=`${selected.dataset.roomLocation} · ${selected.dataset.roomCapacity} seats`;}document.getElementById('summaryDate').textContent=date(start.value);document.getElementById('summaryTime').textContent=start.value&&end.value?`${time(start.value)} – ${time(end.value)}`:'Choose a time';const minutes=start.value&&end.value?Math.round((new Date(end.value)-new Date(start.value))/60000):0;const duration=minutes>0?`${Math.floor(minutes/60)}h ${minutes%60?`${minutes%60}m`:''}`.trim():'—';document.getElementById('summaryDuration').textContent=duration;document.getElementById('summaryAttendees').textContent=`${attendees.value||1} person${attendees.value==1?'':'s'}`;hint.textContent=minutes>0?`Total duration: ${duration}`:'End time must be after start time.';hint.classList.toggle('invalid',minutes<=0&&!!start.value&&!!end.value);form.querySelectorAll('.room-choice').forEach(x=>x.classList.toggle('selected',x.querySelector('input').checked));}form.addEventListener('input',update);form.addEventListener('change',update);update(); })();
</script>
<script>
(() => { const grid=document.querySelector('.room-choice-grid'); if(!grid)return; const toolbar=document.createElement('div'); toolbar.className='room-filters'; toolbar.innerHTML='<input type="search" id="roomSearch" placeholder="Search rooms..." aria-label="Search rooms"><select id="roomBuilding"><option value="">All buildings</option></select><select id="roomFloor"><option value="">All floors</option></select><select id="roomCapacity"><option value="0">Any capacity</option><option value="4">4+ seats</option><option value="8">8+ seats</option><option value="12">12+ seats</option><option value="20">20+ seats</option></select><input type="search" id="roomFacility" placeholder="Facility" aria-label="Filter by facility">'; grid.before(toolbar); const cards=[...grid.querySelectorAll('.room-choice')]; const building=document.getElementById('roomBuilding'),floor=document.getElementById('roomFloor'); cards.forEach(card=>{const input=card.querySelector('input'),parts=(input.dataset.roomLocation||'').split(' · '),b=parts[0]||'',f=parts[1]||''; card.dataset.building=b;card.dataset.floor=f;(input.dataset.roomTags||'').split(',').forEach(()=>{}); if(b&&! [...building.options].some(o=>o.value===b)){const o=new Option(b,b);building.add(o)}if(f&&! [...floor.options].some(o=>o.value===f)){const o=new Option(f,f);floor.add(o)}}); function filter(){const q=document.getElementById('roomSearch').value.toLowerCase(),b=building.value,f=floor.value,min=Number(document.getElementById('roomCapacity').value),tag=document.getElementById('roomFacility').value.toLowerCase();let visible=0;cards.forEach(card=>{const i=card.querySelector('input'),ok=(!q||i.dataset.roomName.toLowerCase().includes(q))&&(!b||card.dataset.building===b)&&(!f||card.dataset.floor===f)&&Number(i.dataset.roomCapacity)>=min&&(!tag||card.textContent.toLowerCase().includes(tag));card.hidden=!ok;if(ok)visible++});let empty=grid.querySelector('.room-filter-empty');if(!visible){if(!empty){empty=document.createElement('div');empty.className='room-filter-empty';empty.textContent='No rooms match your filters.';grid.append(empty)}}else empty?.remove()}toolbar.addEventListener('input',filter);toolbar.addEventListener('change',filter); })();
</script>
<script>
(() => { const dictionary={en:['English','New booking','Book a meeting room','Choose a room and time for your meeting.','Details','Room & time','Review','Meeting details','Tell us what this room is needed for.','Meeting title','Notes','Optional','Choose a room','Select the room that fits your meeting.','Date and time','Bookings must start now or in the future.','Start','End','Attendees','Cancel','Review and save','BOOKING SUMMARY','Your reservation','Select a room','Room details will appear here','Date','Time','Duration','Please review the room and time before saving. Overlapping bookings are rejected automatically','Search rooms...','All buildings','All floors','Any capacity','Facility','No rooms match your filters.','4+ seats','8+ seats','12+ seats','20+ seats'],th:['ไทย','การจองใหม่','จองห้องประชุม','เลือกห้องและเวลาสำหรับการประชุมของคุณ','รายละเอียด','ห้องและเวลา','ตรวจสอบ','รายละเอียดการประชุม','แจ้งข้อมูลการใช้ห้องประชุม','หัวข้อการประชุม','หมายเหตุ','ไม่บังคับ','เลือกห้องประชุม','เลือกห้องที่เหมาะกับการประชุมของคุณ','วันและเวลา','การจองต้องเริ่มตั้งแต่เวลาปัจจุบันหรืออนาคต','เริ่ม','สิ้นสุด','ผู้เข้าร่วม','ยกเลิก','ตรวจสอบและบันทึก','สรุปการจอง','การจองของคุณ','เลือกห้อง','รายละเอียดห้องจะแสดงที่นี่','วันที่','เวลา','ระยะเวลา','กรุณาตรวจสอบห้องและเวลาก่อนบันทึก ระบบจะปฏิเสธเวลาที่ทับซ้อนกัน','ค้นหาห้อง...','ทุกอาคาร','ทุกชั้น','ความจุใดก็ได้','สิ่งอำนวยความสะดวก','ไม่พบห้องที่ตรงกับตัวกรอง','4 ที่นั่งขึ้นไป','8 ที่นั่งขึ้นไป','12 ที่นั่งขึ้นไป','20 ที่นั่งขึ้นไป'],lo:['ພາສາລາວ','ການຈອງໃໝ່','ຈອງຫ້ອງປະຊຸມ','ເລືອກຫ້ອງ ແລະ ເວລາສຳລັບການປະຊຸມ','ລາຍລະອຽດ','ຫ້ອງ ແລະ ເວລາ','ກວດສອບ','ລາຍລະອຽດການປະຊຸມ','ບອກຂໍ້ມູນການໃຊ້ຫ້ອງນີ້','ຫົວຂໍ້ການປະຊຸມ','ໝາຍເຫດ','ບໍ່ບັງຄັບ','ເລືອກຫ້ອງ','ເລືອກຫ້ອງທີ່ເໝາະກັບການປະຊຸມ','ວັນທີ ແລະ ເວລາ','ການຈອງຕ້ອງເລີ່ມຈາກເວລາປັດຈຸບັນ ຫຼື ອະນາຄົດ','ເລີ່ມ','ສິ້ນສຸດ','ຜູ້ເຂົ້າຮ່ວມ','ຍົກເລີກ','ກວດສອບ ແລະ ບັນທຶກ','ສະຫຼຸບການຈອງ','ການຈອງຂອງທ່ານ','ເລືອກຫ້ອງ','ລາຍລະອຽດຫ້ອງຈະສະແດງຢູ່ບ່ອນນີ້','ວັນທີ','ເວລາ','ໄລຍະເວລາ','ກະລຸນາກວດສອບຫ້ອງ ແລະ ເວລາກ່ອນບັນທຶກ ລະບົບຈະປະຕິເສດເວລາທີ່ຊ້ອນກັນ','ຄົ້ນຫາຫ້ອງ...','ທຸກອາຄານ','ທຸກຊັ້ນ','ຄວາມຈຸໃດກໍໄດ້','ສິ່ງອຳນວຍຄວາມສະດວກ','ບໍ່ພົບຫ້ອງທີ່ກົງກັບຕົວກອງ','4 ບ່ອນນັ່ງຂຶ້ນໄປ','8 ບ່ອນນັ່ງຂຶ້ນໄປ','12 ບ່ອນນັ່ງຂຶ້ນໄປ','20 ບ່ອນນັ່ງຂຶ້ນໄປ']}; const sources=dictionary.en; function apply(){const code=localStorage.getItem('roombooking-language')||'en',index=code==='th'?1:code==='lo'?2:0,values=dictionary[code]||dictionary.en; const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT); const nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);nodes.forEach(n=>{const p=n.parentElement;if(!p||['SCRIPT','STYLE','INPUT','TEXTAREA','OPTION'].includes(p.tagName))return;const raw=p.dataset.bookingText||n.textContent.trim();const i=sources.indexOf(raw);if(i>=0){p.dataset.bookingText=raw;n.textContent=n.textContent.replace(raw,values[i])}});document.querySelectorAll('input[placeholder],select option').forEach(el=>{const raw=el.dataset.bookingText||el.getAttribute('placeholder')||el.textContent.trim(),i=sources.indexOf(raw);if(i>=0){el.dataset.bookingText=raw;if(el.placeholder!==undefined)el.placeholder=values[i];else el.textContent=values[i]}})}apply();document.getElementById('languageSelect')?.addEventListener('change',()=>setTimeout(apply,20)); })();
</script>
