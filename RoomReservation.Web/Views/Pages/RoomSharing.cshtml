@model RoomReservation.Domain.Entities.Room
@{ ViewData["Title"] = "Share room"; }
<section class="page-head"><div><span class="eyebrow">SHARED ROOM</span><h1>Share @Model.Name</h1><p>อนุญาตให้บริษัทอื่นในระบบเห็นห้องและจองตามสิทธิ์ที่กำหนด</p></div><a class="button ghost" href="/admin/rooms">กลับไปหน้าห้อง</a></section>
<section class="panel room-sharing-panel">
    <div class="room-sharing-summary"><strong>@Model.Name</strong><span>@Model.Building · @Model.Floor · @Model.Capacity seats</span></div>
    <div class="room-sharing-form">
        <label><span>บริษัทปลายทาง</span><select id="sharedOrganization"><option value="">กำลังโหลดบริษัท...</option></select></label>
        <label class="share-check"><input id="sharedCanBook" type="checkbox" checked /><span>อนุญาตให้บริษัทนี้จองห้อง</span></label>
        <label class="share-check"><input id="sharedRequiresApproval" type="checkbox" checked /><span>การจองจากบริษัทนี้ต้องรออนุมัติ</span></label>
        <button class="button primary" id="saveSharedAccess" type="button">บันทึกการแชร์</button>
    </div>
    <p id="sharedAccessStatus" class="muted-copy" role="status"></p>
    <h2>บริษัทที่มีสิทธิ์เข้าถึง</h2>
    <div id="sharedAccessList" class="shared-access-list"><p class="muted-copy">กำลังโหลด...</p></div>
</section>
<script>
(()=>{
  const roomId='@Model.Id', orgSelect=document.getElementById('sharedOrganization'), list=document.getElementById('sharedAccessList'), status=document.getElementById('sharedAccessStatus');
  const load=async()=>{try{const [orgs,accesses]=await Promise.all([fetch('/api/v1/org/available'),fetch(`/api/v1/rooms/${roomId}/sharing`)]);if(!orgs.ok||!accesses.ok)throw new Error();const companies=await orgs.json(),shared=await accesses.json();orgSelect.innerHTML='<option value="">เลือกบริษัท</option>'+companies.map(x=>`<option value="${x.id}">${x.name}</option>`).join('');list.innerHTML=shared.length?shared.map(x=>`<div class="shared-access-row"><div><strong>${x.organizationName}</strong><small>${x.canBook?'จองได้':'ดูตารางได้อย่างเดียว'}${x.requiresApproval?' · ต้องรออนุมัติ':''}</small></div><button class="button danger" type="button" data-remove="${x.organizationId}">ยกเลิกการแชร์</button></div>`).join(''):'<p class="muted-copy">ยังไม่มีบริษัทที่ได้รับสิทธิ์</p>';}catch{status.textContent='ไม่สามารถโหลดข้อมูลการแชร์ได้';}};
  document.getElementById('saveSharedAccess').onclick=async()=>{if(!orgSelect.value){status.textContent='กรุณาเลือกบริษัท';return}const response=await fetch(`/api/v1/rooms/${roomId}/sharing`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({organizationId:orgSelect.value,canView:true,canBook:document.getElementById('sharedCanBook').checked,requiresApproval:document.getElementById('sharedRequiresApproval').checked})});status.textContent=response.ok?'บันทึกการแชร์สำเร็จ':'ไม่สามารถบันทึกการแชร์ได้';if(response.ok){orgSelect.value='';await load()}};
  list.addEventListener('click',async event=>{const button=event.target.closest('[data-remove]');if(!button)return;if(!confirm('ยกเลิกการแชร์ห้องให้บริษัทนี้หรือไม่?'))return;const response=await fetch(`/api/v1/rooms/${roomId}/sharing/${button.dataset.remove}`,{method:'DELETE'});status.textContent=response.ok?'ยกเลิกการแชร์สำเร็จ':'ไม่สามารถยกเลิกการแชร์ได้';if(response.ok)await load()});
  load();
})();
</script>
