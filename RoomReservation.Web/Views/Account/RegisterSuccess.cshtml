@model RegisterSuccessPageModel
@{ ViewData["Title"] = "รอยืนยันอีเมล"; Layout = null; }
<!doctype html><html lang="th"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>รอยืนยันอีเมล - Startbox</title><link rel="stylesheet" href="~/css/theme.css"/><link rel="stylesheet" href="~/css/components.css"/><link rel="stylesheet" href="~/css/forms.css"/><link rel="stylesheet" href="~/css/login.css"/></head><body><main class="auth-page"><section class="auth-card"><span class="eyebrow">สมัครสำเร็จ</span><h1>กรุณายืนยันอีเมล</h1><p>ระบบสร้างคำขอสำหรับ <b>@Model.Email</b> แล้ว จากนั้นกดยืนยันอีเมลและรอ Admin อนุมัติ</p><div class="validation-summary" role="status"><b>ลิงก์สำหรับทดสอบในระบบนี้</b><br/><a href="@Model.VerificationLink">ยืนยันอีเมล</a><small style="display:block;margin-top:8px">Production ควรส่งลิงก์นี้ผ่านผู้ให้บริการอีเมลแทนการแสดงบนหน้าจอ</small></div><p class="support-text"><a href="/Account/Login">กลับไปหน้าเข้าสู่ระบบ</a></p></section></main></body></html>
