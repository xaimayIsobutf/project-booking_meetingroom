@model ForgotPasswordPageModel
@{ Layout = null; }
<!doctype html><html lang="th"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>ลืมรหัสผ่าน - Startbox</title><link rel="stylesheet" href="~/css/theme.css"/><link rel="stylesheet" href="~/css/components.css"/><link rel="stylesheet" href="~/css/forms.css"/><link rel="stylesheet" href="~/css/login.css"/></head><body><main class="auth-page"><section class="auth-card"><img src="~/brand/logo-startbox.png" class="brand-logo" alt="Startbox logo"/><h1>ลืมรหัสผ่าน</h1>@if(Model.Submitted){<p class="success-message">หากอีเมลนี้อยู่ในระบบ เราจะส่งขั้นตอนการตั้งรหัสผ่านใหม่ให้</p>}else{<p>กรอกอีเมลของคุณเพื่อขอเปลี่ยนรหัสผ่าน</p><form method="post"><label for="Email">อีเมล<input asp-for="Email" type="email" autocomplete="email" required /></label><button class="button" type="submit">ส่งคำขอ</button></form>}<a class="back-link" href="/login">กลับไปหน้าเข้าสู่ระบบ</a></section></main></body></html>
