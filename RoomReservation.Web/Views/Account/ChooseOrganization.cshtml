@model RoomReservation.Web.Models.ChooseOrganizationPageModel
@{ ViewData["Title"] = "เลือกบริษัท"; Layout = null; }
<!doctype html><html lang="th"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>เลือกบริษัท - Startbox</title><link rel="stylesheet" href="~/css/theme.css"/><link rel="stylesheet" href="~/css/components.css"/><link rel="stylesheet" href="~/css/forms.css"/><link rel="stylesheet" href="~/css/login.css"/></head><body><main class="auth-page"><section class="auth-card"><img src="~/brand/logo-startbox.png" class="brand-logo" alt="Startbox logo"/><span class="eyebrow">ACCOUNT SETUP</span><h1>เลือกบริษัท</h1><p>บัญชีของคุณสร้างแล้ว แต่ยังไม่ได้ผูกกับบริษัท เลือกบริษัทที่เปิดรับสมาชิกเพื่อส่งคำขอเข้าร่วม</p><form method="post" action="/Account/ChooseOrganization">@Html.AntiForgeryToken()<label for="organizationId">บริษัท<select id="organizationId" name="organizationId" required><option value="">เลือกบริษัท</option>@foreach (var org in Model.Organizations) { <option value="@org.Id">@org.Name</option> }</select></label>@if (Model.Error is not null) { <p class="validation-summary" role="alert">@Model.Error</p> }<button class="button" type="submit">ส่งคำขอเข้าร่วม</button></form></section></main></body></html>
