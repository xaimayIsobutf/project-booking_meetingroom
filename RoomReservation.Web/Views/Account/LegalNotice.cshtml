@model LegalNoticePageModel
@{ ViewData["Title"] = Model.IsPrivacy ? "นโยบายความเป็นส่วนตัว" : "ข้อกำหนดการใช้งาน"; Layout = null; }
<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Startbox</title>
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <main class="auth-page">
        <section class="auth-card legal-card" aria-labelledby="legal-title">
            <div class="auth-toolbar">
                <label class="language-control" for="legalLanguage"><span class="sr-only">ภาษา</span><select id="legalLanguage" aria-label="Language"><option>ไทย</option><option>English</option><option>ລາວ</option></select></label>
            </div>
            <img src="~/brand/logo-startbox.png" class="brand-logo" alt="Startbox logo" />
            <h1 id="legal-title" data-i18n="@(Model.IsPrivacy ? "privacyTitle" : "termsTitle")">@(Model.IsPrivacy ? "นโยบายความเป็นส่วนตัว" : "ข้อกำหนดการใช้งาน")</h1>
            <p data-i18n="legalIntro">เอกสารนี้อธิบายหลักเกณฑ์การใช้งานระบบจองห้องประชุมของ Startbox</p>
            <div class="legal-content">
                <h2 data-i18n="legalSectionAccount">บัญชีผู้ใช้</h2>
                <p data-i18n="legalAccountText">ผู้ใช้ต้องให้ข้อมูลที่ถูกต้อง รักษารหัสผ่าน และรับผิดชอบกิจกรรมภายใต้บัญชีของตน</p>
                <h2 data-i18n="legalSectionData">ข้อมูลและความปลอดภัย</h2>
                <p data-i18n="legalDataText">ระบบใช้ข้อมูลเท่าที่จำเป็นต่อการยืนยันตัวตน การจองห้อง และการตรวจสอบประวัติการใช้งาน</p>
                <h2 data-i18n="legalSectionContact">ติดต่อผู้ดูแลระบบ</h2>
                <p data-i18n="legalContactText">หากมีคำถามเกี่ยวกับเอกสารนี้ กรุณาติดต่อผู้ดูแลระบบของบริษัท</p>
            </div>
            <p class="support-text"><a href="/register" data-i18n="backToRegister">กลับไปสมัครสมาชิก</a></p>
        </section>
    </main>
    <script src="~/js/login-i18n.js"></script>
</body>
</html>
