@using Microsoft.EntityFrameworkCore
@inject RoomReservation.Infrastructure.Persistence.AppDbContext Db
@{ var isSuperAdmin = User.IsInRole("SuperAdmin"); var isOrganizationAdmin = User.IsInRole("OrgAdmin") || isSuperAdmin; var pendingNotifications = 0; var flashSuccess = TempData["FlashSuccess"] as string; Guid.TryParse(User.FindFirst("organization_id")?.Value, out var layoutOrgId); var currentOrganizationName = layoutOrgId != Guid.Empty ? await Db.Organizations.Where(x => x.Id == layoutOrgId).Select(x => x.Name).FirstOrDefaultAsync() : null; var availableOrganizations = isSuperAdmin ? await Db.Organizations.AsNoTracking().OrderBy(x => x.Name).ToListAsync() : new List<RoomReservation.Domain.Entities.Organization>(); if (isOrganizationAdmin && layoutOrgId != Guid.Empty) { pendingNotifications = await Db.Bookings.CountAsync(x => x.OrganizationId == layoutOrgId && x.Status == RoomReservation.Domain.Enums.BookingStatus.Pending); } }
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Startbox Room Reservation</title>
    <link rel="stylesheet" href="~/css/theme.css" /><link rel="stylesheet" href="~/css/layout.css" /><link rel="stylesheet" href="~/css/components.css" /><link rel="stylesheet" href="~/css/forms.css" /><link rel="stylesheet" href="~/css/calendar.css" /><link rel="stylesheet" href="~/css/pages.css?v=status-colors-1" /><link rel="stylesheet" href="~/css/members-popup.css?v=1" /><link rel="stylesheet" href="~/css/members-inline.css?v=1" /><link rel="stylesheet" href="~/css/settings.css?v=1" /><link rel="stylesheet" href="~/css/profile.css?v=1" /><link rel="stylesheet" href="~/css/room-display.css?v=1" /><link rel="stylesheet" href="~/css/shell.css?v=mobile-shell-1" />
    <link rel="stylesheet" href="~/css/settings.css?v=organization-management-2" />
    <link rel="stylesheet" href="~/css/organization-management.css?v=1" />
    <link rel="stylesheet" href="~/css/paired-displays.css?v=1" />
    <link rel="stylesheet" href="~/css/paired-display-dialog.css?v=1" /><link rel="stylesheet" href="~/css/notifications.css?v=1" /><link rel="stylesheet" href="~/css/schedule-scroll.css?v=1" /><link rel="stylesheet" href="~/css/header-interaction.css?v=1" />
    <script src="~/js/notifications.js?v=1"></script>
    <script src="~/js/paired-displays.js?v=2" defer></script>
    <script src="~/js/schedule-scroll.js?v=1" defer></script>
</head>
<body data-theme="light">
<div class="app-shell">
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
        <div class="brand"><a href="/" aria-label="Startbox home"><img class="brand-logo" src="~/brand/logo-startbox.png" alt="Startbox" /></a></div>
        <div class="sidebar-label" data-i18n="workspace">WORKSPACE</div>
        <nav class="side-nav">
            <a data-nav="dashboard" href="/" class="@(Context.Request.Path == "/" || Context.Request.Path == "/dashboard" ? "active" : "")"><span>▦</span><em>Dashboard</em></a>
            <a data-nav="calendar" href="/schedule" class="@(Context.Request.Path.StartsWithSegments("/schedule") ? "active" : "")"><span>▣</span><em>Calendar Room</em></a>
            <a data-nav="reservations" href="/bookings" class="@(Context.Request.Path.StartsWithSegments("/bookings") ? "active" : "")"><span>⌑</span><em>Reservations</em></a>
            <a data-nav="quickBook" href="/quick-book"><span>＋</span><em>Quick book</em></a>
            <a data-nav="checkIn" href="/check-in"><span>✓</span><em>Check-in</em></a>
            <a data-nav="roomDisplay" href="/room-display" class="@(Context.Request.Path.StartsWithSegments("/room-display") ? "active" : "")"><span>▣</span><em>Room Display</em></a>
            @if (User.IsInRole("OrgAdmin") || User.IsInRole("SuperAdmin")) { <a data-nav="rooms" href="/admin/rooms" class="@(Context.Request.Path.StartsWithSegments("/admin/rooms") ? "active" : "")"><span>▦</span><em>Meeting rooms</em></a><a data-nav="reports" href="/admin/reports"><span>▤</span><em>Reports</em></a><a data-nav="approvals" href="/admin/approvals"><span>✓</span><em>Approvals</em></a><a data-nav="audit" href="/admin/audit" class="@(Context.Request.Path.StartsWithSegments("/admin/audit") ? "active" : "")"><span>◷</span><em>Audit log</em></a> }
        </nav>
        @if (isOrganizationAdmin)
        {
            <div class="sidebar-label" data-i18n="team">TEAM</div>
            <nav class="side-nav"><a data-nav="members" href="/admin/members"><span>♙</span><em>Members</em></a><a data-nav="settings" href="/admin/settings"><span>⚙</span><em>Organization settings</em></a></nav>
        }
        <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Collapse sidebar">‹</button>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <div class="main-shell">
        <header class="topbar">
            <div class="topbar-left"><button class="menu-toggle" id="sidebarToggle" type="button" aria-label="Open navigation" aria-expanded="true">☰</button><div><span class="breadcrumb"><span data-i18n="workspace">Workspace</span> / @if (ViewData["Title"]?.ToString() == "Dashboard") { <span data-i18n="dashboard">Dashboard</span> } else { @ViewData["Title"] }</span><h2>@if (ViewData["Title"]?.ToString() == "Dashboard") { <span data-i18n="dashboard">Dashboard</span> } else { @ViewData["Title"] }</h2></div></div>
            <div class="top-actions">@if (isSuperAdmin) { <form class="organization-switcher" method="post" action="/Account/SwitchOrganization">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><select name="organizationId" aria-label="Organization" onchange="this.form.submit()">@foreach (var organization in availableOrganizations) { <option value="@organization.Id" selected="@(organization.Id == layoutOrgId)">@organization.Name</option> }</select></form> } else if (!string.IsNullOrWhiteSpace(currentOrganizationName)) { <div class="organization-label" aria-label="Organization"><span aria-hidden="true">▣</span><b>@currentOrganizationName</b></div> }<a class="notification-button" href="@(isOrganizationAdmin ? "/admin/approvals" : "/bookings")" aria-label="Notifications"><span aria-hidden="true">🔔</span>@if (pendingNotifications > 0) { <b class="notification-badge">@pendingNotifications</b> }</a><label class="header-language"><span class="sr-only">Language</span><select id="languageSelect" aria-label="Language"><option value="th">ไทย</option><option value="en">English</option><option value="lo">ລາວ</option></select></label><button class="outline-button theme-toggle" type="button" id="themeToggle" aria-label="Toggle theme">◐</button><div class="user-menu"><button class="user-chip" type="button" id="userMenuToggle" aria-expanded="false" aria-controls="userMenu"><span class="avatar">@(User.Identity?.Name?.FirstOrDefault() ?? 'S')</span><b>@(User.Identity?.Name ?? "Guest")</b><span class="user-chevron">⌄</span></button><div class="user-dropdown" id="userMenu" hidden><div class="user-dropdown-name">@(User.Identity?.Name ?? "Guest")</div><a href="/profile" data-profile-i18n="profile">Profile</a>@if (isOrganizationAdmin) { <a href="/admin/settings" data-profile-i18n="organizationSettings">Organization settings</a> }<form asp-controller="Account" asp-action="Logout" method="post"><button class="header-logout" type="submit"><span>Logout</span></button></form></div></div></div>
        </header>
        <main class="main-content">@RenderBody()</main>
    </div>
</div>
<div id="globalToast" class="global-toast" role="status" aria-live="polite" data-message="@flashSuccess" hidden></div>
    <script src="~/js/shell.js?v=mobile-shell-1"></script><script src="~/js/profile-i18n.js?v=1"></script><script>
(() => {
    const titles = {
        en: { '/schedule':'Calendar Room', '/':'Dashboard', '/bookings':'Reservations', '/quick-book':'Quick book', '/check-in':'Check-in', '/room-display':'Room Display', '/admin/rooms':'Meeting rooms', '/admin/reports':'Reports', '/admin/approvals':'Approvals', '/admin/audit':'Audit log', '/admin/members':'Members', '/admin/settings':'Organization settings', '/profile':'Profile' },
        th: { '/schedule':'ปฏิทินห้อง', '/':'แดชบอร์ด', '/bookings':'รายการจอง', '/quick-book':'จองด่วน', '/check-in':'เช็กอิน', '/room-display':'หน้าจอหน้าห้อง', '/admin/rooms':'ห้องประชุม', '/admin/reports':'รายงาน', '/admin/approvals':'อนุมัติ', '/admin/audit':'ประวัติการใช้งาน', '/admin/members':'สมาชิก', '/admin/settings':'การตั้งค่าองค์กร', '/profile':'โปรไฟล์' },
        lo: { '/schedule':'ປະຕິທິນຫ້ອງ', '/':'ແດຊບອດ', '/bookings':'ລາຍການຈອງ', '/quick-book':'ຈອງດ່ວນ', '/check-in':'ເຊັກອິນ', '/room-display':'ໜ້າຈໍໜ້າຫ້ອງ', '/admin/rooms':'ຫ້ອງປະຊຸມ', '/admin/reports':'ລາຍງານ', '/admin/approvals':'ອະນຸມັດ', '/admin/audit':'ບັນທຶກການໃຊ້ງານ', '/admin/members':'ສະມາຊິກ', '/admin/settings':'ການຕັ້ງຄ່າອົງກອນ', '/profile':'ໂປຣໄຟລ໌' }
    };
    const applyPageTitle = () => {
        const code = localStorage.getItem('roombooking-language') || 'th';
        const path = location.pathname === '/' ? '/' : Object.keys(titles.en).filter(x => x !== '/').find(x => location.pathname.startsWith(x)) || '';
        const title = (titles[code] || titles.en)[path];
        if (!title) return;
        const heading = document.querySelector('.topbar-left h2');
        if (heading) heading.textContent = title;
        const breadcrumb = document.querySelector('.breadcrumb');
        if (breadcrumb?.lastChild?.nodeType === Node.TEXT_NODE) breadcrumb.lastChild.textContent = ' / ' + title;
        document.title = title + ' - RoomBooking';
    };
    applyPageTitle();
    const organizationSettingsNames = { en: 'Organization settings', th: 'การตั้งค่าองค์กร', lo: 'ການຕັ້ງຄ່າອົງກອນ' };
    const applyOrganizationSettingsName = () => { const code = localStorage.getItem('roombooking-language') || 'th'; const name = organizationSettingsNames[code] || organizationSettingsNames.en; const nav = document.querySelector('[data-nav="settings"] em'); if (nav) nav.textContent = name; if (location.pathname.startsWith('/admin/settings')) { const heading = document.querySelector('.topbar-left h2'); if (heading) heading.textContent = name; const breadcrumb = document.querySelector('.breadcrumb'); if (breadcrumb?.lastChild?.nodeType === Node.TEXT_NODE) breadcrumb.lastChild.textContent = ' / ' + name; document.title = name + ' - RoomBooking'; } };
    applyOrganizationSettingsName();
    document.getElementById('languageSelect')?.addEventListener('change', () => setTimeout(applyOrganizationSettingsName, 80));
    const profileNames = { en: 'Profile', th: 'โปรไฟล์', lo: 'ໂປຣໄຟລ໌' };
    const applyProfileName = () => { const code = localStorage.getItem('roombooking-language') || 'th'; const profile = profileNames[code] || profileNames.en; const settings = organizationSettingsNames[code] || organizationSettingsNames.en; document.querySelectorAll('[data-profile-i18n="profile"]').forEach(e => e.textContent = profile); document.querySelectorAll('[data-profile-i18n="organizationSettings"]').forEach(e => e.textContent = settings); };
    applyProfileName();
    document.getElementById('languageSelect')?.addEventListener('change', () => setTimeout(applyProfileName, 80));
    document.getElementById('languageSelect')?.addEventListener('change', () => setTimeout(applyPageTitle, 60));
})();
</script>@await RenderSectionAsync("Scripts", required: false)
</body>
<script>
(() => { const code = localStorage.getItem('roombooking-language') || 'th'; const allNames = { en: { profile: 'Profile', settings: 'Organization settings' }, th: { profile: 'โปรไฟล์', settings: 'การตั้งค่าองค์กร' }, lo: { profile: 'ໂປຣໄຟລ໌', settings: 'ການຕັ້ງຄ່າອົງກອນ' } }; const names = allNames[code] || allNames.en; document.querySelectorAll('[data-profile-i18n="profile"]').forEach(e => e.textContent = names.profile); document.querySelectorAll('[data-profile-i18n="organizationSettings"]').forEach(e => e.textContent = names.settings); document.querySelector('[data-nav="settings"] em')?.replaceChildren(names.settings); if (location.pathname === '/profile') { const h = document.querySelector('.topbar-left h2'); if (h) h.textContent = names.profile; document.title = names.profile + ' - RoomBooking'; } })();
</script>
<script>
(() => {
    const roomFilter = document.getElementById('roomFilter');
    const schedule = document.querySelector('.resource-schedule');
    if (!roomFilter || !schedule) return;
    const buildingFilter = document.getElementById('buildingFilter');
    const floorFilter = document.getElementById('floorFilter');
    const normalizeOptions = select => [...select.options].forEach((option, index) => {
        option.value = index === 0 ? '' : (option.dataset.calendarText || option.textContent.trim());
    });
    normalizeOptions(roomFilter);
    if (buildingFilter) normalizeOptions(buildingFilter);
    if (floorFilter) normalizeOptions(floorFilter);
    const applyFilters = () => {
        const selectedRoom = roomFilter.value;
        const building = buildingFilter?.value || '';
        const floor = floorFilter?.value || '';
        const singleRoom = roomFilter.selectedIndex > 0;
        schedule.classList.toggle('single-room', singleRoom);
        document.querySelectorAll('[data-room-cell],[data-room-header],[data-room-event]').forEach(element => {
            const roomMatch = !singleRoom || element.dataset.roomCell === selectedRoom || element.dataset.roomHeader === selectedRoom || element.dataset.roomEvent === selectedRoom;
            const buildingMatch = !building || element.dataset.building === building;
            const floorMatch = !floor || element.dataset.floor === floor;
            element.hidden = !(roomMatch && buildingMatch && floorMatch);
            if (!element.hidden && singleRoom && (element.dataset.roomCell || element.dataset.roomHeader || element.dataset.roomEvent)) element.style.gridColumn = '2';
        });
    };
    roomFilter.addEventListener('change', applyFilters);
    buildingFilter?.addEventListener('change', applyFilters);
    floorFilter?.addEventListener('change', applyFilters);
    applyFilters();
})();
</script>
</html>
